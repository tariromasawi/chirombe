/* ============================================================
   17 · TAMPER-EVIDENT LOCAL AUDIT CHAIN
   ============================================================ */

async function audit(type,payload){

  const previous =
    STATE.audit.length
      ? STATE.audit[
          STATE.audit.length-1
        ].digest
      : "GENESIS";

  const record = {

    id:makeId("AUD"),

    timestamp:
      new Date().toISOString(),

    type,

    payload:
      sanitiseObject(payload),

    previous

  };

  const digest =
    await sha256(
      JSON.stringify(record)
    );

  record.digest =
    digest;

  STATE.audit.push(record);

  if(
    STATE.audit.length >
    CONFIG.MAX_AUDIT_ROWS
  ){

    STATE.audit.shift();

  }

  renderAudit();

}


