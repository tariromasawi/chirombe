<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#05070c">
<meta name="color-scheme" content="dark">

<title>Universal Recovery Master</title>

<style>
/* ================================================================
   UNIVERSAL RECOVERY MASTER — BASE SHELL
   ================================================================ */

:root{
    --bg:#05070c;
    --panel:rgba(10,15,25,.92);
    --panel2:rgba(16,23,36,.88);
    --line:rgba(255,255,255,.12);
    --text:#f4f7fb;
    --muted:#9ba8ba;
    --accent:#7dd3fc;
    --good:#86efac;
    --warn:#facc15;
    --bad:#fb7185;
    --shadow:0 20px 70px rgba(0,0,0,.45);
}

*{
    box-sizing:border-box;
}

html,
body{
    margin:0;
    width:100%;
    min-height:100%;
    background:var(--bg);
    color:var(--text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

body{
    overflow-x:hidden;
}

button,
input,
select,
textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

#URM_APP{
    min-height:100vh;
    position:relative;
    isolation:isolate;
}

/* ================================================================
   BACKGROUND CANVAS
   ================================================================ */

#URM_CANVAS{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    pointer-events:none;
    z-index:0;
}

/* ================================================================
   MAIN INTERFACE
   ================================================================ */

.urm-shell{
    position:relative;
    z-index:2;
    width:min(1500px,100%);
    margin:auto;
    padding:
        max(18px,env(safe-area-inset-top))
        max(18px,env(safe-area-inset-right))
        max(30px,env(safe-area-inset-bottom))
        max(18px,env(safe-area-inset-left));
}

.urm-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding:20px 0;
    flex-wrap:wrap;
}

.urm-brand{
    display:flex;
    align-items:center;
    gap:14px;
}

.urm-mark{
    width:52px;
    height:52px;
    display:grid;
    place-items:center;
    border:1px solid var(--line);
    border-radius:16px;
    background:linear-gradient(
        145deg,
        rgba(125,211,252,.16),
        rgba(255,255,255,.03)
    );
    box-shadow:var(--shadow);
    font-weight:900;
}

.urm-title{
    margin:0;
    font-size:clamp(20px,4vw,34px);
    letter-spacing:.04em;
}

.urm-subtitle{
    margin:4px 0 0;
    color:var(--muted);
    font-size:12px;
}

.badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:28px;
    padding:0 11px;
    border-radius:999px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.06);
    color:var(--accent);
    font-size:11px;
    font-weight:800;
    letter-spacing:.08em;
}

/* ================================================================
   GRID
   ================================================================ */

.urm-grid{
    display:grid;
    grid-template-columns:
        repeat(
            12,
            minmax(0,1fr)
        );
    gap:14px;
}

.urm-card{
    grid-column:span 4;
    min-width:0;
    border:1px solid var(--line);
    border-radius:20px;
    background:var(--panel);
    box-shadow:var(--shadow);
    overflow:hidden;
}

.urm-card.wide{
    grid-column:span 8;
}

.urm-card.full{
    grid-column:1/-1;
}

.urm-card-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    padding:15px 17px;
    border-bottom:1px solid var(--line);
}

.urm-card-title{
    margin:0;
    font-size:13px;
    letter-spacing:.06em;
    text-transform:uppercase;
}

.urm-card-body{
    padding:17px;
}

@media(max-width:900px){
    .urm-card,
    .urm-card.wide{
        grid-column:1/-1;
    }
}

/* ================================================================
   METRICS
   ================================================================ */

.metrics{
    display:grid;
    grid-template-columns:
        repeat(4,minmax(0,1fr));
    gap:10px;
}

.metric{
    padding:14px;
    border:1px solid var(--line);
    border-radius:15px;
    background:rgba(255,255,255,.025);
}

.metric-value{
    font-size:25px;
    font-weight:800;
}

.metric-label{
    margin-top:4px;
    color:var(--muted);
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.08em;
}

@media(max-width:600px){
    .metrics{
        grid-template-columns:
            repeat(2,minmax(0,1fr));
    }
}

/* ================================================================
   BUTTONS
   ================================================================ */

.controls{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

.urm-button{
    min-height:40px;
    padding:0 14px;
    border-radius:11px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.06);
    color:var(--text);
    transition:
        transform .15s ease,
        background .15s ease;
}

.urm-button:hover{
    background:rgba(255,255,255,.11);
    transform:translateY(-1px);
}

.urm-button.primary{
    border-color:
        rgba(125,211,252,.35);
    background:
        rgba(125,211,252,.12);
}

.urm-button.danger{
    border-color:
        rgba(251,113,133,.3);
}

/* ================================================================
   LOG
   ================================================================ */

#URM_LOG{
    max-height:360px;
    overflow:auto;
    margin:0;
    padding:14px;
    border-radius:14px;
    background:#020409;
    border:1px solid var(--line);
    color:#cbd5e1;
    white-space:pre-wrap;
    word-break:break-word;
    font:11px/1.55
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Consolas,
        monospace;
}

.status{
    display:flex;
    align-items:center;
    gap:8px;
    color:var(--muted);
    font-size:12px;
}

.status-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:var(--good);
    box-shadow:
        0 0 15px
        rgba(134,239,172,.8);
}

/* ================================================================
   FOOTER
   ================================================================ */

.urm-footer{
    padding:28px 0 10px;
    text-align:center;
    color:var(--muted);
    font-size:11px;
}
</style>
</head>

