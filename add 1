async function sha256(value){

  const text =
    String(value);

  if(
    window.crypto &&
    crypto.subtle
  ){

    const data =
      new TextEncoder()
        .encode(text);

    const digest =
      await crypto.subtle.digest(
        "SHA-256",
        data
      );

    return hex(
      new Uint8Array(digest)
    );

  }

  /* fallback: non-cryptographic diagnostic digest */

  let h = 2166136261;

  for(
    let i=0;
    i<text.length;
    i++
  ){

    h ^= text.charCodeAt(i);

    h =
      Math.imul(
        h,
        16777619
      );

  }

  return (
    "fallback-" +
    (h >>> 0).toString(16)
  );

}


