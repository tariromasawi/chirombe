      DOM.networkCanvas
        .getBoundingClientRect();

    const x =
      event.clientX -
      rect.left;

    const y =
      event.clientY -
      rect.top;

    let closest = null;

    let distance = Infinity;

    for(
      const node
      of STATE.nodes
    ){

      const dx =
        node.x-x;

      const dy =
        node.y-y;

      const d =
        Math.sqrt(
          dx*dx + dy*dy
        );

      if(
        d < distance
      ){

        distance = d;
        closest = node;

      }

    }

    if(
      closest &&
      distance < 28
    ){

      STATE.selectedNode =
        closest;

      closest.pulse =
        .9;

      logEvent(
        "NODE_SELECT",
        "Selected " +
        closest.name
      );

