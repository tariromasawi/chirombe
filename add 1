/* ============================================================
   CRYPTOGRAPHIC SEAL
   ============================================================ */

function bytesToHex(bytes){

  return Array
    .from(bytes)
    .map(
      b =>
        b
          .toString(16)
          .padStart(2,"0")
    )
    .join("");

}


async function sha256(text){

  if(
    !window.crypto ||
    !crypto.subtle
  ){

    return "CRYPTO-API-UNAVAILABLE";

  }

  const encoded =
    new TextEncoder()
      .encode(text);

  const digest =
    await crypto.subtle.digest(
      "SHA-256",
      encoded
    );

  return bytesToHex(
    new Uint8Array(
      digest
    )
  );

}


async function createSealHash(){

  const payload = {

    command:
      CONFIG.command,

    name:
      CONFIG.name,

    timestamp:
      new Date()
        .toISOString(),

    random:
      crypto.getRandomValues(
        new Uint32Array(4)
      ).join("-")

  };

  const hash =
    await sha256(
      JSON.stringify(
        payload
      )
    );

  hashEl.textContent =
    hash;

  return {
    payload,
    hash
  };

}


/* ============================================================
   OPTIONAL AES-GCM SESSION ENCRYPTION
   ============================================================ */

async function encryptSealData(data){

  if(
    !window.crypto ||
    !crypto.subtle
  ){
    return null;
  }

  try{

    const key =
      await crypto.subtle.generateKey(
        {
          name:"AES-GCM",
          length:256
        },
        true,
        [
          "encrypt",
          "decrypt"
        ]
      );

    const iv =
      crypto.getRandomValues(
        new Uint8Array(12)
      );

    const encoded =
      new TextEncoder()
        .encode(
          JSON.stringify(data)
        );

    const encrypted =
      await crypto.subtle.encrypt(
        {
          name:"AES-GCM",
          iv
        },
        key,
        encoded
      );

    const exportedKey =
      await crypto.subtle.exportKey(
        "jwk",
        key
      );

    return {

      algorithm:
        "AES-GCM-256",

      iv:
        Array.from(iv),

      key:
        exportedKey,

      ciphertext:
        Array.from(
          new Uint8Array(
            encrypted
          )
        )

    };

  }catch(error){

    console.warn(
      "Encryption unavailable:",
      error
    );

    return null;

  }

}


