/* ================================================================
   CONTINUITY ENGINE
   ================================================================ */

function calculateContinuity(){

    const people = Object.values(state.persons);

    const knowledge = Object.values(state.knowledge);

    const assets = Object.values(state.assets);

    const relationships = Object.values(

        state.relationships

    );

    const generationScore =

        state.generationCount > 0

            ? clamp(

                state.generationCount /

                Math.max(

                    1,

                    Math.min(

                        CONFIG.maximumGenerations,

                        state.generationCount

                    )

                )

            )

            : 0;

    const relationshipScore =

        people.length > 1

            ? clamp(

                relationships.length /

                Math.max(1,people.length)

            )

            : 0;

    const knowledgeScore =

        people.length

            ? clamp(

                knowledge.length /

                Math.max(1,people.length*2)

            )

            : 0;

    const assetScore =

        assets.length

            ? clamp(

                assets.reduce(

                    (sum,a)=>sum+a.integrity,

                    0

                ) / assets.length

            )

            : 0.5;

    const confidenceScore = people.length

        ? people.reduce(

            (sum,p)=>sum+p.confidence,

            0

        ) / people.length

        : 0;

    const score = clamp(

        generationScore * 0.20 +

        relationshipScore * 0.20 +

        knowledgeScore * 0.20 +

        assetScore * 0.20 +

        confidenceScore * 0.20

    );

    const result = {

        timestamp: now(),

        score,

        generationScore,

        relationshipScore,

        knowledgeScore,

        assetScore,

        confidenceScore,

        people: people.length,

        relationships: relationships.length,

        knowledge: knowledge.length,

        assets: assets.length

    };

    state.continuity.score = score;

    state.continuity.latest = result;

    persist("CONTINUITY_SCORE",result);

    emit("BLOODLINE_CONTINUITY_CALCULATED",result);

    return clone(result);

}


/* ================================================================
   QUANTUM-INSPIRED STATE VECTOR
   ================================================================ */

/*
   This is NOT a quantum computer.

   It provides a compact mathematical representation of several
   dimensions of lineage resilience.

   [continuity, knowledge, integrity, connectivity, recovery]

   The values are normalized between 0 and 1.

   A normalized vector is useful for comparing system states over
   time without claiming that it represents physical quantum
   phenomena.
*/

function stateVector(){

    const continuity =

        state.continuity.latest ||

        calculateContinuity();

    const integrity =

        calculateAssetIntegrity();

    const connectivity =

        calculateConnectivity();

    const recovery =

        calculateRecoveryReadiness();

    const vector = [

        clamp(continuity.score),

        clamp(continuity.knowledgeScore),

        clamp(integrity),

        clamp(connectivity),

        clamp(recovery)

    ];

    const magnitude = Math.sqrt(

        vector.reduce(

            (sum,value)=>sum+(value*value),

            0

        )

    );

    return {

        timestamp: now(),

        vector,

        magnitude,

        normalized:

            magnitude

                ? vector.map(v=>v/magnitude)

                : vector,

        model:

            "QUANTUM_INSPIRED_RESILIENCE_VECTOR"

    };

}


/* ================================================================
   CONNECTIVITY ANALYSIS
   ================================================================ */

function calculateConnectivity(){

    const people = Object.values(state.persons);

    const relationships = Object.values(

        state.relationships

    );

    if(!people.length){

        return 0;

    }

    const possible = Math.max(

        1,

        people.length * 2

    );

    return clamp(

        relationships.length / possible

    );

}


/* ================================================================
   ASSET INTEGRITY
   ================================================================ */

function calculateAssetIntegrity(){

    const assets = Object.values(state.assets);

    if(!assets.length){

        return 1;

    }

    return clamp(

        assets.reduce(

            (sum,a)=>sum+clamp(a.integrity),

            0

        ) / assets.length

    );

}


/* ================================================================
   RECOVERY READINESS
   ================================================================ */

function calculateRecoveryReadiness(){

    const plans = Object.values(

        state.recoveryPlans

    );

    if(!plans.length){

        return 0.5;

    }

    const valid = plans.filter(

        p=>p.status !== "INVALID"

    ).length;

    return clamp(valid / plans.length);

}


/* ================================================================
   RESILIENCE ENGINE
   ================================================================ */

function resilienceScore(){

    const continuity = calculateContinuity();

    const integrity = calculateAssetIntegrity();

    const connectivity = calculateConnectivity();

    const recovery = calculateRecoveryReadiness();

    const defenceScore =

        DEFENCE &&

        typeof DEFENCE.resilienceScore === "function"

            ? Number(DEFENCE.resilienceScore().score || 0)

            : 0.5;

    const score = clamp(

        continuity.score * 0.30 +

        integrity * 0.20 +

        connectivity * 0.15 +

        recovery * 0.15 +

        clamp(defenceScore) * 0.20

    );

    const result = {

        timestamp: now(),

        score,

        continuity: continuity.score,

        integrity,

        connectivity,

        recovery,

        defence: clamp(defenceScore),

        classification:

            score >= 0.85

                ? "HIGH_RESILIENCE"

                : score >= 0.65

                    ? "STABLE"

                    : score >= 0.45

                        ? "DEVELOPING"

                        : "FRAGILE"

    };

    state.lineageScores.latest = result;

    state.metrics.resilienceCalculations++;

    persist("RESILIENCE_SCORE",result);

    emit("BLOODLINE_RESILIENCE_UPDATED",result);

    return clone(result);

}


