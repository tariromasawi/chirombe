            of STATE.edges
        ) {

            if (
                edge.from === id ||
                edge.to === id
            ) {

                STATE.edges.delete(
                    edgeId
                );

            }

        }


        STATE.metrics.nodes =
            STATE.nodes.size;

        STATE.metrics.edges =
            STATE.edges.size;


        emit(
            "PATHWAY_NODE_REMOVED",
            {
                id
            }
        );


        return true;

    }


    /* ----------------------------------------------------------------------
       EDGE / CONNECTION ENGINE
       ---------------------------------------------------------------------- */

    function createEdge(
        from,
        to,
        options = {}
    ) {

        if (
            !STATE.nodes.has(from)
        ) {

            throw new Error(
                "Unknown source node: " +
                from
            );

        }


        if (
            !STATE.nodes.has(to)
        ) {

            throw new Error(
                "Unknown destination node: " +
                to
            );

        }


        const edge = {

            id:
                options.id ||
                uid("EDGE"),

            from:
                from,

            to:
                to,

            type:
                options.type ||
                "DEPENDENCY",

            weight:
                clamp(
                    numeric(
                        options.weight,
                        0.5
                    ),
                    0,
                    1
                ),

            confidence:
                clamp(
                    numeric(
                        options.confidence,
                        0.7
                    ),
                    0,
                    1
                ),

            cost:
                clamp(
                    numeric(
                        options.cost,
                        0.5
                    ),
                    0,
                    1
                ),

            reversible:
                options.reversible !== false,

            status:
                options.status ||
                "ACTIVE",

            metadata:
                clone(
                    options.metadata ||
                    {}
                ),

            created:
                now(),

            hash:
                null

        };


        edge.hash =
            hash(
                edge
            );


        STATE.edges.set(
            edge.id,
            edge
        );


        STATE.metrics.edges =
            STATE.edges.size;


        updateConnectivity();


        emit(
            "PATHWAY_EDGE_CREATED",
            edge
        );


        return edge;

    }


    function updateConnectivity() {

        for (
            const node
            of STATE.nodes.values()
        ) {

            node.connectivity = 0;

        }


        for (
            const edge
            of STATE.edges.values()
        ) {

            const source =
                STATE.nodes.get(
                    edge.from
                );

            const target =
                STATE.nodes.get(
                    edge.to
                );


            if (source) {

                source.connectivity++;

            }


            if (target) {

                target.connectivity++;

            }

        }

    }


    function getOutgoing(
        nodeId
    ) {

        const output = [];


        for (
            const edge
            of STATE.edges.values()
        ) {

            if (
                edge.from === nodeId
            ) {

                output.push(
                    edge
                );

            }

        }


        return output;

    }


    function getIncoming(
        nodeId
    ) {

        const output = [];


        for (
            const edge
            of STATE.edges.values()
        ) {

            if (
                edge.to === nodeId
            ) {

                output.push(
                    edge
                );

            }

        }


        return output;

    }


