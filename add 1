   ------------------------------------------------------------
   Synthetic nodes only.
   Never presented as predictions about real people.
   ============================================================ */

function updateSyntheticLife(){

  for(
    const node
    of STATE.nodes
  ){

    if(
      !node.synthetic
    ){

      continue;

    }

    const drift =
      (
        Math.random()-.5
      )*.018;

    node.life.wellbeing =
      clamp(
        node.life.wellbeing +
        drift,
        0,
        1
      );

    node.life.progress =
      clamp(
        node.life.progress +
        drift*.7,
        0,
        1
      );

    node.life.achievement =
      clamp(
        node.life.achievement +
        drift*.45,
        0,
        1
      );

    node.energy =
      clamp(
        (
          node.life.wellbeing +
          node.life.progress +
          node.life.achievement
        ) / 3,
        0,
        1
      );

  }

}


