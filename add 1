<script>
/* ========================================================================
   UNIVERSAL RECOVERY MASTER
   ======================================================================== */

(() => {

"use strict";


/* ------------------------------------------------------------------------
   MASTER STATE
   ------------------------------------------------------------------------ */

const R = {

    version:
        "URM-1.0",

    started:
        Date.now(),

    scans:0,

    repairs:0,

    reconciliations:0,

    errors:0,

    mutations:0,

    events:[],

    debug:false,

    observer:null

};


/* ------------------------------------------------------------------------
   DOM REFERENCES
   ------------------------------------------------------------------------ */

const $ = id =>
    document.getElementById(id);

const canvas =
    $("URM_CANVAS");

const ctx =
    canvas.getContext("2d");


/* ------------------------------------------------------------------------
   LOGGING
   ------------------------------------------------------------------------ */

function log(
    message,
    data = null
){

    const line =
        `[${new Date().toLocaleTimeString()}] ${message}`;

    R.events.push({
        time:
            new Date().toISOString(),

        message,

        data
    });

    if(
        R.events.length > 500
    ){

        R.events.shift();

    }

    const output =
        $("URM_LOG");

    if(output){

        output.textContent =
            R.events
                .slice(-100)
                .map(
                    e =>
                        `[${new Date(e.time)
                            .toLocaleTimeString()}] ${e.message}`
                )
                .join("\n");

        output.scrollTop =
            output.scrollHeight;
    }

    if(R.debug){

        console.log(
            "[URM]",
            message,
            data
        );

    }

}


/* ------------------------------------------------------------------------
   SAFE EXECUTION
   ------------------------------------------------------------------------ */

function safe(
    fn,
    fallback = null
){

    try{

        return fn();

    }catch(error){

        R.errors++;

        log(
            "Isolated error: " +
            (
                error?.message ||
                String(error)
            )
        );

        return fallback;
    }

}


/* ------------------------------------------------------------------------
   GLOBAL ERROR CAPTURE
   ------------------------------------------------------------------------ */

window.addEventListener(
    "error",
    event => {

        R.errors++;

        log(
            "Runtime error isolated"
        );

    },
    true
);


window.addEventListener(
    "unhandledrejection",
    event => {

        R.errors++;

        log(
            "Unhandled promise rejection isolated"
        );

    },
    true
);


/* ------------------------------------------------------------------------
   CANVAS
   ------------------------------------------------------------------------ */

function resizeCanvas(){

    const dpr =
        Math.min(
            window.devicePixelRatio || 1,
            2
        );

    canvas.width =
        innerWidth * dpr;

    canvas.height =
        innerHeight * dpr;

    canvas.style.width =
        innerWidth + "px";

    canvas.style.height =
        innerHeight + "px";

    ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );

}


window.addEventListener(
    "resize",
    resizeCanvas,
    {
        passive:true
    }
);


resizeCanvas();


/* ------------------------------------------------------------------------
   DIAGNOSTIC DRAW
   ------------------------------------------------------------------------ */

function drawDiagnostics(){

    ctx.clearRect(
        0,
        0,
        innerWidth,
        innerHeight
    );

    if(!R.debug)
        return;

    const elements =
        [
            ...document.querySelectorAll(
                "[data-urm-inspected]"
            )
        ];

    ctx.font =
        "11px monospace";

    elements.forEach(
        element => {

            const rect =
                safe(
                    () =>
                        element.getBoundingClientRect(),
                    null
                );

            if(!rect)
                return;

            ctx.strokeRect(
                rect.left,
                rect.top,
                rect.width,
                rect.height
            );

        }
    );

    ctx.fillText(
        "URM DIAGNOSTIC MODE",
        14,
        20
    );

}


function animationLoop(){

    drawDiagnostics();

    requestAnimationFrame(
        animationLoop
    );

}

animationLoop();


/* ------------------------------------------------------------------------
   DOCUMENT SCAN
   ------------------------------------------------------------------------ */

function scan(){

    R.scans++;

    log(
        `Deep scan ${R.scans} started`
    );

    const elements =
        [
            ...document.querySelectorAll("*")
        ];

    elements.forEach(
        element => {

            element.dataset.urmInspected =
                "true";

        }
    );

    const result = {

        nodes:
            elements.length,

        scripts:
            document.scripts.length,

        styles:
            document.querySelectorAll(
                "style,link[rel='stylesheet']"
            ).length,

        canvases:
            document.querySelectorAll(
                "canvas"
            ).length,

        forms:
            document.querySelectorAll(
                "form"
            ).length,

        buttons:
            document.querySelectorAll(
                "button"
            ).length,

        links:
            document.querySelectorAll(
                "a"
            ).length,

        inputs:
            document.querySelectorAll(
                "input,select,textarea"
            ).length,

        customElements:
            elements.filter(
                e =>
                    e.tagName.includes("-")
            ).length

    };


    $("M_DOM").textContent =
        result.nodes;

    $("M_SCRIPTS").textContent =
        result.scripts;

    $("M_STYLES").textContent =
        result.styles;

    $("M_ERRORS").textContent =
        R.errors;


    log(
        "Scan complete",
        result
    );

    return result;

}


/* ------------------------------------------------------------------------
   LAYOUT RECONCILIATION
   ------------------------------------------------------------------------ */

function repairLayout(){

    R.repairs++;

    log(
        "Layout reconciliation started"
    );

    const elements =
        [
            ...document.querySelectorAll(
                "*"
            )
        ];

    let changed = 0;

    elements.forEach(
        element => {

            safe(
                () => {

                    const style =
                        getComputedStyle(
                            element
                        );

                    const rect =
                        element.getBoundingClientRect();

                    /*
                     * Prevent giant accidental
                     * dimensions from expanding
                     * the whole document.
                     */

                    if(
                        rect.width >
                        innerWidth * 3
                    ){

                        if(
                            !element.dataset
                                .urmOriginalMaxWidth
                        ){

                            element.dataset
                                .urmOriginalMaxWidth =
                                element.style.maxWidth ||
                                "";
                        }

                        element.style.maxWidth =
                            "100%";

                        element.style.boxSizing =
                            "border-box";

                        changed++;

                    }


                    /*
                     * Extreme z-index values can
                     * make independent pages appear
                     * to sit on top of one another.
                     */

                    const z =
                        parseInt(
                            style.zIndex,
                            10
                        );

                    if(
                        Number.isFinite(z) &&
                        Math.abs(z) >
                        1000000
                    ){

                        if(
                            !element.dataset
                                .urmOriginalZ
                        ){

                            element.dataset
                                .urmOriginalZ =
                                element.style.zIndex ||
                                "";
                        }

                        element.style.zIndex =
                            String(
                                Math.max(
                                    -1000,
                                    Math.min(
                                        z,
                                        1000
                                    )
                                )
                            );

                        changed++;

                    }

                }
            );

        }
    );


    /*
     * Mark body as the primary composition
     * root without destroying existing content.
     */

    if(document.body){

        document.body.style.maxWidth =
            "100%";

        document.body.style.boxSizing =
            "border-box";

    }


    log(
        `Layout reconciliation complete — ${changed} adjustments`
    );

    return changed;

}


/* ------------------------------------------------------------------------
   COMPONENT RECOVERY
   ------------------------------------------------------------------------ */

function recoverComponents(){

    log(
        "Component recovery started"
    );

    let upgraded = 0;

    if(
        window.customElements
    ){

        const elements =
            [
                ...document.querySelectorAll("*")
            ];

        const names =
            [
                ...new Set(
                    elements
                        .map(
                            element =>
                                element.tagName
                                    ?.toLowerCase()
                        )
                        .filter(
                            name =>
                                name &&
                                name.includes("-")
                        )
                )
            ];

        names.forEach(
            name => {

                safe(
                    () => {

                        customElements.upgrade(
                            document.querySelectorAll(
                                name
                            )
                        );

                        upgraded++;

                    }
                );

            }
        );

    }

    log(
        `Component recovery complete — ${upgraded} component types`
    );

}


/* ------------------------------------------------------------------------
   INTERACTION AUDIT
   ------------------------------------------------------------------------ */

function auditInteractions(){

    const controls =
        [
            ...document.querySelectorAll(
                "button,a,input,select," +
                "textarea,[onclick]," +
                "[role='button']"
            )
        ];

    let usable = 0;

    controls.forEach(
        control => {

            const meaningful =
                control.id ||
                control.textContent.trim() ||
                control.getAttribute(
                    "aria-label"
                ) ||
                control.getAttribute(
                    "title"
                );

            if(meaningful)
                usable++;

        }
    );

    log(
        `Interaction audit — ${usable}/${controls.length} identifiable controls`
    );

    return {
        total:
            controls.length,

        usable

    };

}


/* ------------------------------------------------------------------------
   BROWSER CAPABILITY DISCOVERY
   ------------------------------------------------------------------------ */

function capabilities(){

    const features = {

        fetch:
            typeof fetch ===
            "function",

        workers:
            typeof Worker !==
            "undefined",

        canvas:
            typeof HTMLCanvasElement !==
            "undefined",

        webAudio:
            !!(
                window.AudioContext ||
                window.webkitAudioContext
            ),

        webCrypto:
            !!(
                window.crypto &&
                window.crypto.subtle
            ),

        indexedDB:
            "indexedDB" in window,

        serviceWorker:
            "serviceWorker" in navigator,

        customElements:
            "customElements" in window,

        mutationObserver:
            "MutationObserver" in window,

        resizeObserver:
            "ResizeObserver" in window,

        intersectionObserver:
            "IntersectionObserver" in window,

        websocket:
            "WebSocket" in window,

        mediaDevices:
            !!navigator.mediaDevices

    };


    const container =
        $("URM_FEATURES");

    if(container){

        container.innerHTML = "";

        Object.entries(
            features
        ).forEach(
            ([name,enabled]) => {

                const row =
                    document.createElement(
                        "div"
                    );

                row.textContent =
                    `${enabled ? "●" : "○"} ${name}`;

                row.style.color =
                    enabled
                        ? "#86efac"
                        : "#94a3b8";

                container.appendChild(
                    row
                );

            }
        );

    }

    return features;

}


/* ------------------------------------------------------------------------
   SAFE RECONCILIATION
   ------------------------------------------------------------------------ */

async function reconcile(){

    R.reconciliations++;

    log(
        `Reconciliation cycle ${R.reconciliations}`
    );

    scan();

    repairLayout();

    recoverComponents();

    auditInteractions();

    capabilities();

    if(
        window.URK &&
        typeof window.URK.reconcile ===
        "function"
    ){

        safe(
            () =>
                window.URK.reconcile()
        );

    }

    $("M_ERRORS").textContent =
        R.errors;

    log(
        "Reconciliation complete"
    );

}


/* ------------------------------------------------------------------------
   MUTATION MONITOR
   ------------------------------------------------------------------------ */

function installMutationMonitor(){

    if(
        typeof MutationObserver ===
        "undefined"
    )
        return;

    let timer = null;

    R.observer =
        new MutationObserver(
            mutations => {

                R.mutations +=
                    mutations.length;

                clearTimeout(
                    timer
                );

                timer =
                    setTimeout(
                        () => {

                            log(
                                `Dynamic content detected — ${mutations.length} mutations`
                            );

                            reconcile();

                        },
                        750
                    );

            }
        );

    R.observer.observe(
        document.documentElement,
        {
            childList:true,
            subtree:true,
            attributes:true
        }
    );

}


/* ------------------------------------------------------------------------
   REPORT EXPORT
   ------------------------------------------------------------------------ */

function exportReport(){

    const report = {

        generated:
            new Date().toISOString(),

        runtime:
            Date.now() -
            R.started,

        state:{
            ...R
        },

        document:{
            title:
                document.title,

            url:
                location.href,

            nodes:
                document.querySelectorAll(
                    "*"
                ).length,

            scripts:
                document.scripts.length,

            styles:
                document.querySelectorAll(
                    "style,link[rel='stylesheet']"
                ).length
        },

        kernel:
            window.URK &&
            typeof window.URK.snapshot ===
            "function"
                ? safe(
                    () =>
                        window.URK.snapshot()
                )
                : null,

        terminal:
            window.URK_TERMINAL &&
            typeof window.URK_TERMINAL.snapshot ===
            "function"
                ? safe(
                    () =>
                        window.URK_TERMINAL.snapshot()
                )
                : null

    };


    const blob =
        new Blob(
            [
                JSON.stringify(
                    report,
                    null,
                    2
                )
            ],
            {
                type:
                    "application/json"
            }
        );

    const url =
        URL.createObjectURL(
            blob
        );

    const link =
        document.createElement(
            "a"
        );

    link.href =
        url;

    link.download =
        "universal-recovery-report.json";

    document.body.appendChild(
        link
    );

    link.click();

    link.remove();

    setTimeout(
        () =>
            URL.revokeObjectURL(
                url
            ),
        1500
    );

    log(
        "Diagnostic report exported"
    );

}


/* ------------------------------------------------------------------------
   BUTTONS
   ------------------------------------------------------------------------ */

$("BTN_SCAN")
    ?.addEventListener(
        "click",
        () => {

            scan();

        }
    );


$("BTN_REPAIR")
    ?.addEventListener(
        "click",
        () => {

            repairLayout();

            recoverComponents();

            auditInteractions();

        }
    );


$("BTN_RECONCILE")
    ?.addEventListener(
        "click",
        () => {

            reconcile();

        }
    );


$("BTN_DEBUG")
    ?.addEventListener(
        "click",
        () => {

            R.debug =
                !R.debug;

            $("URM_STATUS")
                .textContent =
                R.debug
                    ? "Diagnostics active"
                    : "Operational";

            log(
                R.debug
                    ? "Diagnostics enabled"
                    : "Diagnostics disabled"
            );

        }
    );


$("BTN_EXPORT")
    ?.addEventListener(
        "click",
        exportReport
    );


/* ------------------------------------------------------------------------
   AUTOMATIC BOOT
   ------------------------------------------------------------------------ */

async function boot(){

    $("URM_STATUS")
        .textContent =
        "Scanning";

    log(
        "Universal Recovery Master booting"
    );

    capabilities();

    scan();

    /*
     * Allow application frameworks,
     * dynamically inserted fragments and
     * asynchronous modules to settle.
     */

    await new Promise(
        resolve =>
            setTimeout(
                resolve,
                250
            )
    );

    await reconcile();

    installMutationMonitor();

    /*
     * Second delayed reconciliation.
     */

    setTimeout(
        () => reconcile(),
        1000
    );

    /*
     * Third delayed reconciliation.
     */

    setTimeout(
        () => reconcile(),
        3000
    );

    $("URM_STATUS")
        .textContent =
        "Operational";

    log(
        "Universal Recovery Master ready"
    );

}


/* ------------------------------------------------------------------------
   START
   ------------------------------------------------------------------------ */

if(
    document.readyState ===
    "loading"
){

    document.addEventListener(
        "DOMContentLoaded",
        boot,
        {
            once:true
        }
    );

}else{

    boot();

}


/* ------------------------------------------------------------------------
   PUBLIC API
   ------------------------------------------------------------------------ */

window.UNIVERSAL_RECOVERY_MASTER = {

    state:R,

    scan,

    repair:
        repairLayout,

    reconcile,

    capabilities,

    audit:
        auditInteractions,

    exportReport,

    debug(
        enabled = true
    ){

        R.debug =
            !!enabled;

        return R.debug;

    },

    snapshot(){

        return {

            version:
                R.version,

            uptime:
                Date.now() -
                R.started,

            scans:
                R.scans,

            repairs:
                R.repairs,

            reconciliations:
                R.reconciliations,

            errors:
                R.errors,

            mutations:
                R.mutations

        };

    }

};


/* ------------------------------------------------------------------------
   GLOBAL READY EVENT
   ------------------------------------------------------------------------ */

window.dispatchEvent(
    new CustomEvent(
        "UNIVERSAL_RECOVERY_MASTER_READY",
        {
            detail:
                window
                    .UNIVERSAL_RECOVERY_MASTER
        }
    )
);


})();
</script>

