                ),

            modules:
                safeClone(
                    modules
                ),

            workers:
                safeClone(
                    workers
                )
        };

        const fingerprint =
            await hash(payload);

        const snapshot = {
            id: uid("SNAP"),
            timestamp: now(),
            fingerprint: fingerprint,
            payload: payload
        };

        STATE.snapshots.unshift(
            snapshot
        );

        if (
            STATE.snapshots.length >
            CONFIG.maximumSnapshots
        ) {
            STATE.snapshots =
                STATE.snapshots.slice(
