            interval:CONFIG.scanInterval

        },

        {

            name:"BLOODLINE_SELF_TEST",

            handler:()=>selfTest(),

            interval:CONFIG.integrityInterval

        }

    ];

    definitions.forEach(def=>{

        try{

            if(

                typeof WORKERS.registerWorker ===

                "function"

            ){

                WORKERS.registerWorker({

                    name:def.name,

                    handler:def.handler,

                    interval:def.interval,

                    lane:"DEFENCE",

                    priority:"HIGH"

                });

