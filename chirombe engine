       ---------------------------------------------------------------------- */

    let mappingTimer =
        null;

    let analysisTimer =
        null;


    function startScheduler() {

        if (
            mappingTimer ||
            analysisTimer
        ) {

            return;

        }


        if (
            CONFIG.autonomousMapping
        ) {

            mappingTimer =
                setInterval(

                    function () {

                        try {

                            discoverSystem();

                            importEvolutionProposals();

                        } catch (error) {

                            STATE.metrics.failures++;

                        }

                    },

                    CONFIG.mappingInterval

                );

        }


        if (
            CONFIG.autonomousAnalysis
        ) {

            analysisTimer =
                setInterval(

                    function () {

                        analyse()
                            .catch(
                                function (error) {

                                    STATE.metrics.failures++;

                                    console.error(
                                        "[PATHWAY ANALYSIS]",
                                        error
                                    );

                                }
                            );

                    },

                    CONFIG.analysisInterval

                );

        }


        log(
            "Pathway scheduler online."
        );

    }


    function stopScheduler() {

        if (
            mappingTimer
        ) {

            clearInterval(
                mappingTimer
            );

            mappingTimer =
                null;

        }


        if (
            analysisTimer
        ) {

            clearInterval(
                analysisTimer
            );

            analysisTimer =
                null;

        }


        log(
            "Pathway scheduler stopped."
        );

    }


