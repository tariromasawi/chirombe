       ---------------------------------------------------------------------- */

    async function analyse() {

        if (
            !CONFIG.enabled
        ) {

            return {

                status:
                    "DISABLED"

            };

        }


        const graph =
            discoverSystem();


        const imported =
            importEvolutionProposals();


        const routes =
            analyseRoutes();


        const bottlenecks =
            detectBottlenecks();


        const analysis = {

            id:
                uid("ANALYSIS"),

            timestamp:
                now(),

            cycle:
                STATE.cycle,

            nodes:
                STATE.nodes.size,

            edges:
                STATE.edges.size,

            importedProposals:
                imported,

            routes:
                routes.length,

            bottlenecks:
                bottlenecks.length,

            graphHash:
                hash(graph),

            status:
                "COMPLETE"

        };


        await saveMemory(

            "PATHWAYS",

            analysis.id,

            analysis

        );


        emit(

            "PATHWAY_ANALYSIS_COMPLETE",

            analysis

        );


        return analysis;

    }


