  ---------------------------------------------------------------
  */

  function discoverModules() {

    var known = {

      ZCCA: !!g.ZCCA,

      ZCSM: !!g.ZCSM,

      GUARDIAN:
        !!g.CHIROMBE_GUARDIAN,

      PIONEER:
        !!g.CHIROMBE_PIONEER_BRAIN,

      LITURGY:
        !!g.CHIROMBE_LITURGY,

      RESONANCE:
        !!g.ChirombeResonance,

      PROTECTION_CORE:
        !!g.ZionProtect,

      CORE:
        !!g.ChirombeCore,

      BUS:
        !!g.ChirombeBus,

      HEALTH:
        !!g.ChirombeHealth

    };

    Object.keys(known)
      .forEach(function (name) {

        if (known[name]) {

          if (
            state.modules[name] !==
            "ACTIVE"
          ) {
            state.modules[name] =
              "DISCOVERED";
          }

        }

      });

  }

  /*
  ---------------------------------------------------------------
  AUTOMATIC RECOVERY
  ---------------------------------------------------------------
  */

  function recoverySweep() {

    discoverModules();

    if (
      g.CHIROMBE_GUARDIAN &&
      typeof g.CHIROMBE_GUARDIAN.status ===
      "function"
    ) {

      try {

        var gs =
          g.CHIROMBE_GUARDIAN.status();

        if (
          gs &&
          gs.running === false
        ) {

          g.CHIROMBE_GUARDIAN.start();

          state.recoveries++;

          log(
            "RECOVERY",
            "Guardian Brain restarted."
          );

        }

      } catch (e) {}

    }

    if (
      g.CHIROMBE_PIONEER_BRAIN &&
      typeof g.CHIROMBE_PIONEER_BRAIN.resume ===
      "function"
    ) {

      try {

        var ps =
          g.CHIROMBE_PIONEER_BRAIN.status();

        if (
          ps &&
          ps.paused
        ) {

          g.CHIROMBE_PIONEER_BRAIN.resume();

          state.recoveries++;

          log(
            "RECOVERY",
            "Pioneer Brain resumed."
          );

        }

      } catch (e) {}

    }

  }

  /*
  ---------------------------------------------------------------
  MASTER BOOT
  ---------------------------------------------------------------
  */

  function boot() {

    if (state.booted) return;

    state.booted = true;

    log(
      "BOOT",
      "CHIROMBE MASTER AUTOSTART beginning module discovery."
    );

    detectHardware();
    discoverModules();

    /*
    First activation pass.
    */

    activateProtectionCore();
    activateZCCA();
    activateGuardian();
    activatePioneer();
    activateZCSM();
    activateLiturgy();

    /*
    Give dynamically injected modules time
    to finish attaching.
    */

    setTimeout(function () {

      discoverModules();

      activateProtectionCore();
      activateZCCA();
      activateGuardian();
      activatePioneer();
      activateZCSM();
      activateLiturgy();

      /*
      Initial complete cycle.
      */

      setTimeout(function () {

        runSQIECycle();

      }, 1500);

    }, 1200);

    /*
    Master orchestration loop.
    */

    setInterval(
      runSQIECycle,
      12000
    );

    /*
    Module recovery / discovery.
    */

    setInterval(
      recoverySweep,
      5000
    );

    /*
    Hardware readiness refresh.
    */

    setInterval(
      detectHardware,
      10000
    );

    /*
    Persist master state.
    */

    setInterval(
      function () {

        try {

          localStorage.setItem(
            "CHIROMBE_MASTER_AUTOSTART",
            JSON.stringify(state)
          );

        } catch (e) {}

      },
      7000
    );

    log(
      "BOOT",
      "Master orchestration online."
    );

  }

  /*
  ---------------------------------------------------------------
  PUBLIC API
  ---------------------------------------------------------------
  */

  g.CHIROMBE_AUTOSTART = {

    version: VERSION,

    start: function () {

      state.running = true;

      boot();

      return status();

    },

    stop: function () {

      state.running = false;

      log(
        "SYSTEM",
        "Master orchestration paused."
      );

    },

    cycle: runSQIECycle,

    discover: discoverModules,

    recover: recoverySweep,

    status: status,

    hardware: function () {

      detectHardware();

      return state.hardware;

    }

  };

  /*
  ---------------------------------------------------------------
  START AS SOON AS DOM IS AVAILABLE
  ---------------------------------------------------------------
  */

  function ready() {

    boot();

  }

  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      ready,
      { once: true }
    );

  } else {

    ready();

  }

})(window);