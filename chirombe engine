            true;

        const heartbeatTimer =
            setInterval(
                function () {
                    heartbeat();
                },
                CONFIG.heartbeatInterval
            );

        const healthTimer =
            setInterval(
                function () {
                    healthScan();
                },
                CONFIG.healthInterval
            );

        const integrityTimer =
            setInterval(
                function () {
                    integritySnapshot();
                },
                CONFIG.integrityInterval
            );

        const recoveryTimer =
            setInterval(
                function () {
                    recoveryScan();
                },
                CONFIG.recoveryInterval
            );

        STATE.timers.push(
            heartbeatTimer,
            healthTimer,
            integrityTimer,
            recoveryTimer
        );

        log(
            "Watchdog scheduler started."
        );
    }

    function stopScheduler() {
        STATE.timers.forEach(
            function (timer) {
                clearInterval(timer);
            }
        );

        STATE.timers = [];

        STATE.running =
            false;

        log(
            "Watchdog scheduler stopped."
        );
    }

