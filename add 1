   ============================================================ */

function frame(now){

  if(
    STATE.destroyed
  ){

    return;

  }

  STATE.frame++;

  const delta =
    now -
    STATE.lastFrame;

  STATE.lastFrame =
    now;


  drawCelestial(
    now
  );

  drawGrid();


  if(
    !STATE.paused
  ){

    updateNodes(
      delta
    );

    updateCoherence();

    syntheticActivity(
      now
    );

    securitySampling();

    securityDecay();

  }


  boundaryRecovery();

  periodicIntegrity(
    now
  );


  drawNetwork(
    now
  );


  if(
    STATE.frame % 20 === 0
  ){

    updateStats();

  }


  requestAnimationFrame(
    frame
  );

}


