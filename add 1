/* ============================================================
   SACRED GEOMETRY
   ============================================================ */

function polygon(
  ctx,
  cx,
  cy,
  radius,
  sides,
  rotation=0
){

  ctx.beginPath();

  for(
    let i=0;
    i<sides;
    i++
  ){

    const a =
      rotation +
      i *
      Math.PI*2 /
      sides;

    const x =
      cx +
      Math.cos(a)*radius;

    const y =
      cy +
      Math.sin(a)*radius;

    if(i===0)
      ctx.moveTo(x,y);
    else
      ctx.lineTo(x,y);

  }

  ctx.closePath();

}


function drawGeometry(t){

  G.clearRect(
    0,
    0,
    W,
    H
  );

  if(
    geometryEnabled === false
  ){
    return;
  }

  const cx =
    W/2;

  const cy =
    H/2;

  const base =
    Math.min(W,H);

  G.save();

  G.translate(
    cx,
    cy
  );

  const pulse =
    1 +
    .035 *
    Math.sin(
      t*.002
    );

  G.scale(
    pulse,
    pulse
  );

  for(
    let layer=1;
    layer<=CONFIG.geometryLayers;
    layer++
  ){

    const r =
      base *
      (.06 + layer*.028);

    const rotation =
      t*.00015 *
      (layer%2 ? 1 : -1);

    G.lineWidth =
      layer===CONFIG.geometryLayers
        ? 1.8
        : .65;

    G.strokeStyle =
      layer%3===0
        ? "rgba(80,210,255,.28)"
        : "rgba(255,215,105,.28)";

    polygon(
      G,
      0,
      0,
      r,
      6,
      rotation
    );

    G.stroke();

    polygon(
      G,
      0,
      0,
      r,
      3,
      rotation+Math.PI
    );

    G.stroke();

  }

  /* Flower-of-life style circles */

  const rr =
    base*.12;

  const positions = [
    [0,0],
    [rr,0],
    [-rr,0],
    [rr/2,rr*.866],
    [-rr/2,rr*.866],
    [rr/2,-rr*.866],
    [-rr/2,-rr*.866]
  ];

  positions.forEach(
    ([x,y])=>{

      G.beginPath();

      G.arc(
        x,
        y,
        rr,
        0,
        Math.PI*2
      );

      G.strokeStyle =
        "rgba(255,235,150,.23)";

      G.stroke();

    }
  );

  /* infinity */

  G.beginPath();

  for(
    let x=-base*.22;
    x<=base*.22;
    x+=2
  ){

    const nx =
      x/(base*.22);

    const y =
      Math.sin(
        nx*Math.PI*2
      ) *
      base*.035;

    if(x===-base*.22)
      G.moveTo(x,y);
    else
      G.lineTo(x,y);

  }

  G.strokeStyle =
    "rgba(120,225,255,.5)";

  G.stroke();

  G.restore();

}


/* ============================================================
