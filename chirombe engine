       ============================================================ */

    async function createDependency(
        from,
        to,
        type,
        metadata
    ) {

        if (
            !from ||
            !to
        ) {

            throw new Error(
                "Dependency requires source and target."
            );
        }

        const dependency = {

            id:
                uid("DEP"),

            from:
                from,

            to:
                to,

            type:
                type ||
                "REQUIRES",

            strength:
                1,

            metadata:
                clone(
                    metadata || {}
                ),

            createdAt:
                now()
        };

        STATE.dependencies[
            dependency.id
        ] = dependency;

        if (
            Object.keys(
                STATE.dependencies
            ).length >
            CONFIG.maximumDependencies
        ) {

            const ids =
                Object.keys(
                    STATE.dependencies
                );

            delete STATE.dependencies[
                ids[0]
            ];
        }

        await persist(
            "DEPENDENCY_" +
                dependency.id,
            dependency
        );

        return clone(
            dependency
        );
    }

