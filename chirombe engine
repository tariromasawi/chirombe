                        CORE.on(
                            eventName,
                            function (payload) {
                                createIncident(
                                    "SYSTEM_EVENT",
                                    eventName.indexOf(
                                        "ERROR"
                                    ) !== -1
                                        ? "WARNING"
                                        : "INFO",
                                    eventName,
                                    "Observed system event.",
                                    payload
