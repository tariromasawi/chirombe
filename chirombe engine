        const protectedWorker =
            CONFIG
                .protectedWorkerTypes
                .indexOf(workerName) !== -1;

        try {
            if (
                typeof WORKERS.cancel ===
                "function"
            ) {
                /*
                 * Cancel is intentionally used only as a
                 * non-destructive recovery action.
                 */
                WORKERS.cancel(
                    workerName
                );
            }

            STATE.metrics.workerRestarts++;

            return {
                success: true,
                worker:
                    workerName,
                protected:
                    protectedWorker,
                timestamp:
                    now()
            };
        } catch (e) {
            return {
                success: false,
                worker:
                    workerName,
                error:
                    e.message
            };
        }
    }

    /* ============================================================
       WORKER ISOLATION
       ============================================================ */

    async function isolateWorker(
        workerName
    ) {
        const protectedWorker =
            CONFIG
                .protectedWorkerTypes
                .indexOf(workerName) !== -1;

        if (protectedWorker) {
            return {
                success: false,
                reason:
                    "PROTECTED_WORKER"
            };
        }

        /*
         * Browser implementation records the isolation
         * intention rather than deleting or destroying
         * worker definitions.
         */

        STATE.workers[
            workerName
        ] = Object.assign(
            {},
            STATE.workers[
                workerName
            ] || {},
            {
                isolated: true,
                isolatedAt: now()
            }
        );

        STATE.metrics.isolatedWorkers++;

        await persist(
            CONFIG.recoveryNamespace,
            "ISOLATION_" +
                workerName,
            {
                worker:
                    workerName,
                isolatedAt:
                    now()
            }
        );

        return {
            success: true,
            worker:
                workerName,
            action:
                "ISOLATED"
        };
    }

    /* ============================================================
       RECOVERY EXECUTION
       ============================================================ */

    async function executeRecovery(
        plan
    ) {
        if (!plan) {
            return {
                success: false,
                reason:
                    "NO_PLAN"
            };
        }

        plan.attempts++;

        plan.status =
            "EXECUTING";

        let result = {
            success: false,
            reason:
                "UNKNOWN_ACTION"
        };

        try {
            switch (
                plan.action
            ) {
                case "RESTART_WORKER":
                    result =
                        await restartWorker(
                            plan.target
                        );
                    break;

                case "ISOLATE_WORKER":
                    result =
                        await isolateWorker(
                            plan.target
                        );
                    break;

                case "RESCAN":
                    result =
                        {
                            success: true,
                            scan:
                                await healthScan()
                        };
                    break;

                case "INTEGRITY_SNAPSHOT":
                    result =
                        {
                            success: true,
                            snapshot:
                                await integritySnapshot()
                        };
                    break;

                case "INSPECT":
                    result = {
                        success: true,
                        health:
                            safeClone(
                                STATE.health
                            )
                    };
                    break;

                default:
                    result = {
                        success: false,
                        reason:
                            "UNSUPPORTED_ACTION"
                    };
            }

            if (result.success) {
                plan.status =
                    "COMPLETED";

                STATE.metrics.recoveries++;

            } else {
                plan.status =
                    plan.attempts >=
                    plan.maximumAttempts
                        ? "FAILED"
                        : "RETRY_PENDING";

                STATE.metrics.failedRecoveries++;
            }
        } catch (e) {
            plan.status =
                plan.attempts >=
                plan.maximumAttempts
                    ? "FAILED"
                    : "RETRY_PENDING";

            result = {
                success: false,
                error:
                    e.message
            };

            STATE.metrics.failedRecoveries++;
        }

        plan.completedAt =
            now();

        plan.result =
            safeClone(result);

        await persist(
            CONFIG.recoveryNamespace,
            plan.id,
            plan
        );

        return result;
    }

    /* ============================================================
       ANOMALY → RECOVERY TRANSLATOR
       ============================================================ */

    async function processAnomalies(
        anomalies
    ) {
        const plans = [];

        for (
            let i = 0;
            i < anomalies.length;
            i++
        ) {
            const anomaly =
                anomalies[i];

            let action =
                "INSPECT";

            let target =
                anomaly.component ||
                "SYSTEM";

            if (
                anomaly.type ===
                "WORKER_UNHEALTHY"
            ) {
                action =
                    CONFIG
                        .automaticWorkerRestart
                        ? "RESTART_WORKER"
                        : "INSPECT";
            }

            if (
                anomaly.type ===
                "MODULE_MISSING"
            ) {
                action =
                    "INTEGRITY_SNAPSHOT";
            }

            if (
                anomaly.type ===
                "SYSTEM_CRITICAL"
            ) {
                action =
                    "RESCAN";
            }

            const incident =
                await createIncident(
                    anomaly.type,
                    anomaly.severity,
                    target,
                    "Anomaly detected: " +
                    anomaly.type,
                    anomaly
                );

            const plan =
                await createRecoveryPlan(
                    incident,
                    action,
                    target,
                    anomaly.severity
                );

            plans.push(plan);

            if (
                CONFIG.automaticRecovery &&
                plan.automatic
            ) {
                await executeRecovery(
                    plan
                );
            }
        }

        return plans;
    }

    /* ============================================================
       RECOVERY SCAN
       ============================================================ */

    async function recoveryScan() {
        STATE.lastRecoveryScan =
            now();

        const anomalies =
            detectAnomalies();

        const plans =
            await processAnomalies(
                anomalies
            );

        return {
            timestamp: now(),
            anomalies:
                anomalies,
            plans:
                plans
        };
    }

    /* ============================================================
       INTEGRITY CHAIN
       ============================================================ */

    async function verifyRecentIntegrity() {
        if (
            STATE.snapshots.length <
            2
        ) {
            return {
                valid: true,
                reason:
                    "INSUFFICIENT_HISTORY"
            };
        }

        const latest =
            STATE.snapshots[0];

        const previous =
            STATE.snapshots[1];

        const latestHash =
            await hash(
                latest.payload
            );

        const previousHash =
            await hash(
                previous.payload
            );

        const valid =
            latestHash ===
            latest.fingerprint ||
            previousHash ===
            previous.fingerprint;

        return {
            valid:
                !!valid,

            latest:
                latest.id,

            previous:
                previous.id,

            timestamp:
                now()
        };
    }

    /* ============================================================
       EVENT MONITORING
       ============================================================ */

    function installEventMonitoring() {
        if (
            STATE.eventHandlersInstalled
        ) {
            return;
        }

        if (
            CORE &&
            typeof CORE.on ===
            "function"
        ) {
            const watchedEvents = [
                "ERROR",
                "WORKER_ERROR",
                "TASK_FAILED",
                "EVOLUTION_DECISION",
                "PATHWAY_ANALYSIS_COMPLETE",
                "MEMORY_ERROR"
            ];

            watchedEvents.forEach(
                function (eventName) {
                    try {
                        CORE.on(
                            eventName,
                            function (payload) {
                                createIncident(
                                    "SYSTEM_EVENT",
                                    eventName.indexOf(
                                        "ERROR"
                                    ) !== -1
                                        ? "WARNING"
                                        : "INFO",
                                    eventName,
                                    "Observed system event.",
                                    payload
                                );
                            }
                        );
                    } catch (e) {
                        /* Event channel may not exist. */
                    }
                }
            );
        }

        STATE.eventHandlersInstalled =
            true;
    }

    /* ============================================================
       WATCHDOG HEARTBEAT
       ============================================================ */

    async function heartbeat() {
        STATE.lastHeartbeat =
            now();

        STATE.metrics.heartbeatCount++;

        try {
            if (
                CORE &&
                typeof CORE.emit ===
                "function"
            ) {
                CORE.emit(
                    "WATCHDOG_HEARTBEAT",
                    {
                        timestamp:
                            now(),

                        cycle:
                            STATE.cycle,

                        health:
                            STATE.health.status,

                        score:
                            STATE.health.score
                    }
                );
            }
        } catch (e) {}

        return {
            timestamp:
                STATE.lastHeartbeat,

            cycle:
                STATE.cycle,

            status:
                STATE.health.status,

            score:
                STATE.health.score
        };
    }

    /* ============================================================
       AUTOMATIC CYCLE
       ============================================================ */

    async function cycle() {
        try {
            await heartbeat();

            await healthScan();

            const anomalies =
                detectAnomalies();

            if (
                anomalies.length
            ) {
                await processAnomalies(
                    anomalies
                );
            }

            if (
                now() -
                STATE.lastIntegrityScan >=
                CONFIG.integrityInterval
            ) {
                await integritySnapshot();
            }

        } catch (e) {
            await createIncident(
                "WATCHDOG_CYCLE_ERROR",
                "CRITICAL",
                "WATCHDOG",
                "Watchdog cycle failed.",
                {
                    error:
                        e.message,
                    stack:
                        e.stack
                }
            );
        }

        return getStatus();
    }

    /* ============================================================
       SCHEDULER
       ============================================================ */

    function startScheduler() {
        if (
            STATE.running
        ) {
            return;
        }

        STATE.running =
            true;

        const heartbeatTimer =
            setInterval(
                function () {
                    heartbeat();
                },
                CONFIG.heartbeatInterval
            );

        const healthTimer =
            setInterval(
                function () {
                    healthScan();
                },
                CONFIG.healthInterval
            );

        const integrityTimer =
            setInterval(
                function () {
                    integritySnapshot();
                },
                CONFIG.integrityInterval
            );

        const recoveryTimer =
            setInterval(
                function () {
                    recoveryScan();
                },
                CONFIG.recoveryInterval
            );

        STATE.timers.push(
            heartbeatTimer,
            healthTimer,
            integrityTimer,
            recoveryTimer
        );

        log(
            "Watchdog scheduler started."
        );
    }

    function stopScheduler() {
        STATE.timers.forEach(
            function (timer) {
                clearInterval(timer);
            }
        );

        STATE.timers = [];

        STATE.running =
            false;

        log(
            "Watchdog scheduler stopped."
        );
    }

    /* ============================================================
       STATUS
       ============================================================ */

    function getStatus() {
        return {
            protocol:
                CONFIG.protocol,

            version:
                CONFIG.version,

            booted:
                STATE.booted,

            running:
                STATE.running,

            uptime:
                now() -
                STATE.startedAt,

            cycle:
                STATE.cycle,

            health:
                safeClone(
                    STATE.health
                ),

            metrics:
                safeClone(
                    STATE.metrics
                ),

            modules:
                safeClone(
                    STATE.modules
                ),

            workers:
                safeClone(
                    STATE.workers
                ),

            incidents:
                STATE.incidents.length,

            snapshots:
                STATE.snapshots.length,

            recoveryPlans:
                STATE.recoveryPlans.length,

            lastHeartbeat:
                STATE.lastHeartbeat,

            lastHealthScan:
                STATE.lastHealthScan,

            lastIntegrityScan:
                STATE.lastIntegrityScan,

            lastRecoveryScan:
                STATE.lastRecoveryScan
        };
    }

    /* ============================================================
       QUERY APIs
       ============================================================ */

    function getIncidents(
        limit
    ) {
        limit =
            Number(limit) || 50;

        return STATE.incidents
            .slice(
                0,
                limit
            )
            .map(
                safeClone
            );
    }

    function getSnapshots(
        limit
    ) {
        limit =
            Number(limit) || 25;

        return STATE.snapshots
            .slice(
                0,
                limit
            )
            .map(
                safeClone
            );
    }

    function getRecoveryPlans(
        limit
    ) {
        limit =
            Number(limit) || 50;

        return STATE.recoveryPlans
            .slice(
                0,
                limit
            )
            .map(
                safeClone
            );
    }

    function clearResolvedIncidents() {
        STATE.incidents =
            STATE.incidents.filter(
                function (incident) {
                    return !incident.resolved;
                }
            );

        return true;
    }

    async function resolveIncident(
        incidentId,
        resolution
    ) {
        const incident =
            STATE.incidents.find(
                function (item) {
                    return (
                        item.id ===
                        incidentId
                    );
                }
            );

        if (!incident) {
            return false;
        }

        incident.resolved =
            true;

        incident.resolvedAt =
            now();

        incident.resolution =
            resolution ||
            "Resolved by Watchdog.";

        await persist(
            CONFIG.persistenceNamespace,
            incident.id,
            incident
        );

        return true;
    }

    /* ============================================================
       SAFE MANUAL COMMAND INTERFACE
       ============================================================ */

    async function command(
        action,
        payload
    ) {
        payload =
            payload || {};

        switch (
            String(action)
                .toUpperCase()
        ) {
            case "HEALTH":
                return healthScan();

            case "SNAPSHOT":
                return integritySnapshot();

            case "RECOVERY":
                return recoveryScan();

            case "HEARTBEAT":
                return heartbeat();

            case "STATUS":
                return getStatus();

            case "VERIFY":
                return verifyRecentIntegrity();

            case "INCIDENTS":
                return getIncidents(
                    payload.limit
                );

            case "PLANS":
                return getRecoveryPlans(
                    payload.limit
                );

            case "STOP":
                stopScheduler();

                return {
                    success: true,
                    status:
                        "STOPPED"
                };

            case "START":
                startScheduler();

                return {
                    success: true,
                    status:
                        "STARTED"
                };

            default:
                return {
                    success: false,
                    error:
                        "UNKNOWN_WATCHDOG_COMMAND"
                };
        }
    }

    /* ============================================================
       PUBLIC API
       ============================================================ */

    const API = {
        protocol:
            CONFIG.protocol,

        version:
            CONFIG.version,

        config:
            CONFIG,

        state:
            STATE,

        status:
            getStatus,

        heartbeat:
            heartbeat,

        health:
            healthScan,

        scan:
            healthScan,

        integrity:
            integritySnapshot,

        verify:
            verifyRecentIntegrity,

        anomalies:
            detectAnomalies,

        recovery:
            recoveryScan,

        createIncident:
            createIncident,

        incidents:
            getIncidents,

        resolveIncident:
            resolveIncident,

        plans:
            getRecoveryPlans,

        createRecoveryPlan:
            createRecoveryPlan,

        executeRecovery:
            executeRecovery,

        restartWorker:
            restartWorker,

        isolateWorker:
            isolateWorker,

        command:
            command,

        cycle:
            cycle,

        start:
            startScheduler,

        stop:
            stopScheduler,

        inspectModules:
            scanModules,

        inspectWorkers:
            scanWorkers
    };

    /* ============================================================
       GLOBAL REGISTRATION
       ============================================================ */

    global.CHIROMBE_WATCHDOG =
        API;

    global.CHIROMBE_WATCHDOG_ENGINE =
        API;

    /* ============================================================
       BOOT
       ============================================================ */

    async function boot() {
        if (STATE.booted) {
            return API;
        }

        STATE.booted =
            true;

        log(
            "=============================================="
        );

        log(
            "CHIROMBE WATCHDOG ENGINE"
        );

        log(
            "Protocol:",
            CONFIG.protocol
        );

        log(
            "Version:",
            CONFIG.version
        );

        log(
            "Booting integrity and recovery layer..."
        );

        installEventMonitoring();

        scanModules();

        scanWorkers();

        await heartbeat();

        await healthScan();

        await integritySnapshot();

        /*
         * Register watchdog workers with the existing
         * worker swarm when available.
         */
        if (
            WORKERS &&
            typeof WORKERS.register ===
            "function"
        ) {
            try {
                WORKERS.register(
                    "WATCHDOG_HEALTH",
                    async function () {
                        return healthScan();
                    },
                    {
                        priority: 100,
                        protected: true
                    }
                );

                WORKERS.register(
                    "WATCHDOG_SCAN",
                    async function () {
                        return cycle();
                    },
                    {
                        priority: 95,
                        protected: true
                    }
                );

                WORKERS.register(
                    "WATCHDOG_RECOVERY",
                    async function (payload) {
                        if (
                            payload &&
                            payload.plan
                        ) {
                            return executeRecovery(
                                payload.plan
                            );
                        }

                        return recoveryScan();
                    },
                    {
                        priority: 90,
                        protected: true
                    }
                );

                WORKERS.register(
                    "WATCHDOG_STATUS",
                    async function () {
                        return getStatus();
                    },
                    {
                        priority: 80,
                        protected: true
                    }
                );

            } catch (e) {
                warn(
                    "Watchdog worker registration:",
                    e.message
                );
            }
        }

        startScheduler();

        try {
            if (
                typeof CORE.emit ===
                "function"
            ) {
                CORE.emit(
                    "WATCHDOG_BOOTED",
                    getStatus()
                );
            }
        } catch (e) {}

        log(
            "Watchdog online."
        );

        log(
            "Integrity monitoring active."
        );

        log(
            "Recovery intelligence active."
        );

        log(
            "=============================================="
        );

        return API;
    }

    /* ============================================================
       START
       ============================================================ */

    boot().catch(
        function (e) {
            error(
                "BOOT FAILURE:",
                e
            );
        }
    );

})(window);

