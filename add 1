/* ============================================================
   14 · REPLAY PROTECTION
   ============================================================ */

function checkReplay(nonce){

  if(!nonce){
    return {
      ok:true
    };
  }

  const now = Date.now();

  for(
    const [key,time]
    of STATE.seenNonces
  ){

    if(
      now - time >
      CONFIG.REPLAY_WINDOW
    ){

      STATE.seenNonces.delete(key);

    }

  }

  if(
    STATE.seenNonces.has(nonce)
  ){

    return {
      ok:false,
      reason:"REPLAY_DETECTED"
    };

  }

  STATE.seenNonces.set(
    nonce,
    now
  );

  return {
    ok:true
  };

}


