    /* ----------------------------------------------------------------------
       OBJECTIVE ROUTING
       ---------------------------------------------------------------------- */

    function routeObjective(
        objectiveId
    ) {

        const objective =
            STATE.objectives.get(
                objectiveId
            );


        if (!objective) {

            return null;

        }


        if (!objective.target) {

            return null;

        }


        const source =
            "SYSTEM_CORE";


        const path =
            findPath(

                source,

                objective.target,

                {

                    maximumDepth:
                        20

                }

            );


        if (!path) {

            objective.status =
                "NO_ROUTE";


            return {

                objective:
                    objectiveId,

                status:
                    "NO_ROUTE"

            };

        }


        const route = {

            id:
                uid("ROUTE"),

            objectiveId:
                objectiveId,

            path:
                path,

            priority:
                objective.priority,

            status:
                "READY",

            created:
                now(),

            hash:
                null

        };


        route.hash =
            hash(
                route
            );


        STATE.routes.set(
            route.id,
            route
        );


        STATE.metrics.routes =
            STATE.routes.size;


        STATE.timestamps.lastRoute =
            now();


        saveMemory(

