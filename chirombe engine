/* ================================================================
   LEGACY PRESERVATION ENGINE
   ================================================================ */

function preservationAudit(){

    const people = Object.values(state.persons);

    const knowledge = Object.values(state.knowledge);

    const assets = Object.values(state.assets);

    const missing = [];

    if(!people.length){

        missing.push("PEOPLE");

    }

    if(!knowledge.length){

        missing.push("KNOWLEDGE");

    }

    if(!assets.length){

        missing.push("LEGACY_ASSETS");

    }

    const report = {

        timestamp:now(),

        people:people.length,

        knowledge:knowledge.length,

        assets:assets.length,

        missing,

        preservationScore:

            clamp(

                (

                    (people.length ? 1 : 0) +

                    (knowledge.length ? 1 : 0) +

                    (assets.length ? 1 : 0)

                ) / 3

            )

    };

    persist("PRESERVATION_AUDIT",report);

    emit("BLOODLINE_PRESERVATION_AUDIT",report);

    return clone(report);

}


