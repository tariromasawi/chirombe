    /* ----------------------------------------------------------------------
       EVOLUTION INTEGRATION
       ---------------------------------------------------------------------- */

    function importEvolutionProposals() {

        if (!EVOLUTION) {

            return 0;

        }


        let proposals = [];


        try {

            if (
                typeof EVOLUTION.getProposals ===
                "function"
            ) {

                proposals =
                    EVOLUTION.getProposals();

            }

        } catch (error) {

            STATE.metrics.failures++;

            log(
                "Unable to read evolution proposals.",
                error.message
            );

            return 0;

        }


        let imported = 0;


        for (
            const proposal
            of proposals
        ) {

            const nodeId =
                "PROPOSAL_" +
                proposal.id;


            if (
                STATE.nodes.has(
                    nodeId
                )
            ) {

                continue;

            }


            const node =
                createNode({

                    id:
                        nodeId,

                    type:
                        "PROPOSAL",

                    name:
                        proposal.objective ||
                        proposal.id,

                    description:
                        proposal.objective ||
                        "",

                    importance:
                        numeric(
                            proposal.scores &&
                            proposal.scores.total,
                            0.5
                        ),

                    resilience:
                        0.7,

                    metadata: {

                        proposal:
                            clone(proposal)

                    }

                });


            imported++;


            const targetId =
                "SYSTEM_" +
                String(
                    proposal.target ||
                    "EVOLUTION"
                ).toUpperCase();


            if (
                STATE.nodes.has(
                    targetId
                )
            ) {

                createEdge(

                    "SYSTEM_EVOLUTION",

                    node.id,

                    {

                        type:
                            "PROPOSAL_GENERATION",

                        confidence:
                            0.85,

                        weight:
                            0.80

                    }

                );


                createEdge(

                    node.id,

                    targetId,

                    {

                        type:
                            "PROPOSED_CHANGE",

                        confidence:
                            numeric(
                                proposal.scores &&
                                proposal.scores.total,
                                0.60
                            ),

                        weight:
                            0.75

                    }

                );

            }

        }


        return imported;

    }


    /* ----------------------------------------------------------------------
       PATH SEARCH
       ---------------------------------------------------------------------- */

    function findPath(
        start,
        target,
        options = {}
    ) {

        if (
            !STATE.nodes.has(start) ||
            !STATE.nodes.has(target)
        ) {

            return null;

        }


        const queue = [

            {

                node:
                    start,

                path:
                    [start],

                score:
                    1,

                cost:
                    0

            }

        ];


        const visited =
            new Set();


        const maximumDepth =
            options.maximumDepth ||
            20;


        while (
            queue.length > 0
        ) {

            queue.sort(

                (a, b) =>
                    b.score -
                    a.score

            );


            const current =
                queue.shift();


            if (
                current.node ===
                target
            ) {

                return {

                    id:
                        uid("PATH"),

                    start:
                        start,

                    target:
                        target,

                    nodes:
                        current.path,

                    confidence:
                        clamp(
                            current.score,
                            0,
                            1
                        ),

                    cost:
                        current.cost,

                    depth:
                        current.path.length - 1,

                    created:
                        now()

                };

            }


            if (
                current.path.length >
                maximumDepth
            ) {

                continue;

            }


            if (
                visited.has(
                    current.node
                )
            ) {

                continue;

            }


            visited.add(
                current.node
            );


            const edges =
                getOutgoing(
                    current.node
                );


            for (
                const edge
                of edges
            ) {

                if (
                    visited.has(
                        edge.to
                    )
                ) {

                    continue;

                }


                const nextScore =
                    current.score *
                    edge.confidence;


                const nextCost =
                    current.cost +
                    edge.cost;


                queue.push({

                    node:
                        edge.to,

                    path:
                        current.path.concat(
                            edge.to
                        ),

                    score:
                        nextScore,

                    cost:
                        nextCost

                });

            }

        }


        return null;

    }


    /* ----------------------------------------------------------------------
       PATH REGISTRATION
       ---------------------------------------------------------------------- */

    function registerPath(
        path
    ) {

        if (!path) {

            return null;

        }


        const id =
            path.id ||
            uid("PATH");


        path.id =
            id;


        STATE.paths.set(
            id,
            path
        );


        STATE.metrics.paths =
            STATE.paths.size;


        if (
            STATE.paths.size >
            CONFIG.maximumPaths
        ) {

            const first =
                STATE.paths.keys()
                    .next()
                    .value;


            STATE.paths.delete(
                first
            );

        }


        return path;

    }


    /* ----------------------------------------------------------------------
       ROUTE OPTIMISATION
       ---------------------------------------------------------------------- */

    function analyseRoutes() {

        const routes = [];


        const importantNodes =
            Array.from(
                STATE.nodes.values()
            )
                .filter(

                    node =>
                        node.importance >=
                        0.70

                );


        for (
            const source
            of importantNodes
        ) {

            for (
                const target
                of importantNodes
            ) {

                if (
                    source.id ===
                    target.id
                ) {

                    continue;

                }


                const path =
                    findPath(

                        source.id,

                        target.id,

                        {

                            maximumDepth:
                                12

                        }

                    );


                if (!path) {

                    continue;

                }


                if (
                    path.confidence <
                    CONFIG.minimumPathConfidence
                ) {

                    continue;

                }


                registerPath(
                    path
                );


                routes.push(
                    path
                );

            }

        }


        STATE.metrics.analyses++;

        STATE.timestamps.lastAnalysis =
            now();


        return routes;

    }


