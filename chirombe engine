        ()=>{

            try{

                buildTrustGraph();

                selfTest();

            }catch(error){}

        },

        CONFIG.integrityInterval

    );

}


function stopTimers(){

    Object.keys(state.timers).forEach(key=>{

        if(state.timers[key]){

            clearInterval(state.timers[key]);

            state.timers[key] = null;

        }

    });

}


/* ================================================================
   COMMAND CONSOLE
   ================================================================ */

function command(name,payload={}){

    const cmd =

        safeString(name).toUpperCase();

    switch(cmd){

        case "STATUS":

            return status();

        case "SCAN":

            return scan();

        case "CONTINUITY":

            return calculateContinuity();

        case "CYCLE":

            return continuityCycle();

        case "RESILIENCE":

            return resilienceScore();

        case "VECTOR":

            return stateVector();

        case "TRUST":

            return buildTrustGraph();

        case "PRESERVATION":

            return preservationAudit();

        case "SELF_TEST":

            return selfTest();

        case "RECOVERY":

            return createRecoveryPlan(payload);

        case "OBJECTIVE":

            return createObjective(payload);

        case "PATHWAY":

            return createProtectivePathway();

        case "EXPORT":

            return exportState();

        case "START":

            start();

            return status();

        case "STOP":

            stop();

            return status();

        default:

            return {

                success:false,

                error:"UNKNOWN_COMMAND",

                command:cmd

            };

    }

}


/* ================================================================
   START / STOP
   ================================================================ */

function start(){

    if(state.active) return status();

    state.active = true;

    state.startedAt =

        state.startedAt || now();

    startTimers();

    emit(

        "BLOODLINE_ENGINE_STARTED",

        status()

    );

    return status();

}


function stop(){

    state.active = false;

    stopTimers();

    emit(

