function randomBytes(length=16){

  const bytes =
    new Uint8Array(length);

  if(
    window.crypto &&
    crypto.getRandomValues
  ){

    crypto.getRandomValues(bytes);

  }else{

    for(
      let i=0;
      i<length;
      i++
    ){

      bytes[i] =
        Math.floor(
          Math.random()*256
        );

    }

  }

  return bytes;

}


function hex(bytes){

  return [...bytes]
    .map(
      b => b
        .toString(16)
        .padStart(2,"0")
    )
    .join("");

}


function makeId(prefix="EVT"){

