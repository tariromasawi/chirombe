    /* ============================================================
       CODE TEMPLATE ENGINE
       ============================================================ */

    function generateModuleTemplate(
        name,
        purpose
    ) {

        const safeName =
            String(
                name ||
                "New Module"
            )
                .replace(
                    /[^a-zA-Z0-9_$]/g,
                    "_"
                );

        const safePurpose =
            String(
                purpose ||
                "Extensible CHIROMBE module."
            )
                .replace(
                    /\*\//g,
                    "* /"
                );

        return (
`/* ================================================================
   CHIROMBE GENERATED MODULE
   Name    : ${safeName}
   Purpose : ${safePurpose}
   ================================================================ */

(function (global) {
    "use strict";

    if (!global.CHIROMBE) {
        console.error(
            "[CHIROMBE MODULE] Core unavailable."
        );
        return;
    }

    const CORE =
        global.CHIROMBE;

    const STATE = {
        booted: false,
        createdAt: Date.now(),
        metrics: {
            calls: 0
        }
    };

    function status() {
        return {
            name:
                "${safeName}",

            purpose:
                "${safePurpose}",

            booted:
                STATE.booted,

            metrics:
                STATE.metrics
        };
    }

    function execute(payload) {

        STATE.metrics.calls++;

        return {
            success:
                true,

            payload:
                payload || {},

            timestamp:
                Date.now()
        };
    }

    const API = {
        status:
            status,

        execute:
            execute
    };

    global.CHIROMBE_${safeName.toUpperCase()} =
        API;

    STATE.booted =
        true;

})(window);

/* ================================================================
   END GENERATED MODULE
   ================================================================ */
`
        );
    }

