    /* ============================================================
       WORKER REGISTRATION
       ============================================================ */

    function registerWorkers() {

        if (
            !WORKERS ||
            typeof WORKERS.register !==
                "function"
        ) {
            return;
        }

        try {

            WORKERS.register(
                "BUILD_DISCOVERY",
                async function () {

                    return discoverArchitecture();
                },
                {
                    priority:
                        50
                }
            );

            WORKERS.register(
                "BUILD_PLANNER",
                async function (
                    payload
                ) {

                    if (
                        payload &&
                        payload.requirementId
                    ) {

                        return planRequirement(
                            payload.requirementId
                        );
                    }

                    return cycle();
                },
                {
                    priority:
                        48
                }
            );

            WORKERS.register(
                "BUILD_VALIDATOR",
                async function (
                    payload
                ) {

                    if (
                        payload &&
                        payload.proposalId
                    ) {

                        return validateProposal(
                            payload.proposalId
                        );
                    }

                    return {
                        success:
                            false,

                        reason:
                            "PROPOSAL_ID_REQUIRED"
                    };
                },
                {
                    priority:
                        46
                }
            );

            WORKERS.register(
                "BUILD_PACKAGER",
                async function (
                    payload
                ) {

                    if (
                        payload &&
                        payload.proposalId
                    ) {

                        return packageProposal(
                            payload.proposalId
                        );
                    }

                    return {
                        success:
                            false,

                        reason:
                            "PROPOSAL_ID_REQUIRED"
                    };
                },
                {
                    priority:
                        44
                }
            );

            WORKERS.register(
                "BUILD_STATUS",
                async function () {

                    return status();
                },
                {
                    priority:
                        40
                }
            );

        } catch (e) {

            console.warn(
                "[CHIROMBE BUILD] Worker registration:",
                e.message
            );
        }
    }

