    /* ============================================================
       PACKAGE INTEGRITY
       ============================================================ */

    async function verifyPackage(
        packageId
    ) {

        const packageData =
            STATE.packages[
                packageId
            ];

        if (!packageData) {

            return {
                valid:
                    false,

                reason:
                    "PACKAGE_NOT_FOUND"
            };
        }

        const copy =
            clone(
                packageData
            );

        delete copy.integrity;

        const calculated =
            await digest(
                copy
            );

        return {

            valid:
                calculated ===
                packageData.integrity,

            expected:
                packageData.integrity,

            calculated:
                calculated,

            packageId:
                packageId
        };
    }

