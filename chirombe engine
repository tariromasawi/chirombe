        const protectedWorker =
            CONFIG
                .protectedWorkerTypes
                .indexOf(workerName) !== -1;

        try {
            if (
                typeof WORKERS.cancel ===
                "function"
            ) {
                /*
                 * Cancel is intentionally used only as a
                 * non-destructive recovery action.
                 */
                WORKERS.cancel(
                    workerName
                );
            }

            STATE.metrics.workerRestarts++;

            return {
                success: true,
                worker:
                    workerName,
                protected:
                    protectedWorker,
                timestamp:
                    now()
            };
        } catch (e) {
            return {
                success: false,
                worker:
                    workerName,
                error:
                    e.message
            };
        }
    }

    /* ============================================================
       WORKER ISOLATION
       ============================================================ */

    async function isolateWorker(
        workerName
    ) {
        const protectedWorker =
            CONFIG
                .protectedWorkerTypes
                .indexOf(workerName) !== -1;

        if (protectedWorker) {
            return {
                success: false,
                reason:
                    "PROTECTED_WORKER"
            };
        }

        /*
         * Browser implementation records the isolation
         * intention rather than deleting or destroying
         * worker definitions.
         */

        STATE.workers[
            workerName
        ] = Object.assign(
            {},
            STATE.workers[
                workerName
            ] || {},
            {
                isolated: true,
                isolatedAt: now()
            }
        );

        STATE.metrics.isolatedWorkers++;

        await persist(
            CONFIG.recoveryNamespace,
            "ISOLATION_" +
                workerName,
            {
                worker:
                    workerName,
                isolatedAt:
                    now()
            }
        );

        return {
            success: true,
            worker:
                workerName,
            action:
                "ISOLATED"
        };
    }

    /* ============================================================
       RECOVERY EXECUTION
       ============================================================ */

    async function executeRecovery(
        plan
    ) {
        if (!plan) {
            return {
                success: false,
                reason:
                    "NO_PLAN"
            };
        }

        plan.attempts++;

        plan.status =
            "EXECUTING";

        let result = {
            success: false,
            reason:
                "UNKNOWN_ACTION"
        };

        try {
            switch (
                plan.action
            ) {
                case "RESTART_WORKER":
                    result =
                        await restartWorker(
                            plan.target
                        );
                    break;

                case "ISOLATE_WORKER":
                    result =
                        await isolateWorker(
                            plan.target
                        );
                    break;

                case "RESCAN":
                    result =
                        {
                            success: true,
                            scan:
                                await healthScan()
                        };
                    break;

                case "INTEGRITY_SNAPSHOT":
                    result =
                        {
                            success: true,
                            snapshot:
                                await integritySnapshot()
                        };
                    break;

                case "INSPECT":
                    result = {
                        success: true,
                        health:
                            safeClone(
                                STATE.health
                            )
                    };
                    break;

                default:
                    result = {
                        success: false,
                        reason:
                            "UNSUPPORTED_ACTION"
                    };
            }

            if (result.success) {
                plan.status =
                    "COMPLETED";

                STATE.metrics.recoveries++;

            } else {
                plan.status =
                    plan.attempts >=
                    plan.maximumAttempts
                        ? "FAILED"
                        : "RETRY_PENDING";

                STATE.metrics.failedRecoveries++;
            }
        } catch (e) {
            plan.status =
                plan.attempts >=
                plan.maximumAttempts
                    ? "FAILED"
                    : "RETRY_PENDING";

            result = {
                success: false,
                error:
                    e.message
            };

            STATE.metrics.failedRecoveries++;
        }

        plan.completedAt =
            now();

        plan.result =
            safeClone(result);

        await persist(
            CONFIG.recoveryNamespace,
            plan.id,
            plan
        );

        return result;
    }

    /* ============================================================
       ANOMALY → RECOVERY TRANSLATOR
       ============================================================ */

    async function processAnomalies(
        anomalies
    ) {
        const plans = [];

        for (
            let i = 0;
            i < anomalies.length;
            i++
        ) {
            const anomaly =
                anomalies[i];

            let action =
                "INSPECT";

            let target =
                anomaly.component ||
                "SYSTEM";

            if (
                anomaly.type ===
                "WORKER_UNHEALTHY"
            ) {
                action =
                    CONFIG
                        .automaticWorkerRestart
                        ? "RESTART_WORKER"
                        : "INSPECT";
            }

            if (
                anomaly.type ===
                "MODULE_MISSING"
            ) {
                action =
                    "INTEGRITY_SNAPSHOT";
            }

            if (
                anomaly.type ===
                "SYSTEM_CRITICAL"
            ) {
                action =
                    "RESCAN";
            }

            const incident =
                await createIncident(
                    anomaly.type,
                    anomaly.severity,
                    target,
                    "Anomaly detected: " +
                    anomaly.type,
                    anomaly
                );

            const plan =
                await createRecoveryPlan(
                    incident,
                    action,
                    target,
                    anomaly.severity
                );

            plans.push(plan);

            if (
                CONFIG.automaticRecovery &&
                plan.automatic
            ) {
                await executeRecovery(
                    plan
                );
            }
        }

        return plans;
    }

