                now(),

            payload:
                clone(payload || {})

        };

        STATE.events.unshift(
            record
        );

        if (
            STATE.events.length >
            CONFIG.maxEvents
        ) {

            STATE.events.length =
                CONFIG.maxEvents;

        }

        try {

            if (
                CORE &&
                typeof CORE.emit ===
                "function"
            ) {

                CORE.emit(
                    event,
                    payload
                );

            }

        } catch (error) {}

        return record;

    }


    function log(message, data) {

        try {

            if (
                CORE &&
                typeof CORE.log ===
                "function"
            ) {

                CORE.log(
                    "[BACKEND] " +
                    message,
                    data
                );

                return;

            }

        } catch (error) {}

        console.log(
            "[CHIROMBE BACKEND]",
            message,
            data || ""
        );

    }


    /* -----------------------------------------------------------------
       LOCAL STORAGE
       ----------------------------------------------------------------- */

    function storageKey(key) {

        return (
            CONFIG.localStoragePrefix +
            key
        );

    }


    function localSave(
        key,
        value
    ) {

        try {

            localStorage.setItem(
                storageKey(key),
                JSON.stringify(value)
            );

            return true;

        } catch (error) {

            STATE.lastError =
                error.message ||
                String(error);

            return false;

        }

    }


    function localLoad(
        key,
        fallback
    ) {

        try {

            const raw =
                localStorage.getItem(
                    storageKey(key)
                );

            if (!raw) {

                return fallback;

            }

            return JSON.parse(raw);

        } catch (error) {

            return fallback;

        }

    }


    function localDelete(key) {

        try {

            localStorage.removeItem(
                storageKey(key)
            );

            return true;

        } catch (error) {

            return false;

        }

    }


    /* -----------------------------------------------------------------
       CONFIGURATION
       ----------------------------------------------------------------- */

    function configure(options) {

        options =
            options || {};

        if (
            typeof options.apiBaseUrl ===
            "string"
        ) {

            CONFIG.API_BASE_URL =
                options.apiBaseUrl
                    .trim()
                    .replace(/\/+$/, "");

        }

        if (
            typeof options.automaticSync ===
            "boolean"
        ) {

            CONFIG.automaticSync =
                options.automaticSync;

        }

        if (
            typeof options.automaticHeartbeat ===
            "boolean"
        ) {

            CONFIG.automaticHeartbeat =
                options.automaticHeartbeat;

        }

        if (
            typeof options.automaticRemoteExecution ===
            "boolean"
        ) {

            CONFIG.automaticRemoteExecution =
                options.automaticRemoteExecution;

        }

        STATE.backendConfigured =
            CONFIG.API_BASE_URL.length > 0;

        localSave(
            "CONFIG",
            {
                apiBaseUrl:
                    CONFIG.API_BASE_URL,

                automaticSync:
                    CONFIG.automaticSync,

                automaticHeartbeat:
                    CONFIG.automaticHeartbeat
            }
        );

        emit(
            "BACKEND_CONFIGURED",
            {
                configured:
                    STATE.backendConfigured
            }
        );

        return status();

    }


    /* -----------------------------------------------------------------
       RESTORE CONFIGURATION
       ----------------------------------------------------------------- */

    function restoreConfiguration() {

        const saved =
            localLoad(
                "CONFIG",
                null
            );

        if (!saved) {

            return;

        }

        if (
            typeof saved.apiBaseUrl ===
            "string"
        ) {

            CONFIG.API_BASE_URL =
                saved.apiBaseUrl;

        }

        if (
            typeof saved.automaticSync ===
            "boolean"
        ) {

            CONFIG.automaticSync =
                saved.automaticSync;

        }

        if (
            typeof saved.automaticHeartbeat ===
            "boolean"
        ) {

            CONFIG.automaticHeartbeat =
                saved.automaticHeartbeat;

        }

        STATE.backendConfigured =
            CONFIG.API_BASE_URL.length > 0;

    }


    /* -----------------------------------------------------------------
       ENDPOINT BUILDER
       ----------------------------------------------------------------- */

    function endpoint(
        name,
        id
    ) {

        if (
            !CONFIG.API_BASE_URL
        ) {

            return null;

        }

        let path =
            CONFIG.endpoints[name];

        if (!path) {

            return null;

        }

        if (id) {

            path =
                path.replace(
                    "{id}",
                    encodeURIComponent(id)
                );

        }

        return (
            CONFIG.API_BASE_URL +
            path
        );

    }


    /* -----------------------------------------------------------------
       REQUEST ENGINE
       ----------------------------------------------------------------- */

    async function request(
        method,
        url,
        body,
        options
    ) {

        options =
            options || {};

        if (!url) {

            throw new Error(
                "BACKEND_ENDPOINT_NOT_CONFIGURED"
            );

        }

        STATE.metrics.requests++;

        const controller =
            typeof AbortController !==
            "undefined"
                ? new AbortController()
                : null;

        let timeoutId =
            null;

        if (controller) {

            timeoutId =
                setTimeout(
                    () =>
                        controller.abort(),
                    options.timeout ||
                    CONFIG.requestTimeout
                );

        }

        try {

            const headers = {

                "Content-Type":
                    "application/json",

                "X-Chirombe-Protocol":
                    CONFIG.protocol,

                "X-Chirombe-Version":
                    CONFIG.version,

                "X-Chirombe-Instance":
                    CONFIG.instanceId

            };

            if (
                options.headers
            ) {

                Object.assign(
                    headers,
                    options.headers
                );

            }

            const response =
                await fetch(
                    url,
                    {

                        method:
                            method || "GET",

                        headers,

                        body:
                            body == null
                                ? undefined
                                : JSON.stringify(
                                    body
                                ),

                        signal:
                            controller
                                ? controller.signal
                                : undefined
                    }
                );

            if (timeoutId) {

                clearTimeout(
                    timeoutId
                );

            }

            if (!response.ok) {

                throw new Error(
                    "HTTP_" +
                    response.status
                );

            }

            let data =
                null;

            const contentType =
                response.headers.get(
                    "content-type"
                ) || "";

            if (
                contentType.includes(
                    "application/json"
                )
            ) {

                data =
                    await response.json();

            } else {

                data =
                    await response.text();

            }

            STATE.metrics.successfulRequests++;

            STATE.online = true;

            STATE.lastError =
                null;

            return data;

        } catch (error) {

            if (timeoutId) {

                clearTimeout(
                    timeoutId
                );

            }

            STATE.metrics.failedRequests++;

            STATE.online = false;

            STATE.lastError =
                error.message ||
                String(error);

            throw error;

        }

    }


    /* -----------------------------------------------------------------
       HEALTH CHECK
       ----------------------------------------------------------------- */

    async function heartbeat() {

        STATE.metrics.heartbeats++;

        STATE.lastHeartbeat =
            now();

        if (
            !CONFIG.API_BASE_URL
        ) {

            STATE.online = false;

            return {

                online:
                    false,

                configured:
                    false,

                reason:
                    "BACKEND_URL_NOT_CONFIGURED",

                timestamp:
                    now()

            };

        }

        try {

            const result =
                await request(
                    "GET",
                    endpoint(
                        "health"
                    )
                );

            STATE.online = true;

            emit(
                "BACKEND_HEARTBEAT_OK",
                result
            );

            return {

                online:
                    true,

                configured:
                    true,

                response:
                    clone(result),

                timestamp:
                    now()

            };

        } catch (error) {

            STATE.online = false;

            emit(
                "BACKEND_HEARTBEAT_FAILED",
                {
                    error:
                        error.message
                }
            );

            return {

                online:
                    false,

                configured:
                    true,

                error:
                    error.message,

                timestamp:
                    now()

            };

        }

    }


    /* -----------------------------------------------------------------
       EVENT QUEUE
       ----------------------------------------------------------------- */

    function queueEvent(
        event,
        payload
    ) {

        const item = {

            id:
                createId("QUEUE"),

            event:
                event,

            payload:
                clone(payload || {}),

            timestamp:
                now(),

            attempts:
                0,

            status:
                "QUEUED"

        };

        STATE.queue.push(
            item
        );

        STATE.metrics.queued++;

        if (
            STATE.queue.length >
            CONFIG.maxQueue
        ) {

            STATE.queue.shift();

        }

        localSave(
            "QUEUE",
            STATE.queue
        );

        emit(
            "BACKEND_EVENT_QUEUED",
            item
        );

        return clone(item);

    }


    /* -----------------------------------------------------------------
       SYNCHRONISE EVENTS
       ----------------------------------------------------------------- */

    async function syncEvents() {

        if (
            !STATE.queue.length
        ) {

            return {

                synced:
                    0,

                remaining:
                    0

            };

        }

        if (
            !CONFIG.API_BASE_URL
        ) {

            return {

                synced:
                    0,

                remaining:
                    STATE.queue.length,

                offline:
                    true

            };

        }

        const batch =
            STATE.queue.slice(
                0,
                100
            );

        batch.forEach(
            item =>
                item.attempts++
        );

        try {

            const response =
                await request(
                    "POST",
                    endpoint(
                        "events"
                    ),
                    {
                        protocol:
                            CONFIG.protocol,

                        version:
                            CONFIG.version,

                        instance:
                            CONFIG.instanceId,

                        events:
                            batch
                    }
                );

            const ids =
                new Set(
                    batch.map(
                        item =>
                            item.id
                    )
                );

            STATE.queue =
                STATE.queue.filter(
                    item =>
                        !ids.has(
                            item.id
                        )
                );

            STATE.metrics.synced +=
                batch.length;

            STATE.lastSync =
                now();

            localSave(
                "QUEUE",
                STATE.queue
            );

            STATE.syncHistory.unshift({

                timestamp:
                    now(),

                count:
                    batch.length,

                response:
                    clone(response)

            });

            emit(
                "BACKEND_SYNC_COMPLETE",
                {
                    count:
                        batch.length
                }
            );

            return {

                synced:
                    batch.length,

                remaining:
                    STATE.queue.length,

                response:
                    clone(response)

            };

        } catch (error) {

            batch.forEach(
                item => {

                    item.status =
                        "RETRY";

                }
            );

            localSave(
                "QUEUE",
                STATE.queue
            );

            return {

                synced:
                    0,

                remaining:
                    STATE.queue.length,

                error:
                    error.message

            };

        }

    }


    /* -----------------------------------------------------------------
       SNAPSHOT ENGINE
       ----------------------------------------------------------------- */

    function collectSystemState() {

        const result = {

            protocol:
                CONFIG.protocol,

            version:
                CONFIG.version,

            instance:
                CONFIG.instanceId,

            timestamp:
                now(),

            core:
                safeStatus(
                    CORE
                ),

            memory:
                safeStatus(
                    MEMORY
                ),

            workers:
                safeStatus(
                    WORKERS
                ),

            evolution:
                safeStatus(
                    EVOLUTION
                ),

            pathways:
                safeStatus(
                    PATHWAYS
                ),

            watchdog:
                safeStatus(
                    WATCHDOG
                ),

            knowledge:
                safeStatus(
                    KNOWLEDGE
                ),

            build:
                safeStatus(
                    BUILD
                ),

            orchestrator:
                safeStatus(
                    ORCHESTRATOR
                )

        };

        return result;

    }


    function safeStatus(
        module
    ) {

        if (!module) {

            return {

                available:
                    false

            };

        }

        try {

            if (
                typeof module.status ===
                "function"
            ) {

                return {

                    available:
                        true,

                    status:
                        clone(
                            module.status()
                        )

                };

            }

        } catch (error) {

            return {

                available:
                    true,

                error:
                    error.message

            };

        }

        return {

            available:
                true

        };

    }


    function createSnapshot(
        label
    ) {

        const snapshot = {

            id:
                createId("SNAPSHOT"),

            label:
                label ||
                "Chirombe System Snapshot",

            timestamp:
                now(),

            system:
                collectSystemState(),

            metrics:
                clone(
                    STATE.metrics
                )

        };

        STATE.snapshots.unshift(
            snapshot
        );

        if (
            STATE.snapshots.length >
            CONFIG.maxSnapshots
        ) {

            STATE.snapshots.length =
                CONFIG.maxSnapshots;

        }

        STATE.metrics.snapshots++;

        localSave(
            "SNAPSHOTS",
            STATE.snapshots
        );

        emit(
            "BACKEND_SNAPSHOT_CREATED",
            {
                id:
                    snapshot.id
            }
        );

        return clone(snapshot);

    }


    async function uploadSnapshot(
        snapshot
    ) {

        snapshot =
            snapshot ||
            createSnapshot();

        if (
            !CONFIG.API_BASE_URL
        ) {

            return {

                uploaded:
                    false,

                offline:
                    true,

                snapshotId:
                    snapshot.id

            };

        }

        try {

            const response =
                await request(
                    "POST",
                    endpoint(
                        "snapshot"
                    ),
                    snapshot
                );

            emit(
                "BACKEND_SNAPSHOT_UPLOADED",
                {
                    snapshotId:
                        snapshot.id
                }
            );

            return {

                uploaded:
                    true,

                response:
                    clone(response)

            };

        } catch (error) {

            return {

                uploaded:
                    false,

                error:
                    error.message

            };

        }

    }


    /* -----------------------------------------------------------------
       REMOTE JOB SUBMISSION
       ----------------------------------------------------------------- */

    async function submitJob(
        job
    ) {

        job =
            Object.assign(
                {

                    id:
                        createId("JOB"),

                    protocol:
                        CONFIG.protocol,

                    version:
                        CONFIG.version,

                    instance:
                        CONFIG.instanceId,

                    createdAt:
                        now(),

                    status:
                        "QUEUED"

                },

                clone(job || {})
            );

        /*
         * Never permit a remotely supplied job to become an
         * unrestricted production rewrite.
         */

        job.safety =
            Object.assign(
                {

                    allowCodeExecution:
                        false,

                    allowProductionDeployment:
                        false,

                    allowProtectedModification:
                        false

                },

                job.safety || {}
            );

        if (
            job.safety.allowCodeExecution !==
            false
        ) {

            job.safety.allowCodeExecution =
                false;

        }

        if (
            job.safety.allowProductionDeployment !==
            false
        ) {

            job.safety.allowProductionDeployment =
                false;

        }

        if (
            job.safety.allowProtectedModification !==
            false
        ) {

            job.safety.allowProtectedModification =
                false;

        }

        STATE.remoteJobs[job.id] =
            job;

        STATE.metrics.jobsSubmitted++;

        if (
            !CONFIG.API_BASE_URL
        ) {

            queueEvent(
                "REMOTE_JOB_REQUEST",
                job
            );

            return {

                submitted:
                    false,

                queued:
                    true,

                job:
                    clone(job)

            };

        }

        try {

            const response =
                await request(
                    "POST",
                    endpoint(
                        "jobs"
                    ),
                    job
                );

            if (
                response &&
                response.id
            ) {

                STATE.remoteJobs[
                    response.id
                ] =
                    Object.assign(
                        {},
                        job,
                        response
                    );

            }

            emit(
                "BACKEND_JOB_SUBMITTED",
                {
                    jobId:
                        job.id
                }
            );

            return {

                submitted:
                    true,

                response:
                    clone(response)

            };

        } catch (error) {

            queueEvent(
                "REMOTE_JOB_REQUEST",
                job
            );

            return {

                submitted:
                    false,

                queued:
                    true,

                error:
                    error.message,

                job:
                    clone(job)

            };

        }

    }


    /* -----------------------------------------------------------------
       REMOTE JOB STATUS
       ----------------------------------------------------------------- */

    async function getJob(
        jobId
    ) {

        if (!jobId) {

            return null;

        }

        if (
            !CONFIG.API_BASE_URL
        ) {

            return (
                STATE.remoteJobs[jobId] ||
                null
            );

        }

        try {

            const result =
                await request(
                    "GET",
                    endpoint(
                        "job",
                        jobId
                    )
                );

            STATE.remoteJobs[jobId] =
                Object.assign(
                    {},
                    STATE.remoteJobs[jobId] ||
                    {},
                    result
                );

            if (
                result.status ===
                "COMPLETE"
            ) {

                STATE.metrics.jobsCompleted++;

            }

            if (
                result.status ===
                "FAILED"
            ) {

                STATE.metrics.jobsFailed++;

            }

            return clone(result);

        } catch (error) {

            return {

                id:
                    jobId,

                status:
                    "UNKNOWN",

                error:
                    error.message

            };

        }

    }


    /* -----------------------------------------------------------------
       PERSIST SYSTEM STATE
       ----------------------------------------------------------------- */

    async function persistState() {

        const snapshot =
            createSnapshot(
                "Automatic Persistence Snapshot"
            );

        localSave(
            "LAST_STATE",
            snapshot
        );

        /*
         * Send only when a real backend has been configured.
         */

        if (
            STATE.backendConfigured
        ) {

            return uploadSnapshot(
                snapshot
            );

        }

        return {

            persisted:
                true,

            local:
                true,

            remote:
                false,

            snapshotId:
                snapshot.id

        };

    }


    /* -----------------------------------------------------------------
       EXTERNAL AI CONTEXT PACKAGE
       ----------------------------------------------------------------- */

    function createAIContext(
        instruction
    ) {

        const context = {

            protocol:
                "CHEP-10-AI-CONTEXT",

            timestamp:
                now(),

            instruction:
                String(
                    instruction || ""
                ),

            system:
                collectSystemState(),

            orchestration:
                safeStatus(
                    ORCHESTRATOR
                ),

            evolution:
                safeStatus(
                    EVOLUTION
                ),

            pathways:
                safeStatus(
                    PATHWAYS
                ),

            knowledge:
                safeStatus(
                    KNOWLEDGE
                ),

            build:
                safeStatus(
                    BUILD
                ),

            safety: {

                productionDeployment:
                    false,

                unrestrictedRewrite:
                    false,

                protectedModules:
                    clone(
                        CONFIG.protectedModules
                    )

            }

        };

        return context;

    }


    async function externalAIHandoff(
        instruction,
        provider
    ) {

        const packageData =
            createAIContext(
                instruction
            );

        packageData.provider =
            provider ||
            "EXTERNAL_AI";

        packageData.status =
            "READY_FOR_EXTERNAL_BRIDGE";

        /*
         * The backend receives the context.
         * The browser never directly executes arbitrary AI-generated
         * JavaScript.
         */

        if (
            !CONFIG.API_BASE_URL
        ) {

            queueEvent(
                "EXTERNAL_AI_HANDOFF",
                packageData
            );

            return {

                submitted:
                    false,

                queued:
                    true,

                context:
                    packageData

            };

        }

        try {

            const result =
                await request(
                    "POST",
                    endpoint(
                        "externalAI"
                    ),
                    packageData
                );

            emit(
                "BACKEND_EXTERNAL_AI_HANDOFF",
                {
                    provider:
                        packageData.provider
                }
            );

            return {

                submitted:
                    true,

                response:
                    clone(result)

            };

        } catch (error) {

            queueEvent(
                "EXTERNAL_AI_HANDOFF",
                packageData
            );

            return {

                submitted:
                    false,

                queued:
                    true,

                error:
                    error.message

            };

        }

    }


    /* -----------------------------------------------------------------
       BACKEND COMMAND
       ----------------------------------------------------------------- */

    async function command(
        type,
        payload
    ) {

        const commandType =
            String(type || "")
                .toUpperCase();

        switch (
            commandType
        ) {

            case "HEALTH":

                return heartbeat();


            case "SNAPSHOT":

                return createSnapshot(
                    payload &&
                    payload.label
                );


            case "PERSIST":

                return persistState();


            case "SYNC":

                return syncEvents();


            case "JOB":

                return submitJob(
                    payload
                );


            case "JOB_STATUS":

                return getJob(
                    payload &&
                    payload.jobId
                );


            case "AI":

                return externalAIHandoff(
                    payload &&
                    payload.instruction,

                    payload &&
                    payload.provider
                );


            case "STATUS":

                return status();


            case "CONFIGURE":

                return configure(
                    payload
                );


            default:

                return {

                    ok:
                        false,

                    error:
                        "UNKNOWN_BACKEND_COMMAND",

                    command:
                        commandType

                };

        }

    }


    /* -----------------------------------------------------------------
       EVENT CAPTURE
       ----------------------------------------------------------------- */

    function attachEventListeners() {

        if (
            !CORE ||
            typeof CORE.on !==
            "function"
        ) {

            return;

        }

        const events = [

            "ORCHESTRATOR_OBJECTIVE_CREATED",
            "ORCHESTRATOR_TASK_CREATED",
            "ORCHESTRATOR_TASK_COMPLETE",
            "ORCHESTRATOR_TASK_FAILED",
            "ORCHESTRATOR_OBJECTIVE_COMPLETE",
            "ORCHESTRATOR_EXTERNAL_AI_HANDOFF",
            "WATCHDOG_INCIDENT",
            "WATCHDOG_RECOVERY_REQUIRED",
            "EVOLUTION_DECISION",
            "BUILD_PROPOSAL_CREATED",
            "BUILD_VALIDATION_COMPLETE",
            "PATHWAY_ANALYSIS_COMPLETE",
            "SYSTEM_ERROR"

        ];

        events.forEach(
            eventName => {

                try {

                    CORE.on(
                        eventName,
                        payload => {

                            queueEvent(
                                eventName,
                                payload
                            );

                        }
                    );

                } catch (error) {}

            }
        );

    }


    /* -----------------------------------------------------------------
       LOAD LOCAL QUEUE
       ----------------------------------------------------------------- */

    function restoreLocalState() {

        const queue =
            localLoad(
                "QUEUE",
                []
            );

        if (
            Array.isArray(queue)
        ) {

            STATE.queue =
                queue;

        }

        const snapshots =
            localLoad(
                "SNAPSHOTS",
                []
            );

        if (
            Array.isArray(snapshots)
        ) {

            STATE.snapshots =
                snapshots;

        }

    }


    /* -----------------------------------------------------------------
       AUTOMATIC LOOP
       ----------------------------------------------------------------- */

    function startLoops() {

        if (
            CONFIG.automaticHeartbeat &&
            !STATE.timers.heartbeat
        ) {

            STATE.timers.heartbeat =
                setInterval(
                    () => {

                        heartbeat()
                            .catch(
                                () => {}
                            );

                    },
                    CONFIG.heartbeatInterval
                );

        }

        if (
            CONFIG.automaticSync &&
            !STATE.timers.sync
        ) {

            STATE.timers.sync =
                setInterval(
                    () => {

                        syncEvents()
                            .catch(
                                () => {}
                            );

                    },
                    CONFIG.syncInterval
                );

        }

    }


    function stopLoops() {

        if (
            STATE.timers.heartbeat
        ) {

            clearInterval(
                STATE.timers.heartbeat
            );

            STATE.timers.heartbeat =
                null;

        }

        if (
            STATE.timers.sync
        ) {

            clearInterval(
                STATE.timers.sync
            );

            STATE.timers.sync =
                null;

        }

    }


    /* -----------------------------------------------------------------
       STATUS
       ----------------------------------------------------------------- */

    function status() {

        return {

            protocol:
                CONFIG.protocol,

            version:
                CONFIG.version,

            system:
                CONFIG.system,

            instanceId:
                CONFIG.instanceId,

            booted:
                STATE.booted,

            online:
                STATE.online,

            backendConfigured:
                STATE.backendConfigured,

            apiConfigured:
                !!CONFIG.API_BASE_URL,

            lastHeartbeat:
                STATE.lastHeartbeat,

            lastSync:
                STATE.lastSync,

            lastError:
                STATE.lastError,

            queue:

                STATE.queue.length,

            snapshots:

                STATE.snapshots.length,

            remoteJobs:

                Object.keys(
                    STATE.remoteJobs
                ).length,

            metrics:
                clone(
                    STATE.metrics
                ),

