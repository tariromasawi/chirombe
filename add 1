<script>
(() => {

"use strict";

/* ============================================================
   UNIVERSAL RECOVERY MASTER
   BOTTOM EXECUTION CORE
   ============================================================ */

const VERSION = "URM-BOTTOM-1.0.0";

const state = {

  started: Date.now(),

  scans: 0,

  repairs: 0,

  warnings: 0,

  errors: 0,

  mutations: 0,

  interactionIssues: 0,

  duplicateIDs: 0,

  oversizedElements: 0,

  suspiciousLayers: 0,

  orphanedNodes: 0,

  scripts: 0,

  styles: 0,

  report: null,

  events: []

};


/* ============================================================
   DOM HELPERS
   ============================================================ */

const $ = id => document.getElementById(id);

const safe = (fn, fallback = null) => {

  try {

    return fn();

  } catch(error) {

    recordError(error);

    return fallback;

  }

};


/* ============================================================
   LOGGING
   ============================================================ */

function log(message, type = "info") {

  const timestamp =
    new Date().toLocaleTimeString();

  state.events.push({

    timestamp,

    type,

    message

  });

  if(state.events.length > 1000){

    state.events.shift();

  }

  const target = $("URM_LOG");

  if(target){

    const row =
      document.createElement("div");

    row.className =
      "log log-" + type;

    row.textContent =
      `[${timestamp}] ${message}`;

    target.appendChild(row);

    target.scrollTop =
      target.scrollHeight;

  }

}


function recordWarning(message){

  state.warnings++;

  log(message,"warn");

  updateMetrics();

}


function recordError(error){

  state.errors++;

  const message =
    error instanceof Error
      ? error.message
      : String(error);

  log(message,"error");

  updateMetrics();

}


/* ============================================================
   METRICS
   ============================================================ */

function updateMetrics(){

  const nodes =
    document.querySelectorAll("*").length;

  if($("URM_NODES"))
    $("URM_NODES").textContent =
      nodes.toLocaleString();

  if($("URM_WARNINGS"))
    $("URM_WARNINGS").textContent =
      state.warnings.toLocaleString();

  if($("URM_ERRORS"))
    $("URM_ERRORS").textContent =
      state.errors.toLocaleString();

}


/* ============================================================
   DOCUMENT STRUCTURE ANALYSIS
   ============================================================ */

function scanDOM(){

  state.scans++;

  log("Beginning deep DOM analysis...");

  const elements =
    [...document.querySelectorAll("*")];

  state.duplicateIDs = 0;
  state.oversizedElements = 0;
  state.suspiciousLayers = 0;
  state.orphanedNodes = 0;

  const ids =
    new Map();

  for(const element of elements){

    if(element.id){

      const count =
        (ids.get(element.id) || 0) + 1;

      ids.set(element.id,count);

    }

    const rect =
      safe(() => element.getBoundingClientRect());

    if(rect){

      const viewportArea =
        window.innerWidth *
        window.innerHeight;

      const area =
        rect.width *
        rect.height;

      if(
        viewportArea > 0 &&
        area > viewportArea * 12
      ){

        state.oversizedElements++;

      }

    }

    const style =
      safe(() =>
        getComputedStyle(element)
      );

    if(style){

      const z =
        parseInt(style.zIndex,10);

      if(
        Number.isFinite(z) &&
        Math.abs(z) > 100000
      ){

        state.suspiciousLayers++;

      }

    }

  }


  for(const [id,count] of ids){

    if(count > 1){

      state.duplicateIDs++;

      recordWarning(
        `Duplicate ID detected: ${id} × ${count}`
      );

    }

  }


  if(state.oversizedElements){

    recordWarning(
      `${state.oversizedElements} oversized element(s) detected`
    );

  }


  if(state.suspiciousLayers){

    recordWarning(
      `${state.suspiciousLayers} extreme z-index layer(s) detected`
    );

  }


  log(
    `DOM scan complete: ${elements.length} elements`,
    "good"
  );

}


/* ============================================================
   SCRIPT / STYLE INVENTORY
   ============================================================ */

function inventoryResources(){

  const scripts =
    [...document.scripts];

  const styles =
    [...document.querySelectorAll(
      "style,link[rel='stylesheet']"
    )];

  state.scripts =
    scripts.length;

  state.styles =
    styles.length;

  log(
    `Resource inventory: ${state.scripts} scripts / ${state.styles} styles`,
    "info"
  );

}


/* ============================================================
   LAYOUT ANALYSIS
   ============================================================ */

function analyseLayout(){

  log("Analysing visual stacking and overflow...");

  const elements =
    [...document.querySelectorAll("*")];

  let fixed = 0;
  let absolute = 0;
  let overflow = 0;

  for(const element of elements){

    const style =
      safe(() =>
        getComputedStyle(element)
      );

    if(!style) continue;

    if(style.position === "fixed")
      fixed++;

    if(style.position === "absolute")
      absolute++;

    if(
      style.overflow === "hidden" ||
      style.overflow === "scroll" ||
      style.overflow === "auto"
    ){

      overflow++;

    }

  }


  if(fixed > 25){

    recordWarning(
      `High fixed-layer count detected: ${fixed}`
    );

  }

  if(absolute > 100){

    recordWarning(
      `High absolute-position count detected: ${absolute}`
    );

  }

  log(
    `Layout analysis complete: fixed=${fixed}, absolute=${absolute}, managed-overflow=${overflow}`,
    "good"
  );

}


/* ============================================================
   INTERACTION AUDIT
   ============================================================ */

function auditInteractions(){

  log("Auditing interactive controls...");

  state.interactionIssues = 0;

  const controls =
    [...document.querySelectorAll(
      "button,a,input,select,textarea,[role='button']"
    )];

  for(const element of controls){

    const style =
      safe(() =>
        getComputedStyle(element)
      );

    if(!style) continue;

    if(
      style.pointerEvents === "none" &&
      style.visibility !== "hidden"
    ){

      state.interactionIssues++;

      recordWarning(
        `Interactive element blocked by pointer-events:none: ${element.tagName}`
      );

    }

    if(
      element.tagName === "A" &&
      !element.getAttribute("href") &&
      !element.onclick
    ){

      recordWarning(
        "Anchor without href or onclick detected"
      );

    }

  }

  log(
    `Interaction audit complete: ${controls.length} controls inspected`,
    "good"
  );

}


/* ============================================================
   SAFE LAYOUT RECONCILIATION
   ============================================================ */

function reconcileLayout(){

  state.repairs++;

  log("Starting conservative layout reconciliation...");

  const html =
    document.documentElement;

  const body =
    document.body;

  if(html){

    html.style.maxWidth = "100%";

  }

  if(body){

    body.style.maxWidth = "100%";

  }

  /*
    We intentionally DO NOT globally rewrite:

      z-index
      position
      display
      transform
      overflow
      pointer-events

    because doing so could destroy a legitimate application.

    Instead, only obvious pathological conditions are addressed.
  */

  const elements =
    [...document.querySelectorAll("*")];

  let repaired = 0;

  for(const element of elements){

    const rect =
      safe(() => element.getBoundingClientRect());

    if(!rect) continue;

    if(
      rect.width === 0 &&
      rect.height === 0
    ){

      continue;

    }

    const style =
      safe(() =>
        getComputedStyle(element)
      );

    if(!style) continue;

    if(
      style.position === "fixed" &&
      rect.width >
      window.innerWidth * 3
    ){

      element.style.maxWidth = "100vw";

      repaired++;

    }

  }

  log(
    `Conservative reconciliation completed: ${repaired} safe adjustment(s)`,
    "good"
  );

}


/* ============================================================
   BROWSER CAPABILITY DISCOVERY
   ============================================================ */

function capabilityReport(){

  const capabilities = {

    secureContext:
      window.isSecureContext,

    serviceWorker:
      "serviceWorker" in navigator,

    workers:
      typeof Worker !== "undefined",

    sharedWorkers:
      typeof SharedWorker !== "undefined",

    webCrypto:
      !!(
        window.crypto &&
        window.crypto.subtle
      ),

    indexedDB:
      "indexedDB" in window,

    localStorage:
      (() => {

        try{

          localStorage.setItem(
            "__urm_test",
            "1"
          );

          localStorage.removeItem(
            "__urm_test"
          );

          return true;

        }catch{

          return false;

        }

      })(),

    resizeObserver:
      "ResizeObserver" in window,

    mutationObserver:
      "MutationObserver" in window,

    intersectionObserver:
      "IntersectionObserver" in window,

    broadcastChannel:
      "BroadcastChannel" in window,

    webSocket:
      "WebSocket" in window,

    audio:
      "AudioContext" in window ||
