    }

    /* ============================================================
       QUERY APIs
       ============================================================ */

    function getIncidents(
        limit
    ) {
        limit =
            Number(limit) || 50;

        return STATE.incidents
            .slice(
                0,
                limit
            )
            .map(
                safeClone
            );
    }

    function getSnapshots(
        limit
    ) {
        limit =
            Number(limit) || 25;

        return STATE.snapshots
            .slice(
                0,
                limit
            )
            .map(
                safeClone
            );
    }

    function getRecoveryPlans(
        limit
    ) {
        limit =
            Number(limit) || 50;

        return STATE.recoveryPlans
            .slice(
                0,
                limit
            )
            .map(
                safeClone
            );
    }

    function clearResolvedIncidents() {
        STATE.incidents =
            STATE.incidents.filter(
                function (incident) {
                    return !incident.resolved;
                }
            );

        return true;
    }

    async function resolveIncident(
        incidentId,
        resolution
    ) {
        const incident =
            STATE.incidents.find(
                function (item) {
                    return (
                        item.id ===
                        incidentId
                    );
                }
            );

        if (!incident) {
            return false;
        }

        incident.resolved =
            true;

        incident.resolvedAt =
            now();

        incident.resolution =
            resolution ||
            "Resolved by Watchdog.";

        await persist(
            CONFIG.persistenceNamespace,
            incident.id,
            incident
        );

        return true;
    }

