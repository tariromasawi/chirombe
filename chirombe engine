        if (
            STATE.snapshots.length <
            2
        ) {
            return {
                valid: true,
                reason:
                    "INSUFFICIENT_HISTORY"
            };
        }

        const latest =
            STATE.snapshots[0];

        const previous =
            STATE.snapshots[1];

        const latestHash =
            await hash(
                latest.payload
            );

        const previousHash =
            await hash(
                previous.payload
            );

        const valid =
            latestHash ===
            latest.fingerprint ||
            previousHash ===
            previous.fingerprint;

        return {
            valid:
                !!valid,

            latest:
                latest.id,

            previous:
                previous.id,

            timestamp:
                now()
        };
    }

