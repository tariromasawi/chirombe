       -------------------------------------------------------------------- */

    function resilienceScore() {

        const telemetry =
            collectTelemetry();

        const names =
            Object.keys(
                telemetry.modules
            );

        const available =
            names.filter(
                name =>
                    telemetry
                        .modules[name]
                        .available
            ).length;

        const availability =
            names.length
                ? available /
                  names.length
                : 0;

        const crypto =
            telemetry.runtime
                .cryptoAvailable
                ? 1
                : 0;

        const network =
            telemetry.browser.online
                ? 1
                : 0;

        const incidentValues =
            Object.values(
                STATE.incidents
            );

        const openIncidents =
            incidentValues.filter(
                incident =>
                    incident.status !==
                    "RESOLVED"
            ).length;

        const incidentPenalty =
            clamp(
                openIncidents / 10,
                0,
                0.30
            );

        const score =
            clamp(
                availability * 0.45 +
                crypto * 0.20 +
                network * 0.10 +
                0.25 -
                incidentPenalty,
                0,
                1
            );

        return {

            score,

            percentage:
                Math.round(
                    score * 100
                ),

            availability,

            cryptography:
                crypto,

            network,

            openIncidents,

            timestamp:
                now()

        };

    }


