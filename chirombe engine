                    metrics.complexity,
                    0.5
                ),
                0,
                1
            );


        const evidence =
            proposal.evidence
                ? 0.80
                : 0.25;


        proposal.scores = {

            usefulness:
                usefulness,

            safety:
                safety,

            reliability:
                reliability,

            evidence:
                evidence,

            novelty:
                novelty,

            complexity:
                complexity,

            total:
                clamp(

                    (
                        usefulness * 0.25
                        +
                        safety * 0.25
                        +
                        reliability * 0.20
                        +
                        evidence * 0.15
                        +
                        novelty * 0.10
                        +
                        (1 - complexity) * 0.05
                    ),

                    0,
                    1

                )

        };


        return proposal;

    }


    /* ----------------------------------------------------------------------
       DECISION ENGINE
       ---------------------------------------------------------------------- */

    function decide(
        proposal
    ) {

        const scoreValue =
            number(
                proposal.scores.total
            );


        if (
            protectedProposal(
                proposal
            )
        ) {

            return {

                status:
                    "REQUIRES_REVIEW",

                score:
                    scoreValue,

                reason:
                    "Proposal intersects protected infrastructure."

            };

        }


        if (
            proposal.safeguards.sandbox !== true
        ) {

            return {

                status:
                    "REQUIRES_REVIEW",

                score:
                    scoreValue,

                reason:
                    "Sandbox protection is missing."

            };

        }


        if (
            proposal.safeguards.rollback !== true
        ) {

            return {

                status:
                    "REQUIRES_REVIEW",

                score:
                    scoreValue,

                reason:
                    "Rollback protection is missing."

            };

        }


        if (
            scoreValue >=
            CONFIG.strongAcceptanceScore
        ) {

            return {

                status:
                    "ACCEPTED",

                score:
                    scoreValue,

                reason:
                    "Proposal exceeded strong acceptance threshold."

            };

        }


        if (
            scoreValue >=
            CONFIG.minimumAcceptanceScore
        ) {

            return {

                status:
                    "ACCEPTED",

                score:
                    scoreValue,

                reason:
                    "Proposal exceeded minimum acceptance threshold."

            };

        }


        return {

            status:
                "REJECTED",

            score:
                scoreValue,

            reason:
                "Proposal did not achieve the required evolutionary threshold."

        };

    }


    /* ----------------------------------------------------------------------
       DECISION RECORD
       ---------------------------------------------------------------------- */

    async function recordDecision(
        proposal,
        decision
    ) {

        const record = {

            id:
                uid("DEC"),

            timestamp:
                timestamp(),

            proposalId:
                proposal.id,

            cycle:
                STATE.cycle,

            status:
                decision.status,

            score:
                decision.score,

            reason:
                decision.reason,

            productionMutation:
                false,

            sourceMutation:
                false,

            rollbackRequired:
                true,

            hash:
                null

        };


        record.hash =
            hash(
                record
            );


        proposal.status =
            decision.status;


        proposal.decisionId =
            record.id;


        STATE.decisions.push(
            record
        );


        STATE.metrics.reviewed++;


        if (
            decision.status ===
            "ACCEPTED"
        ) {

            STATE.accepted.push(
                proposal.id
            );

            STATE.metrics.accepted++;

        }


        if (
            decision.status ===
            "REJECTED"
        ) {

            STATE.rejected.push(
                proposal.id
            );

            STATE.metrics.rejected++;

        }


        await saveMemory(
            "DECISIONS",
            record.id,
            record
        );


        await saveMemory(
            "EVOLUTION",
            proposal.id,
            proposal
        );


        emit(
            "EVOLUTION_DECISION",
            record
        );


        return record;

    }


    /* ----------------------------------------------------------------------
       EVOLUTION CYCLE
       ---------------------------------------------------------------------- */

    async function evolve() {

        if (
            !CONFIG.enabled
        ) {

            return {

                status:
                    "DISABLED"

            };

        }


        STATE.cycle++;

        STATE.metrics.cycles++;

        STATE.timestamps.lastEvolution =
            timestamp();


        const observation =
            observe();


        const opportunities =
            detectOpportunities(
                observation
            );


        const results = [];


        for (
            const opportunity
            of opportunities
        ) {

            if (
                STATE.proposals.length >=
                CONFIG.maximumProposals
            ) {

                break;

            }


            const proposal =
                createProposal(
                    opportunity,
                    observation
                );


            const experiment =
                sandbox(
                    proposal
                );


            proposal.experimentId =
                experiment.id;


            score(
                proposal,
                experiment
            );


            const decision =
                decide(
                    proposal
                );


            const record =
                await recordDecision(
                    proposal,
                    decision
                );


            STATE.proposals.push(
                proposal
            );


            STATE.metrics.proposals++;


            results.push({

                proposal:
                    clone(proposal),

                experiment:
                    clone(experiment),

                decision:
                    clone(record)

            });


            /*
             * APPROVED EVOLUTION PATHWAY
             *
             * This becomes input for the future BUILD ENGINE.
             */

            if (
                decision.status ===
                "ACCEPTED"
            ) {

                await saveMemory(

                    "PATHWAYS",

                    proposal.id,

                    {

                        type:
                            "APPROVED_EVOLUTION_PATHWAY",

                        proposalId:
                            proposal.id,

                        objective:
                            proposal.objective,

                        target:
                            proposal.target,

                        score:
                            proposal.scores.total,

                        buildReady:
                            true,

                        productionMutation:
                            false,

                        created:
                            timestamp()

                    }

                );

            }

        }


        emit(

            "EVOLUTION_CYCLE_COMPLETE",

            {

                cycle:
                    STATE.cycle,

                opportunities:
                    opportunities.length,

                proposals:
                    results.length,

                accepted:
                    STATE.metrics.accepted,

                rejected:
                    STATE.metrics.rejected

            }

        );


        return {

            status:
                "COMPLETE",

            cycle:
                STATE.cycle,

            results:
                results

        };

    }


    /* ----------------------------------------------------------------------
       MANUAL PROPOSAL API
       ---------------------------------------------------------------------- */

    async function submit(
        input
    ) {

        if (
            !input ||
            typeof input !== "object"
        ) {

            throw new Error(
                "Evolution proposal must be an object."
            );

        }


        const opportunity = {

            id:
                uid("MANUAL_OPP"),

            type:
                input.type ||
                "MANUAL_OPTIMISATION",

            area:
                input.area ||
                "SYSTEM",

            description:
                input.description ||
                "Manual evolutionary improvement.",

            evidence:
                input.evidence ||
                {}

        };


        const observation = {

            id:
                uid("MANUAL_OBS"),

            timestamp:
                timestamp(),

            cycle:
                STATE.cycle,

            signals: []

        };


        const proposal =
            createProposal(
                opportunity,
                observation
            );


        const experiment =
            sandbox(
                proposal
            );


        proposal.experimentId =
            experiment.id;


        score(
            proposal,
            experiment
        );


        const decision =
            decide(
                proposal
            );


        const record =
            await recordDecision(
                proposal,
                decision
            );


        STATE.proposals.push(
            proposal
        );


        STATE.metrics.proposals++;


        return {

            proposal:
                clone(proposal),

            experiment:
                clone(experiment),

            decision:
                clone(record)

        };

    }


    /* ----------------------------------------------------------------------
       STATUS API
       ---------------------------------------------------------------------- */

    function status() {

        return {

            protocol:
                CONFIG.protocol,

            module:
                CONFIG.module,

            version:
                CONFIG.version,

            enabled:
                CONFIG.enabled,

            started:
                STATE.started,

            cycle:
                STATE.cycle,

            metrics:
                clone(
                    STATE.metrics
                ),

            observations:
                STATE.observations.length,

            opportunities:
                STATE.opportunities.length,

            proposals:
                STATE.proposals.length,

            experiments:
                STATE.experiments.length,

            decisions:
                STATE.decisions.length,

            accepted:
                STATE.accepted.length,

            rejected:
                STATE.rejected.length,

            thresholds: {

                minimum:
                    CONFIG.minimumAcceptanceScore,

                strong:
                    CONFIG.strongAcceptanceScore

            },

            productionSelfRewrite:
                CONFIG.productionSelfRewrite

        };

    }


    /* ----------------------------------------------------------------------
       WORKER INTEGRATION
       ---------------------------------------------------------------------- */

    function registerWorkers() {

        if (!WORKERS) {

            log(
                "Worker swarm not available."
            );

            return;

        }


        try {

            if (
                typeof WORKERS.register ===
                "function"
            ) {


                WORKERS.register({

                    id:
                        "EVOLUTION_OBSERVER",

                    lane:
                        "EVOLUTION",

                    priority:
                        70,

                    handler:
                        async function () {

                            return observe();

                        }

                });


                WORKERS.register({

                    id:
                        "EVOLUTION_ENGINE",

                    lane:
                        "EVOLUTION",

                    priority:
                        60,

                    handler:
                        async function () {

                            return evolve();

                        }

                });


                WORKERS.register({

                    id:
                        "EVOLUTION_STATUS",

                    lane:
                        "SYSTEM",

                    priority:
                        40,

                    handler:
                        async function () {

                            return status();

                        }

                });


                log(
                    "Evolution workers registered."
                );

            }

        } catch (error) {

            STATE.failures++;

            STATE.metrics.failures++;

            console.error(
                "[EVOLUTION WORKER REGISTRATION]",
                error
            );

        }

    }


    /* ----------------------------------------------------------------------
       AUTONOMOUS SCHEDULER
       ---------------------------------------------------------------------- */

    let observationTimer =
        null;

    let evolutionTimer =
        null;


    function startScheduler() {

        if (
            observationTimer ||
            evolutionTimer
        ) {

            return;

        }


        if (
            CONFIG.autonomousObservation
        ) {

            observationTimer =
                setInterval(

                    function () {

                        try {

                            observe();

                        } catch (error) {

                            STATE.failures++;

                            STATE.metrics.failures++;

                            console.error(
                                "[EVOLUTION OBSERVER]",
                                error
                            );

                        }

                    },

                    CONFIG.observationInterval

                );

        }


        if (
            CONFIG.autonomousEvolution
        ) {

            evolutionTimer =
                setInterval(

                    function () {

                        evolve()
                            .catch(

                                function (error) {

                                    STATE.failures++;

                                    STATE.metrics.failures++;

                                    console.error(
                                        "[EVOLUTION CYCLE]",
                                        error
                                    );

                                }

                            );

                    },

                    CONFIG.evolutionInterval

                );

        }


        log(
            "Autonomous evolutionary scheduler online."
        );

    }


    function stopScheduler() {

        if (
            observationTimer
        ) {

            clearInterval(
                observationTimer
            );

            observationTimer =
                null;

        }


        if (
            evolutionTimer
        ) {

            clearInterval(
                evolutionTimer
            );

            evolutionTimer =
                null;

        }


        log(
            "Autonomous evolutionary scheduler stopped."
        );

    }


    /* ----------------------------------------------------------------------
       RESET
       ---------------------------------------------------------------------- */

    function reset() {

        stopScheduler();


        STATE.observations = [];

        STATE.opportunities = [];

        STATE.proposals = [];

        STATE.experiments = [];

        STATE.decisions = [];

        STATE.accepted = [];

        STATE.rejected = [];

        STATE.pending = [];

        STATE.cycle = 0;


        STATE.metrics = {

            observations: 0,

            opportunities: 0,

            proposals: 0,

            experiments: 0,

            accepted: 0,

            rejected: 0,

            reviewed: 0,

            failures: 0,

            cycles: 0

        };


        STATE.timestamps = {

            started: 0,

            lastObservation: 0,

            lastEvolution: 0,

            lastDecision: 0

        };


        log(
            "Evolution transient state reset."
        );


        return status();

    }


    /* ----------------------------------------------------------------------
       PUBLIC API
       ---------------------------------------------------------------------- */

    const API = {

        protocol:
            CONFIG.protocol,

        version:
            CONFIG.version,

        config:
            CONFIG,

        state:
            STATE,

        observe:
            observe,

        detect:
            detectOpportunities,

        propose:
            createProposal,

        sandbox:
            sandbox,

        score:
            score,

        decide:
            decide,

        evolve:
            evolve,

        submit:
            submit,

        status:
            status,

        getProposals:
            function () {

                return clone(
                    STATE.proposals
                );

            },

        getExperiments:
            function () {

                return clone(
                    STATE.experiments
                );

            },

        getDecisions:
            function () {

                return clone(
                    STATE.decisions
                );

            },

        getAccepted:
            function () {

                return clone(
                    STATE.accepted
                );

            },

        getRejected:
            function () {

                return clone(
                    STATE.rejected
                );

            },

        start:
            function () {

                if (
                    STATE.started
                ) {

                    return status();

                }


                STATE.started =
                    true;

                STATE.timestamps.started =
                    timestamp();


                registerWorkers();

                startScheduler();


                emit(
                    "EVOLUTION_ENGINE_STARTED",
                    status()
                );


                log(
                    "Evolution Engine ONLINE."
                );


                return status();

            },

        stop:
            function () {

                stopScheduler();

                STATE.started =
                    false;


                emit(
                    "EVOLUTION_ENGINE_STOPPED",
                    status()
                );


                return status();

            },

        reset:
            reset

    };


    /* ----------------------------------------------------------------------
       GLOBAL EXPOSURE
       ---------------------------------------------------------------------- */

    global.CHIROMBE_EVOLUTION =
        API;

    global.CHIROMBE_EVOLUTION_ENGINE =
        API;


    /* ----------------------------------------------------------------------
       CORE MODULE REGISTRATION
       ---------------------------------------------------------------------- */

    try {

        if (
            CORE.modules &&
            typeof CORE.modules.register ===
            "function"
        ) {

            CORE.modules.register(

                "EVOLUTION_ENGINE",

                API

            );

        }

    } catch (error) {

        console.warn(
            "[EVOLUTION] Core registration unavailable.",
            error
        );

    }


    /* ----------------------------------------------------------------------
       INITIAL SYSTEM MEMORY RECORD
       ---------------------------------------------------------------------- */

    saveMemory(

        "SYSTEM",

        "EVOLUTION_ENGINE",

        {

            protocol:
                CONFIG.protocol,

            module:
                CONFIG.module,

            version:
                CONFIG.version,

            initialized:
                timestamp(),

            productionSelfRewrite:
                CONFIG.productionSelfRewrite,

            minimumAcceptanceScore:
                CONFIG.minimumAcceptanceScore,

            strongAcceptanceScore:
                CONFIG.strongAcceptanceScore

        }

    );


    /* ----------------------------------------------------------------------
       START
       ---------------------------------------------------------------------- */

    API.start();


