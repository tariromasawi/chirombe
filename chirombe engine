    Object.values(state.persons).forEach(person=>{

        graph.nodes[person.id] = {

            id:person.id,

            type:"PERSON",

            confidence:person.confidence,

            protected:person.protected

        };

    });

    Object.values(state.relationships).forEach(rel=>{

        graph.edges[rel.id] = {

            id:rel.id,

            from:rel.from,

            to:rel.to,

            confidence:rel.confidence,

            verified:rel.verified,

            type:rel.type

        };

    });

    state.trustGraph = graph;

    persist("TRUST_GRAPH",graph);

    emit("BLOODLINE_TRUST_GRAPH_UPDATED",graph);

    return clone(graph);

}


