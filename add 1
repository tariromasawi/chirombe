            $("URM_STATUS")
                .textContent =
                R.debug
                    ? "Diagnostics active"
                    : "Operational";

            log(
                R.debug
                    ? "Diagnostics enabled"
                    : "Diagnostics disabled"
            );

        }
    );


$("BTN_EXPORT")
    ?.addEventListener(
        "click",
        exportReport
    );


/* ------------------------------------------------------------------------
   AUTOMATIC BOOT
   ------------------------------------------------------------------------ */

async function boot(){

    $("URM_STATUS")
        .textContent =
        "Scanning";

    log(
        "Universal Recovery Master booting"
    );

    capabilities();

    scan();

    /*
     * Allow application frameworks,
     * dynamically inserted fragments and
     * asynchronous modules to settle.
     */

    await new Promise(
        resolve =>
            setTimeout(
                resolve,
                250
            )
    );

    await reconcile();

    installMutationMonitor();

    /*
     * Second delayed reconciliation.
     */

    setTimeout(
        () => reconcile(),
        1000
    );

    /*
     * Third delayed reconciliation.
     */

    setTimeout(
        () => reconcile(),
        3000
    );

    $("URM_STATUS")
        .textContent =
        "Operational";

    log(
        "Universal Recovery Master ready"
    );

}


/* ------------------------------------------------------------------------
   START
   ------------------------------------------------------------------------ */

if(
    document.readyState ===
    "loading"
){

    document.addEventListener(
        "DOMContentLoaded",
        boot,
        {
            once:true
        }
    );

}else{

    boot();

}


/* ------------------------------------------------------------------------
   PUBLIC API
   ------------------------------------------------------------------------ */

window.UNIVERSAL_RECOVERY_MASTER = {

    state:R,

    scan,

    repair:
        repairLayout,

    reconcile,

    capabilities,

    audit:
        auditInteractions,

    exportReport,

    debug(
