function defensiveMirror(input={}){

  const validation =
    validateEnvelope(input);

  if(
    !validation.ok
  ){

    quarantine(
      input,
      validation.reason
    );

    return {
      ok:false,
      mirrored:false
    };

  }


  const sanitised =
    sanitiseObject(input);

  STATE.mirrorCount++;

  STATE.nodes
    .filter(
      node =>
        node.synthetic ||
        node.known
    )
    .forEach(
      node => {

        node.pulse =
          Math.max(
            node.pulse,
            .35
          );

      }
    );


  logEvent(
    "MIRROR",
    "Untrusted pattern reflected locally and discarded",
    {
      keys:Object.keys(
        sanitised
      )
    }
  );

  toast(
    "Defensive mirror completed locally."
  );

  return {

    ok:true,

    mirrored:true,

    action:
      "LOCAL_CLASSIFY_REFLECT_DISCARD"

  };

}


