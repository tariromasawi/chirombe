        } catch (e) {}

        log(
            "Watchdog online."
        );

        log(
            "Integrity monitoring active."
        );

        log(
            "Recovery intelligence active."
        );

        log(
            "=============================================="
        );

        return API;
    }

    /* ============================================================
       START
       ============================================================ */

    boot().catch(
        function (e) {
            error(
                "BOOT FAILURE:",
                e
            );
