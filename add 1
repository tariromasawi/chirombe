   ============================================================ */

function allowRate(){

  const now = Date.now();

  STATE.rateWindow =
    STATE.rateWindow.filter(
      t =>
        now - t <
        CONFIG.RATE_LIMIT_WINDOW
    );

  if(
    STATE.rateWindow.length >=
    CONFIG.RATE_LIMIT_MAX
  ){

    return false;

  }

  STATE.rateWindow.push(now);

  return true;

}


/* ============================================================
   14 · REPLAY PROTECTION
   ============================================================ */

function checkReplay(nonce){

  if(!nonce){
    return {
      ok:true
    };
  }

  const now = Date.now();

  for(
    const [key,time]
    of STATE.seenNonces
  ){

    if(
      now - time >
      CONFIG.REPLAY_WINDOW
    ){

      STATE.seenNonces.delete(key);

    }

  }

  if(
    STATE.seenNonces.has(nonce)
  ){

    return {
      ok:false,
      reason:"REPLAY_DETECTED"
    };

  }

  STATE.seenNonces.set(
    nonce,
    now
  );

  return {
    ok:true
  };

}


