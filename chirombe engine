            );

        return data;
    }

    /* ============================================================
       COMMAND INTERFACE
       ============================================================ */

    async function command(
        action,
        payload
    ) {

        payload =
            payload || {};

        switch (
            String(action)
                .toUpperCase()
        ) {

            case "STATUS":

                return status();

            case "DISCOVER":

                return discoverArchitecture();

            case "REQUIREMENT":

                return createRequirement(
                    payload
                );

            case "PLAN":

                return createBuildPlan(
                    payload
                );

            case "PLAN_REQUIREMENT":

                return planRequirement(
                    payload.id
                );

            case "PROPOSAL":

                return createCodeProposal(
                    payload
                );

            case "VALIDATE":

                return validateProposal(
                    payload.id
                );

            case "PACKAGE":

                return packageProposal(
                    payload.id
                );

            case "BUILD":

                return buildFromPlan(
                    payload.id
                );

            case "CYCLE":

                return cycle();

            case "VERIFY_PACKAGE":

                return verifyPackage(
                    payload.id
                );

            case "PLANS":

                return listPlans();

            case "PROPOSALS":

                return listProposals();

            case "PACKAGES":

                return listPackages();

            case "EXPORT":

                return exportBuildState();

            case "START":

                start();

                return status();

            case "STOP":

                stop();

                return status();

            default:

                return {

                    success:
                        false,

                    error:
                        "UNKNOWN_BUILD_COMMAND"
                };
        }
    }

