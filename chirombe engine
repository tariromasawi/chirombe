       RECOVERY SCAN
       ============================================================ */

    async function recoveryScan() {
        STATE.lastRecoveryScan =
            now();

        const anomalies =
            detectAnomalies();

        const plans =
            await processAnomalies(
                anomalies
            );

        return {
            timestamp: now(),
            anomalies:
                anomalies,
            plans:
                plans
        };
    }

