function drawCelestial(time){

  const canvas =
    DOM.celestialCanvas;

  const ctx =
    canvas.getContext("2d");

  if(!ctx)return;

  const ratio =
    STATE.devicePixelRatio;

  const w =
    canvas.width / ratio;

  const h =
    canvas.height / ratio;

  ctx.setTransform(
    ratio,
    0,
    0,
    ratio,
    0,
    0
  );

  ctx.clearRect(
    0,
    0,
    w,
    h
  );

  const cx =
    w/2;

  const cy =
    h/2;

  /* central celestial field */

  const radius =
    Math.max(w,h)*.48;

  const gradient =
    ctx.createRadialGradient(
      cx,
      cy,
      0,
      cx,
      cy,
      radius
    );

  gradient.addColorStop(
    0,
    "rgba(90,130,255,.10)"
  );

  gradient.addColorStop(
    .35,
    "rgba(70,80,220,.055)"
  );

  gradient.addColorStop(
    1,
    "rgba(0,0,0,0)"
  );

  ctx.fillStyle =
    gradient;

  ctx.fillRect(
    0,
    0,
    w,
    h
  );


  /* stars */

  for(
    const star
    of STATE.stars
  ){

    const twinkle =
      .5 +
      .5 *
      Math.sin(
        time * star.speed +
        star.phase
      );

    ctx.globalAlpha =
      star.alpha *
      (.55 + twinkle*.45);

    ctx.beginPath();

    ctx.arc(
      star.x*w,
      star.y*h,
      star.radius,
      0,
      Math.PI*2
    );

    ctx.fillStyle =
      "rgba(190,220,255,1)";

    ctx.fill();

  }

  ctx.globalAlpha = 1;


  /* orbital rings */

  ctx.save();

  ctx.translate(
    cx,
    cy
  );

  ctx.rotate(
    time*.000025
  );

  for(
    let i=0;
    i<5;
    i++
  ){

    const r =
      Math.min(w,h) *
      (.15 + i*.095);

    ctx.beginPath();

    ctx.ellipse(
      0,
      0,
      r,
      r*.38,
      i*.2,
      0,
      Math.PI*2
    );

    ctx.strokeStyle =
      `rgba(
        ${70+i*15},
        ${120+i*10},
        255,
        ${.035+i*.008}
      )`;

    ctx.lineWidth = 1;

    ctx.stroke();

  }

  ctx.restore();


  /* pulses */

  for(
    let i=
      STATE.pulses.length-1;
    i>=0;
    i--
  ){

    const pulse =
      STATE.pulses[i];

    pulse.radius +=
      pulse.speed;

    pulse.alpha -=
      .006;

    ctx.beginPath();

    ctx.arc(
      pulse.x,
      pulse.y,
      pulse.radius,
      0,
      Math.PI*2
    );

    ctx.strokeStyle =
      `rgba(
        ${pulse.r},
        ${pulse.g},
        ${pulse.b},
        ${Math.max(
          0,
          pulse.alpha
        )}
      )`;

    ctx.lineWidth =
      pulse.width;

    ctx.stroke();

    if(
      pulse.alpha <= 0
    ){

      STATE.pulses.splice(
        i,
        1
      );

    }

  }

}


