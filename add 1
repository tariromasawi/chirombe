/* ============================================================
   28 · NETWORK DRAWING
   ============================================================ */

function drawNetwork(time){

  const canvas =
    DOM.networkCanvas;

  const ctx =
    canvas.getContext("2d");

  if(!ctx)return;

  const ratio =
    STATE.devicePixelRatio;

  const w =
    canvas.width / ratio;

  const h =
    canvas.height / ratio;

  ctx.setTransform(
    ratio,
    0,
    0,
    ratio,
    0,
    0
  );

  ctx.clearRect(
    0,
    0,
    w,
    h
  );


  /* subtle radial background */

  const bg =
    ctx.createRadialGradient(
      w/2,
      h/2,
      0,
      w/2,
      h/2,
      Math.max(w,h)*.65
    );

  bg.addColorStop(
    0,
    "rgba(50,70,150,.09)"
  );

  bg.addColorStop(
    1,
    "rgba(0,0,0,0)"
  );

  ctx.fillStyle = bg;

  ctx.fillRect(
    0,
    0,
    w,
    h
  );


  /* central boundary */

  ctx.beginPath();

  ctx.arc(
    w/2,
    h/2,
    Math.min(w,h)*.41,
    0,
    Math.PI*2
  );

  ctx.strokeStyle =
    "rgba(93,232,255,.10)";

  ctx.lineWidth = 1;

  ctx.stroke();


  /* edges */

  for(
    const edge
    of STATE.edges
  ){

    const a =
      edge.a;

    const b =
      edge.b;

    const active =
      a.pulse > .1 ||
      b.pulse > .1;

    ctx.beginPath();

    ctx.moveTo(
      a.x,
      a.y
    );

    ctx.lineTo(
      b.x,
      b.y
    );

    ctx.strokeStyle =
      active
        ? "rgba(93,232,255,.22)"
        : "rgba(120,150,210,.055)";

    ctx.lineWidth =
      active ? 1.25 : .45;

    ctx.stroke();

  }


  /* nodes */

  for(
    const node
    of STATE.nodes
  ){

    const isKnown =
      node.known === true;

    const isCanary =
      node.canary === true;

    const isQuarantine =
      node.status === "QUARANTINED";

    const base =
      isQuarantine
        ? [255,100,124]
        :
      isCanary
        ? [255,216,107]
        :
      isKnown
        ? [93,232,255]
        :
          [183,124,255];

    const pulse =
      node.pulse;

    const r =
      node.radius +
      pulse * 8;

    /* glow */

    if(
      pulse > .02 ||
      node === STATE.selectedNode
    ){

      const glow =
        ctx.createRadialGradient(
          node.x,
          node.y,
          0,
          node.x,
          node.y,
          r*4
        );

      glow.addColorStop(
        0,
        `rgba(
          ${base[0]},
          ${base[1]},
          ${base[2]},
          .25
        )`
      );

      glow.addColorStop(
        1,
        `rgba(
          ${base[0]},
          ${base[1]},
          ${base[2]},
          0
        )`
      );

      ctx.fillStyle =
        glow;

      ctx.beginPath();

      ctx.arc(
        node.x,
        node.y,
        r*4,
        0,
        Math.PI*2
      );

      ctx.fill();

    }


    ctx.beginPath();

    ctx.arc(
      node.x,
      node.y,
      Math.max(1.5,r),
      0,
      Math.PI*2
    );

    ctx.fillStyle =
      `rgb(
        ${base[0]},
        ${base[1]},
        ${base[2]}
      )`;

    ctx.fill();


    ctx.beginPath();

    ctx.arc(
      node.x,
      node.y,
      Math.max(2,r+.8),
      0,
      Math.PI*2
    );

    ctx.strokeStyle =
      `rgba(
        ${base[0]},
        ${base[1]},
        ${base[2]},
        .35
      )`;

    ctx.stroke();

  }


  /* mouse attraction/selection ring */

  if(
    STATE.mouse.active
  ){

    ctx.beginPath();

    ctx.arc(
      STATE.mouse.x,
      STATE.mouse.y,
      14,
      0,
      Math.PI*2
    );

    ctx.strokeStyle =
      "rgba(93,232,255,.32)";

    ctx.stroke();

  }

}


/* ============================================================
   29 · NODE PHYSICS
   ============================================================ */

function updateNodes(delta){

  if(
    STATE.paused
  ){

    return;

  }

  const width =
    DOM.networkCanvas.clientWidth;

  const height =
    DOM.networkCanvas.clientHeight;

  const cx =
    width/2;

  const cy =
    height/2;

  const dt =
    Math.min(
      delta/16.67,
      2
    );


  for(
    const node
    of STATE.nodes
  ){

    const angle =
      Math.atan2(
        node.y-cy,
        node.x-cx
      );

    const dx =
      node.x-cx;

    const dy =
      node.y-cy;

    const distance =
      Math.max(
        40,
        Math.sqrt(
          dx*dx + dy*dy
        )
      );

    const targetRadius =
      Math.min(
        width,
        height
      ) *
      (
        .17 +
        (
          parseInt(
            node.id.slice(1)
          ) % 5
        )*.075
      );

    const radialError =
      distance -
      targetRadius;

    const force =
      radialError *
      .0006;

    node.vx -=
      Math.cos(angle) *
      force *
      dt;

    node.vy -=
      Math.sin(angle) *
      force *
      dt;


    /* very small deterministic drift */

    node.vx +=
      Math.sin(
        STATE.frame*.002 +
        node.phase
      ) *
      .002;

    node.vy +=
      Math.cos(
        STATE.frame*.0015 +
        node.phase
      ) *
      .002;


    node.vx *= .992;
    node.vy *= .992;

    node.x +=
      node.vx * dt;

    node.y +=
      node.vy * dt;


    const margin = 20;

    if(
      node.x < margin
    ){

      node.x = margin;
      node.vx *= -.5;

    }

    if(
      node.x >
      width-margin
    ){

      node.x =
        width-margin;

      node.vx *= -.5;

    }

    if(
      node.y < margin
    ){

      node.y = margin;
      node.vy *= -.5;

    }

    if(
      node.y >
      height-margin
    ){

      node.y =
        height-margin;

      node.vy *= -.5;

    }


    /* energy drift */

    node.energy +=
      (
        Math.random()-.5
      )*.008;

    node.energy =
      clamp(
        node.energy,
        0,
        1
      );


    /* pulse decay */

    node.pulse *= .94;

  }

}


/* ============================================================
   30 · CLAMP
   ============================================================ */

function clamp(value,min,max){

  return Math.max(
    min,
    Math.min(max,value)
  );

}


/* ============================================================
   31 · COHERENCE SIMULATION
   ============================================================ */

function updateCoherence(){

  if(
    !STATE.nodes.length
  ){

    STATE.coherence = 0;

    return;

  }

  const total =
    STATE.nodes.reduce(
      (sum,node) =>
        sum +
        node.energy,
      0
    );

  let value =
    total /
    STATE.nodes.length;

  /* deterministic small movement */

  value +=
    Math.sin(
      STATE.frame*.008
    )*.04;

  STATE.coherence =
    clamp(
      value,
      0,
      1
    );

  DOM.coherenceValue.textContent =
    Math.round(
      STATE.coherence*100
    ) + "%";

  DOM.coherenceMeter.style.width =
    Math.round(
