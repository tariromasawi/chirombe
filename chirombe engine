                ).toUpperCase(),

            status: "PENDING",

            progress: 0,

            confidence:
                clamp(
                    input.confidence == null
                        ? 0.80
                        : input.confidence,
                    0,
                    1
                ),

            retries: 0,

            maxRetries:
                input.maxRetries == null
                    ? CONFIG.maxRetries
                    : Math.max(
                        0,
                        Number(input.maxRetries)
                    ),

            dependencies:
                Array.isArray(input.dependencies)
                    ? clone(input.dependencies)
                    : [],

            worker:
                input.worker || null,

            route:
                input.route || null,

            payload:
                clone(input.payload || {}),

            result: null,

            error: null,

            createdAt: now(),

            updatedAt: now(),

            startedAt: null,

            completedAt: null
        };

        STATE.tasks[id] = task;

        STATE.metrics.tasksCreated++;

        if (task.objectiveId) {

            const objective =
                STATE.objectives[
                    task.objectiveId
                ];

            if (objective) {

                objective.tasks.push(id);

                addObjectiveHistory(
                    objective,
                    "TASK_CREATED",
                    {
                        taskId: id
                    }
                );
            }
        }

        emit(
            "ORCHESTRATOR_TASK_CREATED",
            task
        );

        rememberRecord(
            "TASK_CREATED",
            task
        );

        trimState();

        return clone(task);
    }

    function getTask(id) {

        return STATE.tasks[id]
            ? clone(STATE.tasks[id])
            : null;
    }

    function tasks() {

        return Object.values(
            STATE.tasks
        ).map(clone);
    }

    /* -------------------------------------------------------------
       PRIORITY ENGINE
       ------------------------------------------------------------- */

    function priorityWeight(priority) {

        const map = {
            CRITICAL: 1.00,
            URGENT: 0.95,
            HIGH: 0.80,
            NORMAL: 0.55,
            LOW: 0.30,
            BACKGROUND: 0.10
        };

        return map[
            String(priority || "NORMAL")
                .toUpperCase()
        ] || 0.55;
    }

    function calculateTaskScore(task) {

        if (!task) {
            return 0;
        }

        const priority =
            priorityWeight(task.priority);

        const confidence =
            clamp(task.confidence, 0, 1);

        const dependencyBonus =
            dependenciesSatisfied(task)
                ? 0.10
                : 0;

        const retryPenalty =
            Math.min(
                0.30,
                Number(task.retries || 0) * 0.08
            );

        return clamp(
            priority * 0.55 +
            confidence * 0.35 +
            dependencyBonus -
            retryPenalty,
            0,
            1
        );
    }

    /* -------------------------------------------------------------
       DEPENDENCY ENGINE
       ------------------------------------------------------------- */

    function dependenciesSatisfied(task) {

        if (
            !task ||
            !Array.isArray(task.dependencies) ||
            task.dependencies.length === 0
        ) {
            return true;
        }

        return task.dependencies.every(
            dependencyId => {

                const dependency =
                    STATE.tasks[dependencyId];

                return (
                    dependency &&
                    dependency.status ===
                    "COMPLETE"
                );
            }
        );
    }

    function dependencyBlocked(task) {

        if (!task) {
            return false;
        }

        if (!Array.isArray(task.dependencies)) {
            return false;
        }

        return task.dependencies.some(
            dependencyId => {

                const dependency =
                    STATE.tasks[dependencyId];

                return (
                    !dependency ||
                    dependency.status !==
                    "COMPLETE"
                );
            }
        );
    }

    /* -------------------------------------------------------------
       ROUTING ENGINE
       ------------------------------------------------------------- */

    function determineRoute(task) {

        if (!task) {
            return {
                engine: "NONE",
                worker: null
            };
        }

        const category =
            String(
                task.category ||
                task.type ||
                "GENERAL"
            ).toUpperCase();

        let engine = "WORKERS";
        let worker = null;

        switch (category) {

            case "ANALYSE":
            case "ANALYSIS":
                engine = "KNOWLEDGE";
                worker = "KNOWLEDGE_ANALYST";
                break;

            case "MEMORY":
            case "PERSISTENCE":
                engine = "MEMORY";
                worker = "MEMORY_SEARCH";
                break;

            case "EVOLVE":
            case "EVOLUTION":
                engine = "EVOLUTION";
                worker = "EVOLUTION_ENGINE";
                break;

            case "MAP":
            case "PATHWAY":
            case "PATHWAYS":
                engine = "PATHWAYS";
                worker = "PATHWAY_ANALYST";
                break;

            case "RECOVER":
            case "RECOVERY":
            case "INTEGRITY":
                engine = "WATCHDOG";
                worker = "WATCHDOG_RECOVERY";
                break;

            case "BUILD":
            case "CODE":
                engine = "BUILD";
                worker = "BUILD_PLANNER";
                break;

            case "VALIDATE":
            case "TEST":
                engine = "BUILD";
                worker = "BUILD_VALIDATOR";
                break;

            case "EXTERNAL_AI":
            case "GROK":
            case "AI":
                engine = "EXTERNAL_AI";
                worker = "GROK_BRIDGE";
                break;

            case "GENERAL":
            default:
                engine = "WORKERS";
                worker = null;
                break;
        }

        return {
            engine,
            worker
        };
    }

    function routeTask(taskId) {

        const task =
            STATE.tasks[taskId];

        if (!task) {
            return null;
        }

        const route =
            determineRoute(task);

        const routeId =
            uid("ROUTE");

        const record = {

            id: routeId,

            taskId,

            engine: route.engine,

            worker: route.worker,

            confidence:
                task.confidence,

            createdAt: now(),

            status: "READY",

            score:
                calculateTaskScore(task)
        };

        STATE.routes[routeId] = record;

        task.route = routeId;

        task.worker =
            route.worker;

        task.status =
            "READY";

        task.updatedAt = now();

        STATE.metrics.routesCreated++;

        emit(
            "ORCHESTRATOR_TASK_ROUTED",
            record
        );

        rememberRecord(
            "TASK_ROUTED",
            record
        );

        return clone(record);
    }

    /* -------------------------------------------------------------
       HEALTH GATE
       ------------------------------------------------------------- */

    function healthCheck() {

        const report = {
            timestamp: now(),
            healthy: true,
            modules: {},
            warnings: [],
            failures: []
        };

        const modules = {

            CORE,

            MEMORY,

            WORKERS,

            EVOLUTION,

            PATHWAYS,

            WATCHDOG,

            KNOWLEDGE,

            BUILD
        };

        Object.keys(modules).forEach(
            name => {

                const module =
                    modules[name];

                const available =
                    !!module;

                report.modules[name] = {
                    available
                };

                if (!available) {

                    report.warnings.push(
                        name +
                        "_UNAVAILABLE"
                    );
                }
            }
        );

        if (
            report.modules.CORE &&
            !report.modules.WORKERS
        ) {

            report.healthy = false;

            report.failures.push(
                "WORKER_LAYER_UNAVAILABLE"
            );
        }

        if (
            report.failures.length
        ) {
            report.healthy = false;
        }

        return report;
    }

    /* -------------------------------------------------------------
       EXECUTION ADAPTERS
       ------------------------------------------------------------- */

    async function executeViaEngine(
        task
    ) {

        const category =
            String(
                task.category ||
                task.type ||
                "GENERAL"
            ).toUpperCase();

        const payload =
            clone(task.payload || {});

        /* BUILD */

        if (
            category === "BUILD" ||
            category === "CODE"
        ) {

            if (
                BUILD &&
                typeof BUILD.cycle ===
                "function"
            ) {

                return await BUILD.cycle(
                    payload
                );
            }

            if (
                BUILD &&
                typeof BUILD.status ===
                "function"
            ) {

                return BUILD.status();
            }
        }

        /* EVOLUTION */

        if (
            category === "EVOLVE" ||
            category === "EVOLUTION"
        ) {

            if (
                EVOLUTION &&
                typeof EVOLUTION.cycle ===
                "function"
            ) {

                return await EVOLUTION.cycle(
                    payload
                );
            }

            if (
                EVOLUTION &&
                typeof EVOLUTION.status ===
                "function"
            ) {

                return EVOLUTION.status();
            }
        }

        /* PATHWAYS */

        if (
            category === "MAP" ||
            category === "PATHWAY" ||
            category === "PATHWAYS"
        ) {

            if (
                PATHWAYS &&
                typeof PATHWAYS.analyse ===
                "function"
            ) {

                return await PATHWAYS.analyse();
            }

            if (
                PATHWAYS &&
                typeof PATHWAYS.status ===
                "function"
            ) {

                return PATHWAYS.status();
            }
        }

        /* RECOVERY */

        if (
            category === "RECOVER" ||
            category === "RECOVERY" ||
            category === "INTEGRITY"
        ) {

            if (
                WATCHDOG &&
                typeof WATCHDOG.scan ===
                "function"
            ) {

                return await WATCHDOG.scan();
            }

            if (
                WATCHDOG &&
                typeof WATCHDOG.status ===
                "function"
            ) {

                return WATCHDOG.status();
            }
        }

        /* KNOWLEDGE */

        if (
            category === "ANALYSE" ||
            category === "ANALYSIS"
        ) {

            if (
                KNOWLEDGE &&
                typeof KNOWLEDGE.search ===
                "function"
            ) {

                return await KNOWLEDGE.search(
                    payload.query ||
                    task.description ||
                    task.title
                );
            }

            if (
                KNOWLEDGE &&
                typeof KNOWLEDGE.status ===
                "function"
            ) {

                return KNOWLEDGE.status();
            }
        }

        /* MEMORY */

        if (
            category === "MEMORY" ||
            category === "PERSISTENCE"
        ) {

            if (
                MEMORY &&
                typeof MEMORY.search ===
                "function"
            ) {

                return await MEMORY.search(
                    payload.query ||
                    task.description ||
                    task.title
                );
            }
        }

        /* GENERAL WORKER */

        if (
            WORKERS &&
            typeof WORKERS.dispatch ===
            "function"
        ) {

            try {

                return await WORKERS.dispatch(
                    task.worker,
                    payload
                );

            } catch (error) {}
        }

        return {
            status: "NO_ENGINE_ACTION",
            taskId: task.id,
            category
        };
    }

    /* -------------------------------------------------------------
       TASK EXECUTION
       ------------------------------------------------------------- */

    async function executeTask(taskId) {

        const task =
            STATE.tasks[taskId];

        if (!task) {
            return null;
        }

        if (
            task.status === "COMPLETE"
        ) {
            return clone(task);
        }

        if (
            task.status === "RUNNING"
        ) {
            return clone(task);
        }

        if (
            dependencyBlocked(task)
        ) {

            task.status = "WAITING";

            task.updatedAt = now();

            return clone(task);
        }

        if (
            CONFIG.requireHealthCheck
        ) {

            const health =
                healthCheck();

            if (!health.healthy) {

                task.status =
                    "WAITING";

                task.error =
                    "SYSTEM_HEALTH_GATE_FAILED";

                task.updatedAt = now();

                emit(
                    "ORCHESTRATOR_HEALTH_GATE",
                    {
                        taskId,
                        health
                    }
                );

                return clone(task);
            }
        }

        if (
            task.confidence <
            CONFIG.confidenceThreshold
        ) {

            task.status =
                "WAITING";

            task.error =
                "CONFIDENCE_GATE_FAILED";

            task.updatedAt = now();

            return clone(task);
        }

        task.status =
            "RUNNING";

        task.startedAt =
            now();

        task.updatedAt =
            now();

        const executionId =
            uid("EXEC");

        const execution = {

            id: executionId,

            taskId,

            startedAt: now(),

            status: "RUNNING",

            result: null,

            error: null
        };

        STATE.executions[
            executionId
        ] = execution;

        STATE.metrics.executions++;

        emit(
            "ORCHESTRATOR_TASK_STARTED",
            {
                executionId,
                taskId
            }
        );

        try {

            const result =
                await executeViaEngine(
                    task
                );

            execution.status =
                "COMPLETE";

            execution.result =
                clone(result);

            execution.completedAt =
                now();

            task.result =
                clone(result);

            task.status =
                "COMPLETE";

            task.progress = 1;

            task.completedAt =
                now();

            task.updatedAt =
                now();

            STATE.metrics.successfulExecutions++;

            STATE.metrics.tasksCompleted++;

            if (
                task.objectiveId
            ) {

                updateObjectiveProgress(
                    task.objectiveId
                );
            }

            emit(
                "ORCHESTRATOR_TASK_COMPLETE",
                {
                    executionId,
                    taskId,
                    result
                }
            );

            await rememberRecord(
                "TASK_COMPLETE",
                {
                    executionId,
                    taskId,
                    result
                }
            );

        } catch (error) {

            execution.status =
                "FAILED";

            execution.error =
                error.message ||
                String(error);

            execution.completedAt =
                now();

            task.error =
                execution.error;

            task.retries =
                Number(task.retries || 0) + 1;

            STATE.metrics.failedExecutions++;

            STATE.metrics.tasksFailed++;

            STATE.metrics.retries++;

            if (
                task.retries <=
                task.maxRetries
            ) {

                task.status =
                    "PENDING";

            } else {

                task.status =
                    "FAILED";

                if (
                    task.objectiveId
                ) {

                    const objective =
                        STATE.objectives[
                            task.objectiveId
                        ];

                    if (objective) {

                        objective.failedTasks
                            .push(task.id);

                        addObjectiveHistory(
                            objective,
                            "TASK_FAILED",
                            {
                                taskId:
                                    task.id,
                                error:
                                    task.error
                            }
                        );
                    }
                }
            }

            task.updatedAt =
                now();

            emit(
                "ORCHESTRATOR_TASK_FAILED",
                {
                    executionId,
                    taskId,
                    error:
                        execution.error
                }
            );

            await rememberRecord(
                "TASK_FAILURE",
                {
                    executionId,
                    taskId,
                    error:
                        execution.error
                }
            );
        }

        return clone(task);
    }

    /* -------------------------------------------------------------
       OBJECTIVE PROGRESS
       ------------------------------------------------------------- */

    function updateObjectiveProgress(
        objectiveId
    ) {

        const objective =
            STATE.objectives[
                objectiveId
            ];

        if (!objective) {
            return null;
        }

        const taskIds =
            objective.tasks || [];

        if (!taskIds.length) {

            objective.progress = 1;

            objective.status =
                "COMPLETE";

            return clone(objective);
        }

        const linkedTasks =
            taskIds
                .map(id => STATE.tasks[id])
                .filter(Boolean);

        const completed =
            linkedTasks.filter(
                task =>
                    task.status ===
                    "COMPLETE"
            );

        const failed =
            linkedTasks.filter(
                task =>
                    task.status ===
                    "FAILED"
            );

        objective.progress =
            completed.length /
            linkedTasks.length;

        objective.completedTasks =
            completed.map(
                task => task.id
            );

        objective.failedTasks =
            failed.map(
                task => task.id
            );

        if (
            objective.progress >= 1
        ) {

            objective.status =
                "COMPLETE";

            STATE.metrics.objectivesCompleted++;

            addObjectiveHistory(
                objective,
                "COMPLETED",
                {}
            );

            emit(
                "ORCHESTRATOR_OBJECTIVE_COMPLETE",
                objective
            );

        } else if (
            failed.length ===
            linkedTasks.length
        ) {

            objective.status =
                "FAILED";

            STATE.metrics.objectivesFailed++;

            addObjectiveHistory(
                objective,
                "FAILED",
                {}
            );

        } else {

            objective.status =
                "RUNNING";
        }

        objective.updatedAt =
            now();

        return clone(objective);
    }

    /* -------------------------------------------------------------
       OBJECTIVE DECOMPOSITION
       ------------------------------------------------------------- */

    function decomposeObjective(
        objectiveId
    ) {

        const objective =
            STATE.objectives[
                objectiveId
            ];

        if (!objective) {
            return [];
        }

        if (
            objective.tasks &&
            objective.tasks.length
        ) {

            return objective.tasks
                .map(
                    id =>
                        STATE.tasks[id]
                )
                .filter(Boolean)
                .map(clone);
        }

        const category =
            String(
                objective.category ||
                "GENERAL"
            ).toUpperCase();

        const tasks = [];

        /* ANALYSIS OBJECTIVE */

        if (
            category === "ANALYSE" ||
            category === "ANALYSIS"
        ) {

            tasks.push(
                createTask({
                    objectiveId,
                    title:
                        "Analyse knowledge and system state",
                    description:
                        objective.description,
                    category:
                        "ANALYSE",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence
                })
            );
        }

        /* EVOLUTION OBJECTIVE */

        if (
            category === "EVOLVE" ||
            category === "EVOLUTION"
        ) {

            tasks.push(
                createTask({
                    objectiveId,
                    title:
                        "Generate controlled evolution opportunities",
                    description:
                        objective.description,
                    category:
                        "EVOLUTION",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence
                })
            );
        }

        /* PATHWAY OBJECTIVE */

        if (
            category === "MAP" ||
            category === "PATHWAY"
        ) {

            tasks.push(
                createTask({
                    objectiveId,
                    title:
                        "Map system pathways",
                    description:
                        objective.description,
                    category:
                        "PATHWAY",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence
                })
            );
        }

        /* BUILD OBJECTIVE */

        if (
            category === "BUILD" ||
            category === "CODE"
        ) {

            const analysisTask =
                createTask({
                    objectiveId,
                    title:
                        "Analyse build requirement",
                    description:
                        objective.description,
                    category:
                        "ANALYSE",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence
                });

            const buildTask =
                createTask({
                    objectiveId,
                    title:
                        "Generate controlled build proposal",
                    description:
                        objective.description,
                    category:
                        "BUILD",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence,
                    dependencies: [
                        analysisTask.id
                    ]
                });

            tasks.push(
                analysisTask,
                buildTask
            );
        }

        /* RECOVERY OBJECTIVE */

        if (
            category === "RECOVER" ||
            category === "RECOVERY"
        ) {

            tasks.push(
                createTask({
                    objectiveId,
                    title:
                        "Inspect system integrity and recovery state",
                    description:
                        objective.description,
                    category:
                        "RECOVERY",
                    priority:
                        "CRITICAL",
                    confidence:
                        objective.confidence
                })
            );
        }

        /* EXTERNAL AI OBJECTIVE */

        if (
            category === "AI" ||
            category === "GROK" ||
            category === "EXTERNAL_AI"
        ) {

            tasks.push(
                createTask({
                    objectiveId,
                    title:
                        "Prepare external AI handoff",
                    description:
                        objective.description,
                    category:
                        "EXTERNAL_AI",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence
                })
            );
        }

        /* GENERAL FALLBACK */

        if (!tasks.length) {

            tasks.push(
                createTask({
                    objectiveId,
                    title:
                        objective.title,
                    description:
                        objective.description,
                    category:
                        "GENERAL",
                    priority:
                        objective.priority,
                    confidence:
                        objective.confidence
                })
            );
        }

        objective.status =
            "PLANNING";

        addObjectiveHistory(
            objective,
            "DECOMPOSED",
            {
                taskCount:
                    tasks.length
            }
        );

        return tasks.map(clone);
    }

    /* -------------------------------------------------------------
       TASK PREPARATION
       ------------------------------------------------------------- */

    function prepareTask(taskId) {

        const task =
            STATE.tasks[taskId];

        if (!task) {
            return null;
        }

        if (
            dependencyBlocked(task)
        ) {

            task.status =
                "WAITING";

            return clone(task);
        }

        if (!task.route) {

            routeTask(taskId);
        }

        return clone(
            STATE.tasks[taskId]
        );
    }

    /* -------------------------------------------------------------
       TASK SELECTION
       ------------------------------------------------------------- */

    function nextTask() {

        const candidates =
            Object.values(
                STATE.tasks
            )
            .filter(
                task =>
                    task.status ===
                        "PENDING" ||
                    task.status ===
                        "READY"
            )
            .filter(
                task =>
                    !dependencyBlocked(task)
            )
            .map(
                task => ({
                    task,
                    score:
                        calculateTaskScore(
                            task
                        )
                })
            )
            .sort(
                (a, b) =>
                    b.score -
                    a.score
            );

        return candidates.length
            ? candidates[0].task
            : null;
    }

    /* -------------------------------------------------------------
       MAIN ORCHESTRATION CYCLE
       ------------------------------------------------------------- */

    async function cycle() {

        if (
            !STATE.running ||
            STATE.paused
        ) {
            return status();
        }

        STATE.cycle++;

        STATE.lastCycle =
            now();

        emit(
            "ORCHESTRATOR_CYCLE_START",
            {
                cycle:
                    STATE.cycle
            }
        );

        const health =
            healthCheck();

        if (
            CONFIG.requireHealthCheck &&
            !health.healthy
        ) {

            STATE.incidents.push({
                id:
                    uid("INCIDENT"),
                timestamp:
                    now(),
                type:
                    "HEALTH_GATE_FAILURE",
                health:
                    clone(health)
            });

            STATE.metrics.recoveryEvents++;

            emit(
                "ORCHESTRATOR_HEALTH_FAILURE",
                health
            );

            return status();
        }

        /* ---------------------------------------------------------
           OBJECTIVE PLANNING
           --------------------------------------------------------- */

        if (
            CONFIG.automaticPlanning
        ) {

            Object.values(
                STATE.objectives
            )
            .filter(
                objective =>
                    objective.status ===
                    "PENDING"
            )
            .forEach(
                objective => {

                    decomposeObjective(
                        objective.id
                    );
                }
            );
        }

        /* ---------------------------------------------------------
           ROUTING
           --------------------------------------------------------- */

        if (
            CONFIG.automaticRouting
        ) {

            Object.values(
                STATE.tasks
            )
            .filter(
                task =>
                    task.status ===
                        "PENDING" ||
                    task.status ===
                        "READY"
            )
            .forEach(
                task => {

                    if (
                        !task.route &&
                        !dependencyBlocked(task)
                    ) {

                        routeTask(task.id);
                    }
                }
            );
        }

        /* ---------------------------------------------------------
           EXECUTION
           --------------------------------------------------------- */

        if (
            CONFIG.automaticExecution
        ) {

            const task =
                nextTask();

            if (task) {

                prepareTask(
                    task.id
                );

                await executeTask(
                    task.id
                );
            }
        }

        /* ---------------------------------------------------------
           OBJECTIVE RECALCULATION
           --------------------------------------------------------- */

        Object.values(
            STATE.objectives
        ).forEach(
            objective => {

                if (
                    objective.tasks &&
                    objective.tasks.length
                ) {

                    updateObjectiveProgress(
                        objective.id
                    );
                }
            }
        );

        emit(
            "ORCHESTRATOR_CYCLE_COMPLETE",
            {
                cycle:
                    STATE.cycle,
                health
            }
        );

        await rememberRecord(
            "ORCHESTRATION_CYCLE",
            {
                cycle:
                    STATE.cycle,
                health,
                metrics:
                    clone(STATE.metrics)
            }
        );

        return status();
    }

    /* -------------------------------------------------------------
       WORKFLOW ENGINE
       ------------------------------------------------------------- */

    function defineWorkflow(
        name,
        steps
    ) {

        const id =
            uid("WORKFLOW");

        STATE.workflows[id] = {

            id,

            name:
                normalizeText(name),

            steps:
                Array.isArray(steps)
                    ? clone(steps)
