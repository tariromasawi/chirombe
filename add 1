function drawEarth(t){

  const cx =
    W/2;

  const cy =
    H/2 +
    Math.min(W,H)*.25;

  const r =
    Math.min(W,H)*.055;

  const grad =
    F.createRadialGradient(
      cx-r*.35,
      cy-r*.4,
      r*.1,
      cx,
      cy,
      r
    );

  grad.addColorStop(
    0,
    "#b9f8ff"
  );

  grad.addColorStop(
    .3,
    "#147bd4"
  );

  grad.addColorStop(
    .7,
    "#06336d"
  );

  grad.addColorStop(
    1,
    "#01030c"
  );

  F.beginPath();

  F.arc(
    cx,
    cy,
    r,
    0,
    Math.PI*2
  );

  F.fillStyle =
    grad;

  F.fill();

  F.strokeStyle =
    "rgba(120,220,255,.8)";

  F.stroke();

  for(
    let i=0;
    i<3;
    i++
  ){

    F.beginPath();

    F.ellipse(
      cx,
      cy,
      r*(1.45+i*.35),
      r*(.38+i*.12),
      t*.0004+i*.4,
      0,
      Math.PI*2
    );

    F.strokeStyle =
      `rgba(255,214,107,${.3-i*.06})`;

    F.stroke();

  }

}


/* ============================================================
   DNA / LINEAGE HELIX
   ============================================================ */

function drawDNA(t){

  const x0 =
    W/2;

  const y0 =
    H*.68;

  const height =
    Math.min(W,H)*.24;

  const width =
    Math.min(W,H)*.06;

  F.save();

  F.lineWidth = 1.3;

  for(
    let side=0;
    side<2;
    side++
  ){

    F.beginPath();

    for(
      let y=0;
      y<height;
      y+=3
    ){

      const phase =
        y*.045 +
        t*.002;

      const x =
        x0 +
        (side===0 ? -1 : 1) *
        Math.sin(phase) *
        width;

      if(y===0)
        F.moveTo(
          x,
          y0+y
        );
      else
        F.lineTo(
          x,
          y0+y
        );

    }

    F.strokeStyle =
      side===0
        ? "rgba(90,220,255,.72)"
        : "rgba(255,214,107,.72)";

    F.stroke();

  }

  for(
    let y=0;
    y<height;
    y+=13
  ){

    const phase =
      y*.045 +
      t*.002;

    const x1 =
      x0 -
      Math.sin(phase)*width;

    const x2 =
      x0 +
      Math.sin(phase)*width;

    F.beginPath();

    F.moveTo(
      x1,
      y0+y
    );

    F.lineTo(
      x2,
      y0+y
    );

    F.strokeStyle =
      "rgba(255,255,255,.4)";

    F.stroke();

  }

  F.restore();

}


/* ============================================================
   AUDIO VISUALISER
   ============================================================ */

function drawAudio(){

  if(
    !analyser ||
    !frequencyData
  ){

    return;
  }

  analyser.getByteFrequencyData(
    frequencyData
  );

  const bands = [
    [0,.08],
    [.08,.18],
    [.18,.35],
    [.35,.62],
    [.62,.95]
  ];

  bands.forEach(
    (band,i)=>{

      const start =
        Math.floor(
          frequencyData.length *
          band[0]
        );

      const end =
        Math.floor(
          frequencyData.length *
          band[1]
        );

      let sum=0;

      for(
        let j=start;
        j<end;
        j++
      ){

        sum +=
          frequencyData[j];

      }

      const value =
        sum /
        Math.max(
          1,
          end-start
        );

      const meter =
        document.getElementById(
          "m"+(i+1)
        );

      if(meter){

        meter.style.width =
          Math.max(
            3,
            Math.min(
              100,
              value*1.25
            )
          )+"%";

      }

    }
  );

}


/* ============================================================
   PARTICLE FX
   ============================================================ */

function drawFX(t){

  F.clearRect(
    0,
    0,
    W,
    H
  );

  const cx =
    W/2;

  const cy =
    H/2;

  const base =
    Math.min(W,H);

  let audioEnergy =
    0;

  if(
    frequencyData
  ){

    let total=0;

    for(
      let i=0;
      i<frequencyData.length;
      i++
    ){

      total +=
        frequencyData[i];

    }

    audioEnergy =
      total /
      frequencyData.length /
      255;

  }

  /* radiating resonance */

  for(
    let i=0;
    i<8;
    i++
  ){

    const rr =
      base*.1 +
      i*base*.055 +
      (
        Math.sin(
          t*.001+
          i
        )*.01 +
        audioEnergy*.03
      )*base;

    F.beginPath();

    F.arc(
      cx,
      cy,
      rr,
      0,
      Math.PI*2
    );

    F.strokeStyle =
      i%2
        ? `rgba(30,190,255,${.12+audioEnergy*.2})`
        : `rgba(255,214,107,${.1+audioEnergy*.2})`;

    F.lineWidth =
      i===0 ? 2 : .7;

    F.stroke();

  }

  drawEarth(t);

  drawDNA(t);

}


