    if(i % 3 === 0){

      STATE.edges.push({
        a,
        b:STATE.nodes[
          (i+7)%n
        ],
        type:"cross-link"
      });

    }

  }

}


/* ============================================================
   09 · SECURE RANDOM / HASH HELPERS
   ============================================================ */

function randomBytes(length=16){

  const bytes =
    new Uint8Array(length);

  if(
    window.crypto &&
    crypto.getRandomValues
  ){

    crypto.getRandomValues(bytes);

  }else{

    for(
      let i=0;
      i<length;
      i++
    ){

      bytes[i] =
        Math.floor(
          Math.random()*256
        );

    }

  }

  return bytes;

}


function hex(bytes){

  return [...bytes]
    .map(
      b => b
        .toString(16)
        .padStart(2,"0")
    )
    .join("");

}


function makeId(prefix="EVT"){

  return (
    prefix +
    "-" +
    Date.now().toString(36) +
    "-" +
    hex(randomBytes(5))
  );

}


async function sha256(value){

  const text =
    String(value);

  if(
    window.crypto &&
    crypto.subtle
  ){

    const data =
      new TextEncoder()
        .encode(text);

    const digest =
      await crypto.subtle.digest(
        "SHA-256",
        data
      );

    return hex(
      new Uint8Array(digest)
    );

  }

  /* fallback: non-cryptographic diagnostic digest */

  let h = 2166136261;

  for(
    let i=0;
    i<text.length;
    i++
  ){

    h ^= text.charCodeAt(i);

    h =
      Math.imul(
        h,
        16777619
      );

  }

  return (
    "fallback-" +
    (h >>> 0).toString(16)
  );

}


/* ============================================================
   10 · JSON SAFE SIZE CHECK
   ============================================================ */

function byteLength(value){

  try{

    return new TextEncoder()
      .encode(
        JSON.stringify(value)
      )
      .byteLength;

  }catch{

    return Infinity;

  }

}


/* ============================================================
   11 · PRIVACY FIREWALL
   ============================================================ */

const BLOCKED_KEYS = [

  "password",
  "passwd",
  "secret",
  "token",
  "apikey",
  "api_key",
  "privatekey",
  "private_key",
  "credential",
  "credentials",
  "auth",
  "authorization",
  "session",
  "cookie",
  "phone",
  "telephone",
  "email",
  "address",
  "postcode",
  "postalcode",
  "latitude",
  "longitude",
  "coordinates",
  "geolocation",
  "locationprecise"

];


function sanitiseObject(input){

  if(input === null){
    return null;
  }

  if(
    typeof input === "string" ||
    typeof input === "number" ||
    typeof input === "boolean"
  ){

    return input;

  }

  if(Array.isArray(input)){

    return input
      .slice(0,100)
      .map(sanitiseObject);

  }

  if(typeof input === "object"){

    const output = {};

    for(
      const [key,value]
      of Object.entries(input)
    ){

      const lower =
        key.toLowerCase()
          .replace(/[^a-z0-9_]/g,"");

      if(
        BLOCKED_KEYS.some(
          blocked =>
            lower.includes(
              blocked.replace(/_/g,"")
            )
        )
      ){

        continue;

      }

      output[key] =
        sanitiseObject(value);

    }

    return output;

  }

  return null;

}


/* ============================================================
   12 · SCHEMA FIREWALL
   ============================================================ */

function validateEnvelope(payload){

  if(
    payload === null ||
    typeof payload !== "object" ||
    Array.isArray(payload)
  ){

    return {
      ok:false,
      reason:"INVALID_OBJECT"
    };

  }


  if(
    byteLength(payload) >
    CONFIG.MAX_INPUT_BYTES
  ){

    return {
      ok:false,
      reason:"PAYLOAD_TOO_LARGE"
    };

  }


  if(
    payload.type &&
    typeof payload.type !== "string"
  ){

    return {
      ok:false,
      reason:"INVALID_TYPE"
    };

  }


  if(
    payload.timestamp &&
    !Number.isFinite(
      Number(payload.timestamp)
    )
  ){

    return {
      ok:false,
      reason:"INVALID_TIMESTAMP"
    };

  }


  return {
    ok:true,
    reason:"VALID"
  };

}


