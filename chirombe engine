/* ================================================================
   CONTINUITY SCAN
   ================================================================ */

function scan(){

    state.metrics.scans++;

    state.lastScan = now();

    const people = Object.values(state.persons);

    const relationships = Object.values(

        state.relationships

    );

    const knowledge = Object.values(

        state.knowledge

    );

    const assets = Object.values(

        state.assets

    );

    const signals = [];

    if(people.length === 0){

        signals.push(

            createSignal({

                category:"LINEAGE_DATA",

                description:

                    "No lineage entities are currently registered.",

                severity:0.30,

                confidence:1

            })

        );

    }

    if(people.length > 1 && relationships.length === 0){

        signals.push(

            createSignal({

                category:"CONNECTIVITY",

                description:

                    "People exist without recorded relationships.",

                severity:0.60,

                confidence:0.90

            })

        );

    }

    if(knowledge.length === 0){

        signals.push(

            createSignal({

                category:"LEGACY_KNOWLEDGE",

                description:

                    "No legacy knowledge records are currently indexed.",

                severity:0.50,

                confidence:1

            })

        );

    }

    assets.forEach(asset=>{

        if(asset.integrity < 0.60){

            signals.push(

                createSignal({

                    category:"ASSET_INTEGRITY",

                    description:

                        "Legacy asset has reduced integrity score.",

                    severity:

                        1 - asset.integrity,

                    confidence:0.90

                })

            );

        }

    });

    const continuity = calculateContinuity();

    const resilience = resilienceScore();

    const vector = stateVector();

    const report = {

        timestamp: now(),

        people: people.length,

        relationships: relationships.length,

        knowledge: knowledge.length,

        assets: assets.length,

        signals: signals.length,

        continuity,

        resilience,

        stateVector: vector

    };

    persist("SCAN_" + Date.now(),report);

    emit("BLOODLINE_SCAN_COMPLETE",report);

    return clone(report);

}


