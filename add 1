   ============================================================ */

function renderDiagnostics(){

  const target =
    $("URM_DIAGNOSTICS");

  if(!target) return;

  const capabilities =
    capabilityReport();

  const rows = {

    VERSION,

    "Page":
      location.href,

    "Viewport":
      `${window.innerWidth} × ${window.innerHeight}`,

    "Device Pixel Ratio":
      window.devicePixelRatio,

    "Online":
      navigator.onLine,

    "User Agent":
      navigator.userAgent,

    "DOM Nodes":
      document.querySelectorAll("*").length,

    "Scripts":
      state.scripts,

    "Styles":
      state.styles,

    "Duplicate IDs":
      state.duplicateIDs,

    "Oversized Elements":
      state.oversizedElements,

    "Suspicious Layers":
      state.suspiciousLayers,

    "Interaction Issues":
      state.interactionIssues,

    "Scans":
      state.scans,

    "Repairs":
      state.repairs,

    "Mutations":
      state.mutations,

    "WebCrypto":
      capabilities.webCrypto,

    "Secure Context":
      capabilities.secureContext,

    "Service Worker":
      capabilities.serviceWorker,

    "Workers":
      capabilities.workers,

    "Camera API":
      capabilities.camera,

    "Audio API":
      capabilities.audio

  };

  target.innerHTML = "";

  for(const [key,value] of Object.entries(rows)){

    const row =
      document.createElement("div");

    row.className =
      "diag-row";

    const keyNode =
      document.createElement("span");

    keyNode.className =
      "diag-key";

    keyNode.textContent =
      key;

    const valueNode =
      document.createElement("span");

    valueNode.className =
      "diag-value";

    valueNode.textContent =
      String(value);

    row.appendChild(keyNode);
    row.appendChild(valueNode);

    target.appendChild(row);

  }

}


/* ============================================================
   FULL SCAN
   ============================================================ */

function deepScan(){

  log("══════════════════════════════════");

  log("UNIVERSAL RECOVERY MASTER SCAN");

  log("══════════════════════════════════");

  scanDOM();

  inventoryResources();

  analyseLayout();

  auditInteractions();

  renderDiagnostics();

  updateStatus(
    "Deep scan completed successfully."
  );

}


/* ============================================================
   STATUS
   ============================================================ */

function updateStatus(message){

  const target =
    $("URM_STATUS");

  if(target){

    target.textContent =
      message;

  }

}


/* ============================================================
   REPORT GENERATOR
   ============================================================ */

function generateReport(){

  const report = {

    system:
      "Universal Recovery Master",

    version:
      VERSION,

    generated:
      new Date().toISOString(),

    location:
      location.href,

    state:
      {...state},

    capabilities:
      capabilityReport(),

    document: {

      title:
        document.title,

      elements:
        document.querySelectorAll("*").length,

      scripts:
        document.scripts.length,

      styles:
        document.querySelectorAll(
          "style,link[rel='stylesheet']"
        ).length

    }

  };

  state.report =
    report;

  return report;

}


/* ============================================================
   EXPORT
   ============================================================ */

function exportReport(){

  const report =
    generateReport();

  const blob =
    new Blob(
      [JSON.stringify(report,null,2)],
      {type:"application/json"}
    );

  const url =
    URL.createObjectURL(blob);

  const link =
    document.createElement("a");

  link.href =
    url;

  link.download =
    `urm-report-${Date.now()}.json`;

  document.body.appendChild(link);

  link.click();

  link.remove();

  setTimeout(
    () => URL.revokeObjectURL(url),
    1000
  );

  log(
    "Diagnostic report exported.",
    "good"
  );

}


/* ============================================================
   MUTATION MONITOR
   ============================================================ */

let mutationObserver = null;

function startMutationMonitor(){

  if(!window.MutationObserver){

    recordWarning(
      "MutationObserver unavailable."
    );

    return;

  }

  mutationObserver =
    new MutationObserver(
      mutations => {

        state.mutations +=
          mutations.length;

        updateMetrics();

      }
    );

  mutationObserver.observe(
    document.documentElement,
    {
      subtree:true,
      childList:true,
      attributes:true
    }
  );

  log(
    "Live DOM mutation monitor online.",
    "good"
  );

}


/* ============================================================
   GLOBAL ERROR MONITOR
   ============================================================ */

window.addEventListener(
  "error",
  event => {

    if(
      event &&
      event.message
    ){

      recordError(
        `Runtime error: ${event.message}`
      );

    }

  }
);


window.addEventListener(
  "unhandledrejection",
  event => {

    recordError(
      `Unhandled promise rejection: ${
        event.reason || "unknown"
      }`
    );

  }
);


/* ============================================================
   CONNECTION MONITOR
   ============================================================ */

window.addEventListener(
  "online",
  () => {

    log(
      "Network connection restored.",
      "good"
    );

  }
);


window.addEventListener(
  "offline",
  () => {

    recordWarning(
      "Browser reports offline state."
    );

  }
);


/* ============================================================
   PERFORMANCE MONITOR
   ============================================================ */

function performanceSnapshot(){

  if(!window.performance)
    return;

  const memory =
    performance.memory;

  if(memory){

    log(
      `Memory: ${Math.round(
        memory.usedJSHeapSize / 1048576
      )} MB used`,
      "info"
    );

  }

}


/* ============================================================
   EVENT WIRING
   ============================================================ */

function wireControls(){

  $("URM_SCAN")?.addEventListener(
    "click",
    deepScan
  );

  $("URM_REPAIR")?.addEventListener(
    "click",
    () => {

      reconcileLayout();

      renderDiagnostics();

      updateStatus(
        "Conservative layout reconciliation completed."
      );

    }
  );

  $("URM_AUDIT")?.addEventListener(
    "click",
    () => {

      auditInteractions();

      renderDiagnostics();

      updateStatus(
        "Interaction audit completed."
      );

    }
  );

  $("URM_REFRESH")?.addEventListener(
    "click",
    () => {

      renderDiagnostics();

      updateMetrics();

      performanceSnapshot();

      updateStatus(
        "Diagnostics refreshed."
      );

    }
  );

  $("URM_EXPORT")?.addEventListener(
    "click",
    exportReport
  );

  $("URM_CLEAR")?.addEventListener(
    "click",
    () => {

      const logTarget =
        $("URM_LOG");

      if(logTarget)
        logTarget.innerHTML = "";

      state.events = [];

      log(
        "Log cleared.",
        "good"
      );

    }
  );

}


/* ============================================================
   PUBLIC API
   ============================================================ */

window.UNIVERSAL_RECOVERY_BOTTOM = {

  version: VERSION,

  scan:
    deepScan,

  repair:
    reconcileLayout,

  audit:
    auditInteractions,

  diagnostics:
    renderDiagnostics,

  report:
    generateReport,

  export:
    exportReport,

  capabilities:
    capabilityReport,

  state

};


/* ============================================================
   BOOT
   ============================================================ */

function boot(){

  log(
    `Universal Recovery Master ${VERSION} booting...`
  );

  wireControls();

  updateMetrics();

  renderDiagnostics();

  startMutationMonitor();

  performanceSnapshot();

  log(
    "Recovery command interface online.",
    "good"
  );

  updateStatus(
    "Universal Recovery Master is operational."
  );

  /*
    Delay the first deep scan slightly so that
    dynamically generated application content has
    an opportunity to initialise first.
  */

  setTimeout(
    deepScan,
    250
  );

}


/* ============================================================
   SAFE DOM READY
   ============================================================ */

if(
  document.readyState === "loading"
){

  document.addEventListener(
    "DOMContentLoaded",
    boot,
    {once:true}
  );

}else{

  boot();

}


/* ============================================================
   GLOBAL READY SIGNAL
   ============================================================ */

window.dispatchEvent(
  new CustomEvent(
    "UNIVERSAL_RECOVERY_BOTTOM_READY",
    {
      detail:{
        version:VERSION
      }
    }
  )
);


})();
</script>

