    async function healthScan() {
        STATE.cycle++;
        STATE.metrics.scans++;

        const checks = [
            checkCore(),
            checkMemory(),
            checkWorkers(),
            checkEvolution(),
            checkPathways()
        ];

        let score = 0;
        let passed = 0;
        let failed = 0;
        let warnings = 0;

        checks.forEach(
            function (check) {
                score +=
                    Number(check.score) || 0;

                if (check.passed) {
                    passed++;
                } else {
                    failed++;

                    if (
                        check.name !==
                        "CORE"
                    ) {
                        warnings++;
                    }
                }
            }
        );

        const finalScore =
            checks.length > 0
                ? Math.round(
                    score / checks.length
                )
                : 0;

        let status =
            "HEALTHY";

        if (finalScore < 80) {
            status =
                finalScore >= 50
                    ? "DEGRADED"
                    : "CRITICAL";
        }

        STATE.health = {
            status: status,
            score: finalScore,
            checks: checks.length,
            passed: passed,
            failed: failed,
            warnings: warnings,
            checkedAt: now(),
            cycle: STATE.cycle,
            details: checks
        };

        STATE.lastHealthScan =
            now();

        for (
            let i = 0;
            i < checks.length;
            i++
        ) {
            const check =
                checks[i];

            if (!check.passed) {
                await createIncident(
                    "HEALTH_CHECK_FAILED",
                    check.name === "CORE"
                        ? "CRITICAL"
                        : "WARNING",
                    check.name,
                    "Health check failed for " +
                    check.name,
                    check.details
                );
            }
        }

        return STATE.health;
    }

