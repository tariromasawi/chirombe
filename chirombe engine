                    createRecoveryPlan(
                        incident
                    );

                }

            }

        }

        const integrity =
            await integritySnapshot();

        const result = {

            timestamp:
                now(),

            anomalyScore,

            signalCount:
                signals.length,

            signals:
                clone(signals),

            integrity:
                clone(integrity),

            baseline:
                clone(
                    STATE.baseline
