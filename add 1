function createAudio(){

  if(audioCtx){
    return;
  }

  audioCtx =
    new (
      window.AudioContext ||
      window.webkitAudioContext
    )();

  masterGain =
    audioCtx.createGain();

  analyser =
    audioCtx.createAnalyser();

  analyser.fftSize =
    2048;

  analyser.smoothingTimeConstant =
    .86;

  masterGain.gain.value =
    0.0001;

  masterGain
    .connect(analyser);

  analyser
    .connect(
      audioCtx.destination
    );

  const freqs =
    CONFIG.symbolicFrequencies;

  freqs.forEach(
    (freq,index)=>{

      const osc =
        audioCtx.createOscillator();

      const gain =
        audioCtx.createGain();

      osc.type =
        index % 3 === 0
          ? "sine"
          : index % 3 === 1
            ? "triangle"
            : "sine";

      osc.frequency.value =
        freq;

      gain.gain.value =
        0.0001;

      osc
        .connect(gain)
        .connect(masterGain);

      osc.start();

      oscillators.push(
        osc
      );

      gains.push(
        gain
      );

    }
  );

  audioStarted = true;

}


async function startAudio(){

  createAudio();

  if(
    audioCtx.state ===
    "suspended"
