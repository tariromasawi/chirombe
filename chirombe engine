    /* ============================================================
       REQUIREMENT → BUILD PLAN
       ============================================================ */

    async function planRequirement(
        requirementId
    ) {

        const requirement =
            STATE.requirements[
                requirementId
            ];

        if (!requirement) {

            throw new Error(
                "Requirement not found."
            );
        }

        const targetFiles =
            [];

        const operations =
            [];

        const tests =
            [];

        /*
         * Basic target inference.
         */

        const category =
            normalize(
                requirement.category
            );

        if (
            category ===
                "CORE"
        ) {

            targetFiles.push(
                "chirombe-core.js"
            );

        } else if (
            category ===
                "MEMORY"
        ) {

            targetFiles.push(
                "chirombe-memory.js"
            );

        } else if (
            category ===
                "WORKER"
        ) {

            targetFiles.push(
                "chirombe-workers.js"
            );

        } else if (
            category ===
                "EVOLUTION"
        ) {

            targetFiles.push(
                "chirombe-evolution.js"
            );

        } else if (
            category ===
                "PATHWAY"
        ) {

            targetFiles.push(
                "chirombe-pathways.js"
            );

        } else if (
            category ===
                "WATCHDOG"
        ) {

            targetFiles.push(
                "chirombe-watchdog.js"
            );

        } else if (
            category ===
                "KNOWLEDGE"
        ) {

            targetFiles.push(
                "chirombe-knowledge.js"
            );

        } else {

            targetFiles.push(
                "NEW_MODULE"
            );
        }

        operations.push({

            type:
                "IMPLEMENT",

            description:
                requirement.description,

            acceptanceCriteria:
                requirement.acceptanceCriteria
        });

        tests.push({

            type:
                "FUNCTIONAL",

            description:
                "Verify requirement acceptance criteria.",

            criteria:
                requirement.acceptanceCriteria
        });

        const plan =
            await createBuildPlan({

                title:
                    "Build plan for " +
                    requirement.title,

                objective:
                    requirement.description,

                requirementIds:
                    [
                        requirement.id
                    ],

                targetFiles:
                    targetFiles,

                operations:
                    operations,

                dependencies:
                    requirement.dependencies,

                tests:
                    tests,

                confidence:
                    requirement.confidence
            });

        return plan;
    }

