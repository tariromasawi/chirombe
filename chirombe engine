    function detectAnomalies() {
        const anomalies = [];

        const health =
            STATE.health;

        if (
            health.status ===
            "CRITICAL"
        ) {
            anomalies.push({
                type: "SYSTEM_CRITICAL",
                severity: "CRITICAL",
                score: 1
            });
        }

        Object.keys(
            STATE.modules
        ).forEach(
            function (name) {
                const module =
                    STATE.modules[name];

                if (!module.exists) {
                    anomalies.push({
                        type:
                            "MODULE_MISSING",
                        severity:
                            CONFIG
                                .protectedModules
                                .indexOf(name) >=
                            0
                                ? "CRITICAL"
                                : "WARNING",
                        component: name,
                        score: 0.9
                    });
                }
            }
        );

        Object.keys(
            STATE.workers
        ).forEach(
            function (name) {
                const worker =
                    STATE.workers[name];

                if (
                    worker &&
                    worker.healthy === false
                ) {
                    anomalies.push({
                        type:
                            "WORKER_UNHEALTHY",
                        severity:
                            "WARNING",
                        component:
                            name,
                        score:
                            0.7
                    });
                }
            }
        );

        STATE.anomalyHistory.push({
            timestamp: now(),
            anomalies:
                safeClone(anomalies)
        });

        if (
            STATE.anomalyHistory.length >
            200
        ) {
            STATE.anomalyHistory =
                STATE.anomalyHistory.slice(
                    -200
                );
        }

        return anomalies;
    }

