<!-- Script: robust, well-commented -->
<script>
/*
  ZionCore Communication Channel — Enhanced
  Features:
    - Chat UI with messages + timestamps
    - LocalStorage conversation saving
    - Load base64 audio OR upload file -> create blob URL
    - WebAudio pipeline: audio element -> AudioContext -> Gain -> optional EQ
    - SpeechSynthesis (TTS) with voice selection
    - Explicit "Activate Audio" flow to comply with browser autoplay policy
    - Loop verses option (user-initiated)
*/

// ---------- State ----------
const STATE = {
  audioActivated: false,
  audioBlobUrl: null,
  audioBuffer: null,
  isPlaying: false,
  loop: false,
  eqEnabled: false,
  conversation: JSON.parse(localStorage.getItem('zion_conv')||'[]') // {role:'user'|'bot'|'system', text, ts}
};

// ---------- Helpers ----------
const $ = id => document.getElementById(id);
const formatTime = ts => new Date(ts).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});

// ---------- Chat UI ----------
const messagesEl = $('messages');

function pushMessage(role, text){
  const msg = { role, text, ts: Date.now() };
  STATE.conversation.push(msg);
  renderMessage(msg);
  localStorage.setItem('zion_conv', JSON.stringify(STATE.conversation));
}

function renderMessage(msg){
  const div = document.createElement('div');
  div.className = 'msg ' + (msg.role === 'user' ? 'user' : (msg.role === 'bot' ? 'bot' : 'system'));
  div.innerHTML = `<div>${escapeHtml(msg.text)}</div>
    <div class="meta"><span class="small">${msg.role.toUpperCase()} • ${formatTime(msg.ts)}</span>
    <span class="small"><button class="btn secondary" data-copy="${msg.ts}">Copy</button></span></div>`;
  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

// sanitize
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// initial render
STATE.conversation.forEach(renderMessage);

// event delegation for copy buttons
messagesEl.addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  const ts = btn.dataset.copy;
  if(ts){
    const entry = STATE.conversation.find(x=> x.ts == ts);
    if(entry){ navigator.clipboard.writeText(entry.text).then(()=> alert('Copied message to clipboard')) }
  }
});

// composer events
$('text').addEventListener('keydown', e=>{
  if(e.key === 'Enter'){ e.preventDefault(); sendCurrent() }
});
$('send').addEventListener('click', sendCurrent);

// send function (simple echo bot + optional TTS)
function sendCurrent(){
  const input = $('text');
  const v = input.value.trim();
  if(!v) return;
  pushMessage('user', v);
  input.value = '';
  // simple bot response — you can replace with your own server call
  setTimeout(()=>{
    const resp = generateBotResponse(v);
    pushMessage('bot', resp);
  }, 300);
}
function generateBotResponse(userText){
  // Example: echo with flourish and timestamp
  return `By your command: "${userText}" — Received and sealed. [${new Date().toISOString()}]`;
}

// ---------- Export / Import / Clear ----------
$('export-json').addEventListener('click', ()=>{
  const blob = new Blob([JSON.stringify(STATE.conversation, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'zioncore-conversation.json'; a.click();
  URL.revokeObjectURL(url);
});
$('import-json').addEventListener('click', async ()=>{
  try{
    const fileHandle = await new Promise(resolve=>{
      const inp = document.createElement('input');
      inp.type='file'; inp.accept='application/json';
      inp.onchange = ()=> resolve(inp.files[0]);
      inp.click();
    });
    if(!fileHandle) return;
    const text = await fileHandle.text();
    const arr = JSON.parse(text);
    if(Array.isArray(arr)) { STATE.conversation = arr; localStorage.setItem('zion_conv', JSON.stringify(arr)); messagesEl.innerHTML=''; arr.forEach(renderMessage); alert('Imported conversation'); }
  }catch(err){ alert('Import failed: '+err.message) }
});
$('clear-chat').addEventListener('click', ()=>{
  if(!confirm('Clear conversation? This cannot be undone.')) return;
  STATE.conversation = []; localStorage.removeItem('zion_conv'); messagesEl.innerHTML='';
});

// ---------- Audio Activation Flow ----------
const audioEl = new Audio();
audioEl.crossOrigin = 'anonymous';
let audioContext, sourceNode, gainNode, eqFilters=[];

$('activate-audio').addEventListener('click', async ()=>{
  if(STATE.audioActivated) { alert('Audio already activated.'); return; }
  try{
    audioContext = new (window.AudioContext || window.webkitAudioContext)();
    sourceNode = audioContext.createMediaElementSource(audioEl);
    gainNode = audioContext.createGain();
    gainNode.gain.value = parseFloat($('volume').value || 0.8);
    // connect default chain: source -> gain -> destination
    sourceNode.connect(gainNode);
    gainNode.connect(audioContext.destination);
    STATE.audioActivated = true;
    $('activate-audio').textContent = 'Audio Active';
    $('activate-audio').classList.add('btn','secondary');
    pushMessage('system','Audio engine activated. You may now load audio and use TTS.');
    populateVoices();
  }catch(err){
    alert('Failed to initialize AudioContext: '+err.message);
  }
});

// Load audio (from file input or base64)
$('load-audio').addEventListener('click', async ()=>{
  // prefer file input
  const file = $('file-input').files[0];
  const b64 = $('base64-input').value.trim();
  if(file){
    const url = URL.createObjectURL(file);
    setAudioSource(url);
  } else if(b64){
    // handle possible "data:audio/..." prefix
    let data = b64;
    if(data.startsWith('data:')) data = data.split(',')[1] || data;
    try{
      // decode base64 -> Uint8Array -> Blob -> objectURL
      const binary = atob(data);
      const len = binary.length;
      const arr = new Uint8Array(len);
      for (let i = 0; i < len; i++) arr[i] = binary.charCodeAt(i);
      const blob = new Blob([arr], {type: 'audio/wav'}); // type guessed; adjust if known
      const url = URL.createObjectURL(blob);
      setAudioSource(url);
      // store blob url in STATE so we can revoke later if needed
      STATE.audioBlobUrl = url;
      pushMessage('system','Base64 audio loaded as blob (do not reload page).');
    }catch(err){
      alert('Failed to decode base64: '+err.message);
    }
  } else {
    alert('Please upload a file or paste base64 data first.');
  }
});

// set audio source and wire up events
function setAudioSource(url){
  audioEl.src = url;
  audioEl.loop = false;
  audioEl.onplay = ()=> { STATE.isPlaying = true; $('play-toggle').textContent='Pause'; }
  audioEl.onpause = ()=> { STATE.isPlaying = false; $('play-toggle').textContent='Play'; }
  audioEl.onended = ()=> { STATE.isPlaying = false; $('play-toggle').textContent='Play'; if(STATE.loop) audioEl.play(); }
  pushMessage('system','Audio source set. Use Play to start (user interaction required).');
}

// play/pause
$('play-toggle').addEventListener('click', async ()=>{
  if(!STATE.audioActivated){ alert('Activate audio first.'); return; }
  if(!audioEl.src){ alert('Load audio first.'); return; }
  try{
    if(audioContext && audioContext.state === 'suspended'){ await audioContext.resume(); }
    if(audioEl.paused){ await audioEl.play(); } else { audioEl.pause(); }
  }catch(err){ alert('Playback failed: '+err.message); }
});

// loop toggle
$('loop-toggle').addEventListener('click', ()=>{
  STATE.loop = !STATE.loop;
  audioEl.loop = STATE.loop;
  $('loop-toggle').textContent = `Loop: ${STATE.loop ? 'On' : 'Off'}`;
});

// volume & playback rate wiring
$('volume').addEventListener('input', e=>{
  const v = parseFloat(e.target.value);
  if(gainNode) gainNode.gain.value = v;
  audioEl.volume = v; // keep element volume in sync
});
$('playbackrate').addEventListener('input', e=>{
  audioEl.playbackRate = parseFloat(e.target.value);
});

// EQ toggle (simple 3-band)
$('toggle-eq').addEventListener('click', ()=>{
  if(!audioContext){ alert('Activate audio first.'); return; }
  if(!STATE.eqEnabled){
    // create 3 biquad filters for low/mid/high
    const low = audioContext.createBiquadFilter(); low.type='lowshelf'; low.frequency.value=320; low.gain.value = 3;
    const mid = audioContext.createBiquadFilter(); mid.type='peaking'; mid.frequency.value=1000; mid.Q.value=1; mid.gain.value = 2;
    const high = audioContext.createBiquadFilter(); high.type='highshelf'; high.frequency.value=3000; high.gain.value = 2;
    // reconnect: source -> low -> mid -> high -> gain -> dest
    sourceNode.disconnect();
    sourceNode.connect(low);
    low.connect(mid);
    mid.connect(high);
    high.connect(gainNode);
    eqFilters = [low,mid,high];
    STATE.eqEnabled = true;
    pushMessage('system','EQ enabled (gentle boost).');
  } else {
    // disable EQ: reconnect source -> gain -> dest
    sourceNode.disconnect();
    sourceNode.connect(gainNode);
    eqFilters.forEach(f => f.disconnect && f.disconnect());
    eqFilters = [];
    STATE.eqEnabled = false;
    pushMessage('system','EQ disabled.');
  }
});

// reset audio chain
$('reset-audio').addEventListener('click', ()=>{
  if(!audioContext) return alert('Activate audio first.');
  try{
    sourceNode.disconnect();
    sourceNode.connect(gainNode);
    eqFilters.forEach(f => f.disconnect && f.disconnect());
    eqFilters = [];
    STATE.eqEnabled = false;
    pushMessage('system','Audio pipeline reset.');
  }catch(e){ console.warn(e) }
});

// revoke and cleanup when page unloads
window.addEventListener('beforeunload', ()=>{
  if(STATE.audioBlobUrl) URL.revokeObjectURL(STATE.audioBlobUrl);
});

// ---------- Speech Synthesis (TTS) ----------
const synth = window.speechSynthesis;
const voiceSelect = $('voice-select');
const ttsRate = $('tts-rate');
const ttsVolume = $('tts-volume');

function populateVoices(){
  const voices = synth.getVoices();
  voiceSelect.innerHTML = '';
  voices.forEach((v,i)=>{
    const opt = document.createElement('option');
    opt.value = i; opt.textContent = `${v.name} — ${v.lang}${v.default ? ' (default)' : ''}`;
    voiceSelect.appendChild(opt);
  });
}
populateVoices();
if (speechSynthesis.onvoiceschanged !== undefined) {
  speechSynthesis.onvoiceschanged = populateVoices;
}

$('speak-last').addEventListener('click', ()=>{
  if(!STATE.audioActivated) { alert('Activate audio first to allow speech'); return; }
  const last = [...STATE.conversation].reverse().find(x=> x.role !== 'system');
  if(!last) return alert('No message to speak yet');
  speakText(last.text);
});
$('stop-tts').addEventListener('click', ()=> synth.cancel());

function speakText(text){
  if(!synth) return;
  const u = new SpeechSynthesisUtterance(text);
  const voices = synth.getVoices();
  const idx = parseInt(voiceSelect.value) || 0;
  if(voices[idx]) u.voice = voices[idx];
  u.rate = parseFloat(ttsRate.value);
  u.volume = parseFloat(ttsVolume.value);
  synth.cancel(); // stop previous
  synth.speak(u);
}

// ---------- Loop Verses / Repeat Feature ----------
let repeating = false;
$('repeat-verses').addEventListener('click', async ()=>{
  if(!STATE.audioActivated){ alert('Activate audio first.'); return; }
  repeating = !repeating;
  $('repeat-verses').textContent = repeating ? 'Stop Loop' : 'Loop Verses';
  if(repeating){
    // put some example verses or repeat last bot message
    const verses = STATE.conversation.filter(m => m.role === 'bot').map(m=>m.text);
    if(verses.length === 0){ pushMessage('system','No bot verses to loop.'); repeating = false; $('repeat-verses').textContent='Loop Verses'; return; }
    // loop via TTS or audio, choose TTS for precise repetition
    (async function loopSpeak(){
      while(repeating){
        for(const v of verses){
          if(!repeating) break;
          speakText(v);
          // wait for utterance end (approximate)
          await new Promise(res => {
            const checker = setInterval(()=> {
              if(!synth.speaking) { clearInterval(checker); return res(); }
            }, 200);
            // safety timeout after 60s
            setTimeout(()=> { clearInterval(checker); res(); }, 60000);
          });
        }
      }
    })();
  } else {
    synth.cancel();
  }
});

// ---------- Utility: load example placeholder audio (short beep) ----------
/* You can replace BASE64_AUDIO with your full base64 data string if desired.
   Note: very large base64 strings are heavy — it's better to upload a file or serve it from a URL.
*/
const BASE64_AUDIO = ''; // <-- Paste your full base64 (without data: prefix) if you want to auto-load
if(BASE64_AUDIO){
  $('base64-input').value = BASE64_AUDIO.slice(0,200) + '...';
  // do not auto-load until user clicks Load Audio
}

// ---------- Small UX improvements ----------
$('text').focus();
pushMessage('system','ZionCore ready. Type a message and press Enter. Activate audio to enable playback and speech.');

// Escape hatch for accessibility: keyboard shortcuts
