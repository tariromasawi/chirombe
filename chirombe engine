            name: name,
            exists: exists,
            type: type,
            checkedAt: now(),

            healthy:
                exists,

            protected:
                CONFIG.protectedModules
                    .indexOf(name) !== -1,

            referenceAvailable:
                exists
        };

        STATE.modules[name] =
            moduleState;

        return moduleState;
