  let previous =
    "GENESIS";

  for(
    const record
    of STATE.audit
  ){

    const copy = {

      id:record.id,

      timestamp:
        record.timestamp,

      type:
        record.type,

      payload:
        record.payload,

      previous:
        record.previous

    };

    if(
      record.previous !==
      previous
    ){

      return false;

    }

    const digest =
      await sha256(
        JSON.stringify(copy)
      );

    if(
      digest !==
      record.digest
    ){

      return false;

    }

    previous =
      record.digest;

  }

  return true;

}


