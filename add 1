                R.repairs,

            reconciliations:
                R.reconciliations,

            errors:
                R.errors,

            mutations:
                R.mutations

        };

    }

};


/* ------------------------------------------------------------------------
   GLOBAL READY EVENT
   ------------------------------------------------------------------------ */

window.dispatchEvent(
    new CustomEvent(
        "UNIVERSAL_RECOVERY_MASTER_READY",
        {
            detail:
                window
                    .UNIVERSAL_RECOVERY_MASTER
        }
    )
);


})();
