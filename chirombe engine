    /* ============================================================
       PATTERN DETECTION
       ============================================================ */

    async function detectPatterns() {

        const observations =
            Object.values(
                STATE.observations
            );

        const patterns = [];

        const buckets = {};

        observations.forEach(
            function (observation) {

                const key =
                    normalize(
                        observation.type
                    ) +
                    "::" +
                    normalize(
                        observation.subject
                    );

                if (
                    !buckets[key]
                ) {

                    buckets[key] =
                        [];
                }

                buckets[key].push(
                    observation
                );
            }
        );

        Object.keys(
            buckets
        ).forEach(
            function (key) {

                const group =
                    buckets[key];

                if (
                    group.length <
                    2
                ) {
                    return;
                }

                const confidence =
                    group.reduce(
                        function (
                            total,
                            item
                        ) {

                            return (
                                total +
                                (
                                    Number(
                                        item.confidence
                                    ) || 0
                                )
                            );
                        },
                        0
                    ) /
                    group.length;

                const pattern = {

                    id:
                        uid("PAT"),

                    key:
                        key,

                    type:
                        "RECURRING_OBSERVATION",

                    occurrences:
                        group.length,

                    confidence:
                        confidence,

                    observationIds:
                        group.map(
                            function (
                                item
                            ) {

                                return item.id;
                            }
                        ),

                    detectedAt:
                        now()
                };

                STATE.patterns[
                    pattern.id
                ] = pattern;

                STATE.metrics
                    .patternsDetected++;
                
                patterns.push(
                    pattern
                );
            }
        );

        for (
            let i = 0;
            i < patterns.length;
            i++
        ) {

            await persist(
                "PATTERN_" +
                    patterns[i].id,
                patterns[i]
            );
        }

        return patterns;
    }

