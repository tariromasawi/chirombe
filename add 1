  "longitude",
  "coordinates",
  "geolocation",
  "locationprecise"

];


function sanitiseObject(input){

  if(input === null){
    return null;
  }

  if(
    typeof input === "string" ||
    typeof input === "number" ||
    typeof input === "boolean"
  ){

    return input;

  }

  if(Array.isArray(input)){

    return input
      .slice(0,100)
      .map(sanitiseObject);

  }

  if(typeof input === "object"){

    const output = {};

    for(
      const [key,value]
      of Object.entries(input)
    ){

      const lower =
        key.toLowerCase()
          .replace(/[^a-z0-9_]/g,"");

      if(
        BLOCKED_KEYS.some(
          blocked =>
            lower.includes(
              blocked.replace(/_/g,"")
            )
        )
      ){

        continue;

      }

      output[key] =
        sanitiseObject(value);

    }

    return output;

  }

  return null;

}


/* ============================================================
   12 · SCHEMA FIREWALL
   ============================================================ */

function validateEnvelope(payload){

  if(
    payload === null ||
    typeof payload !== "object" ||
    Array.isArray(payload)
  ){

    return {
      ok:false,
      reason:"INVALID_OBJECT"
    };

  }


  if(
    byteLength(payload) >
    CONFIG.MAX_INPUT_BYTES
  ){

    return {
      ok:false,
      reason:"PAYLOAD_TOO_LARGE"
    };

  }


  if(
    payload.type &&
    typeof payload.type !== "string"
  ){

    return {
      ok:false,
      reason:"INVALID_TYPE"
    };

  }


  if(
    payload.timestamp &&
    !Number.isFinite(
      Number(payload.timestamp)
    )
  ){

    return {
      ok:false,
      reason:"INVALID_TIMESTAMP"
    };

  }


  return {
    ok:true,
    reason:"VALID"
  };

}


