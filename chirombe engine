/* ================================================================
   TWIN CONFIDENCE
   ================================================================ */

function calculateTwinConfidence(){

    const nodes =

        Object.values(

            state.twin.nodes

        );

    const edges =

        Object.values(

            state.twin.edges

        );

    const values =

        Object.values(

            state.values

        );

    const nodeConfidence =

        nodes.length

            ? average(

                nodes.map(

                    n=>n.confidence

                )

            )

            : 0;

    const edgeConfidence =

        edges.length

            ? average(

                edges.map(

                    e=>e.confidence

                )

            )

            : 0;

    const valueConfidence =

        values.length

            ? average(

                values.map(

                    v=>v.confidence

                )

            )

            : 0;

    if(

        !nodes.length &&

        !edges.length &&

        !values.length

    ){

        return 0;

    }

    return clamp(

        nodeConfidence * 0.45 +

        edgeConfidence * 0.30 +

        valueConfidence * 0.25

    );

}


/* ================================================================
   QUANTUM-INSPIRED LEGACY STATE
   ================================================================ */

function legacyStateVector(){

    const continuity =

        BLOODLINE &&

        typeof BLOODLINE.calculateContinuity ===

        "function"

            ? BLOODLINE.calculateContinuity()

            : {score:0.5};

    const twinConfidence =

        calculateTwinConfidence();

    const knowledgeDensity =

        clamp(

            Object.keys(

                state.knowledgeLinks

            ).length /

            Math.max(

                1,

                Object.keys(

                    state.twin.nodes

                ).length * 2

            )

        );

    const preservation =

        Object.keys(

            state.values

        ).length > 0

            ? 1

            : 0.3;

    const recovery =

        WATCHDOG

            ? 0.75

            : 0.50;

    const vector = [

        clamp(

            continuity.score ||

            0.5

        ),

        twinConfidence,

        knowledgeDensity,

        preservation,

        recovery

    ];

    const magnitude =

        Math.sqrt(

            vector.reduce(

                (sum,v)=>

                    sum+(v*v),

                0

            )

        );

    return {

        timestamp:now(),

        vector,

        magnitude,

        normalized:

            magnitude

                ? vector.map(

                    v=>v/magnitude

                )

                : vector,

        interpretation:[

            "continuity",

            "model-confidence",

            "knowledge-density",

            "legacy-preservation",

            "recovery-readiness"

        ],

        model:

            "QUANTUM_INSPIRED_LEGACY_STATE"

    };

}


