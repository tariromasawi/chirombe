    /* ============================================================
       AUTOMATIC LESSON GENERATION
       ============================================================ */

    async function generateLessons() {

        const generated = [];

        Object.keys(
            STATE.patterns
        ).forEach(
            function (id) {

                const pattern =
                    STATE.patterns[id];

                if (
                    pattern.confidence <
                    CONFIG
                        .minimumInferenceConfidence
                ) {
                    return;
                }

                const existing =
                    Object.values(
                        STATE.lessons
                    ).some(
                        function (lesson) {

                            return (
                                lesson.metadata &&
                                lesson.metadata
                                    .patternId ===
                                pattern.id
                            );
                        }
                    );

                if (existing) {
                    return;
                }

                generated.push(
                    createLesson({
                        title:
                            "Pattern-derived lesson",

                        statement:
                            "Recurring pattern detected in " +
                            pattern.key,

                        basis:
                            "PATTERN_ANALYSIS",

                        confidence:
                            pattern.confidence,

                        evidenceIds:
                            pattern.observationIds,

                        status:
                            pattern.confidence >=
                            CONFIG
                                .minimumPromotionConfidence
                                ? "SUPPORTED"
                                : "PROVISIONAL",

                        metadata: {
                            patternId:
                                pattern.id
                        }
                    })
                );
            }
        );

        const results =
            await Promise.all(
                generated
            );

        return results;
    }

    /* ============================================================
       INFERENCE ENGINE
       ============================================================ */

    async function infer(
        query,
        options
    ) {

        options =
            options || {};

        STATE.metrics.inferences++;

        const matches =
            search(
                query,
                {
                    threshold:
                        options.threshold ||
                        0.15,

                    limit:
                        options.limit ||
                        20
                }
            );

        const supportingRelations =
            [];

        matches.forEach(
            function (match) {

                const relations =
                    relatedConcepts(
                        match.concept.id,
                        {
                            limit:
                                20
                        }
                    );

                relations.forEach(
                    function (item) {

                        supportingRelations
                            .push(
                                item
                            );
                    }
                );
            }
        );

        const evidence =
            matches.map(
                function (item) {

                    return {
                        type:
                            "CONCEPT_MATCH",

                        id:
                            item.concept.id,

                        score:
                            item.score
                    };
                }
            );

        const relationEvidence =
            supportingRelations.map(
                function (item) {

                    return {
                        type:
                            "RELATION",

                        relation:
                            item.relation,

                        concept:
                            item.concept
                    };
                }
            );

        const combined =
            [
                ...evidence,
                ...relationEvidence
            ];

        const confidence =
            matches.length
                ? Math.min(
                    1,
                    matches.reduce(
                        function (
                            total,
                            item
                        ) {

                            return (
                                total +
                                item.score
                            );
                        },
                        0
                    ) /
                    matches.length
                )
                : 0;

        const result = {

            id:
                uid("INF"),

            query:
                query,

            timestamp:
                now(),

            confidence:
                confidence,

            matches:
                matches,

            evidence:
                combined,

            interpretation:
                confidence >=
                CONFIG
                    .minimumInferenceConfidence
                    ? "SUPPORTED_BY_INDEXED_KNOWLEDGE"
                    : "INSUFFICIENT_EVIDENCE"
        };

        STATE.inferenceHistory.unshift(
            result
        );

        if (
            STATE.inferenceHistory
                .length > 500
        ) {

            STATE.inferenceHistory =
                STATE.inferenceHistory
                    .slice(
                        0,
                        500
                    );
        }

        await persist(
            "INFERENCE_" +
                result.id,
            result
        );

        return clone(result);
    }

