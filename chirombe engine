            String(action)
                .toUpperCase()
        ) {
            case "HEALTH":
                return healthScan();

            case "SNAPSHOT":
                return integritySnapshot();

            case "RECOVERY":
                return recoveryScan();

            case "HEARTBEAT":
                return heartbeat();

            case "STATUS":
                return getStatus();

            case "VERIFY":
                return verifyRecentIntegrity();

            case "INCIDENTS":
                return getIncidents(
                    payload.limit
                );

            case "PLANS":
                return getRecoveryPlans(
                    payload.limit
                );

            case "STOP":
                stopScheduler();

                return {
                    success: true,
                    status:
                        "STOPPED"
                };

            case "START":
                startScheduler();

                return {
                    success: true,
                    status:
                        "STARTED"
                };

            default:
                return {
                    success: false,
                    error:
                        "UNKNOWN_WATCHDOG_COMMAND"
                };
        }
    }

