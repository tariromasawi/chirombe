function clamp(value,min,max){

  return Math.max(
    min,
    Math.min(max,value)
  );

}


/* ============================================================
   31 · COHERENCE SIMULATION
   ============================================================ */

function updateCoherence(){

  if(
    !STATE.nodes.length
  ){

    STATE.coherence = 0;

    return;

  }

  const total =
    STATE.nodes.reduce(
      (sum,node) =>
        sum +
        node.energy,
      0
    );

  let value =
    total /
    STATE.nodes.length;

  /* deterministic small movement */

  value +=
    Math.sin(
      STATE.frame*.008
    )*.04;

  STATE.coherence =
    clamp(
      value,
      0,
      1
    );

  DOM.coherenceValue.textContent =
    Math.round(
      STATE.coherence*100
    ) + "%";

  DOM.coherenceMeter.style.width =
    Math.round(
      STATE.coherence*100
    ) + "%";

}


