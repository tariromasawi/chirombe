/* ================================================================
   GENERATION ENGINE
   ================================================================ */

function analyseGenerations(){

    const generations = Object.values(

        state.generations

    );

    state.generationCount = generations.length;

    state.metrics.generationsMapped = generations.length;

    const report = {

        timestamp: now(),

        generationCount: generations.length,

        generations: [],

        continuity: 0,

        confidence: 0

    };

    let totalConfidence = 0;

    let confidenceCount = 0;

    generations

        .sort((a,b)=>a.number-b.number)

        .forEach(g=>{

            const members = g.personIds

                .map(id=>state.persons[id])

                .filter(Boolean);

            const average = members.length

                ? members.reduce(

                    (sum,p)=>sum+p.confidence,

                    0

                ) / members.length

                : 0;

            report.generations.push({

                id:g.id,

                number:g.number,

                members:members.length,

                confidence:average

            });

            totalConfidence += average;

            confidenceCount++;

        });

    report.confidence =

        confidenceCount

            ? totalConfidence/confidenceCount

            : 0;

    if(generations.length > 1){

        const mapped = generations.length;

        const max = Math.max(

            ...generations.map(g=>g.number)

        );

        const min = Math.min(

            ...generations.map(g=>g.number)

        );

        const span = Math.max(1,max-min+1);

        report.continuity = clamp(mapped/span);

    }

    state.continuity.generations = report;

    state.lastContinuityAnalysis = now();

    state.metrics.continuityAnalyses++;

    persist("GENERATION_ANALYSIS",report);

    emit("BLOODLINE_GENERATIONS_ANALYSED",report);

    return clone(report);

}


