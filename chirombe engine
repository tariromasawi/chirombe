        API;

    /* ============================================================
       BOOT
       ============================================================ */

    async function boot() {
        if (STATE.booted) {
            return API;
        }

        STATE.booted =
            true;

        log(
            "=============================================="
        );

        log(
            "CHIROMBE WATCHDOG ENGINE"
        );

        log(
            "Protocol:",
            CONFIG.protocol
        );

        log(
            "Version:",
            CONFIG.version
        );

        log(
            "Booting integrity and recovery layer..."
        );

        installEventMonitoring();

        scanModules();

        scanWorkers();

        await heartbeat();

        await healthScan();

        await integritySnapshot();

        /*
         * Register watchdog workers with the existing
         * worker swarm when available.
