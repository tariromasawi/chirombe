    /* ============================================================
       PROPOSAL STATIC VALIDATION
       ============================================================ */

    function staticValidateProposal(
        proposal
    ) {

        const result = {

            valid:
                true,

            errors:
                [],

            warnings:
                [],

            checks:
                []
        };

        if (!proposal) {

            result.valid =
                false;

            result.errors.push(
                "Missing proposal."
            );

            return result;
        }

        if (
            !proposal.file
        ) {

            result.valid =
                false;

            result.errors.push(
                "Missing target file."
            );
        }

        if (
            !proposal.code
        ) {

            result.valid =
                false;

            result.errors.push(
                "Code payload is empty."
            );
        }

        if (
            proposal.protectedTarget
        ) {

            result.warnings.push(
                "Protected production target requires review."
            );
        }

        if (
            proposal.code &&
            proposal.code.indexOf(
                "<script"
            ) !== -1
        ) {

            result.warnings.push(
                "Script tag detected inside JavaScript proposal."
            );
        }

        /*
         * Basic structural checks.
         */

        if (
            proposal.code
        ) {

            const openBraces =
                (
                    proposal.code.match(
                        /\{/g
                    ) || []
                ).length;

            const closeBraces =
                (
                    proposal.code.match(
                        /\}/g
                    ) || []
                ).length;

            if (
                openBraces !==
                closeBraces
            ) {

                result.valid =
                    false;

                result.errors.push(
                    "Brace count mismatch."
                );
            }

            const openParens =
                (
                    proposal.code.match(
                        /\(/g
                    ) || []
                ).length;

            const closeParens =
                (
                    proposal.code.match(
                        /\)/g
                    ) || []
                ).length;

            if (
                openParens !==
                closeParens
            ) {

                result.valid =
                    false;

                result.errors.push(
                    "Parenthesis count mismatch."
                );
            }
        }

        result.checks.push(
            "TARGET_PRESENT"
        );

        result.checks.push(
            "CODE_PRESENT"
        );

        result.checks.push(
            "BASIC_STRUCTURE"
        );

        return result;
    }

    /* ============================================================
       PROPOSAL VALIDATION
       ============================================================ */

    async function validateProposal(
        proposalId
    ) {

        const proposal =
            STATE.proposals[
                proposalId
            ];

        if (!proposal) {

            throw new Error(
                "Code proposal not found."
            );
        }

        const result =
            staticValidateProposal(
                proposal
            );

        result.timestamp =
            now();

        result.proposalId =
            proposal.id;

        result.confidence =
            result.valid
                ? 0.85
                : 0.15;

        STATE.validation[
            proposal.id
        ] = result;

        STATE.metrics
            .validations++;

        if (
            result.valid
        ) {

            STATE.metrics
                .successfulValidations++;

        } else {

            STATE.metrics
                .failedValidations++;
        }

        await persist(
            "VALIDATION_" +
                proposal.id,
            result
        );

        emit(
            "BUILD_VALIDATION_COMPLETE",
            result
        );

        return clone(result);
    }

    /* ============================================================
       PACKAGE ENGINE
       ============================================================ */

    async function packageProposal(
        proposalId
    ) {

        const proposal =
            STATE.proposals[
                proposalId
            ];

        if (!proposal) {

            throw new Error(
                "Proposal not found."
            );
        }

        const validation =
            STATE.validation[
                proposalId
            ] ||
            await validateProposal(
                proposalId
            );

        if (
            CONFIG.requireValidation &&
            !validation.valid
        ) {

            throw new Error(
                "Proposal failed validation."
            );
        }

        const packageData = {

            id:
                uid("PKG"),

            proposalId:
                proposal.id,

            file:
                proposal.file,

            operation:
                proposal.operation,

            code:
                proposal.code,

            language:
                proposal.language,

            validation:
                clone(validation),

            rollback: {

                required:
                    true,

                strategy:
                    "RESTORE_PREVIOUS_VERSION"
            },

            generatedAt:
                now(),

            deployment:
                {
                    automatic:
                        false,

                    status:
                        "NOT_DEPLOYED"
                }
        };

        packageData.integrity =
            await digest(
                packageData
            );

        STATE.packages[
            packageData.id
        ] = packageData;

        STATE.metrics
            .packages++;

        proposal.status =
            "PACKAGED";

        await persist(
            "PACKAGE_" +
                packageData.id,
            packageData
        );

        await persist(
            "CODE_PROPOSAL_" +
                proposal.id,
            proposal
        );

        emit(
            "BUILD_PACKAGE_CREATED",
            packageData
        );

        return clone(
            packageData
        );
    }

    /* ============================================================
       BUILD PACKAGE FROM PLAN
       ============================================================ */

    async function buildFromPlan(
        planId
    ) {

        const plan =
            STATE.plans[
                planId
            ];

        if (!plan) {

            throw new Error(
                "Build plan not found."
            );
        }

        const generated = [];

        for (
            let i = 0;
            i < plan.operations.length;
            i++
        ) {

            const operation =
                plan.operations[i];

            let file =
                plan.targetFiles[0] ||
                "new-module.js";

            if (
                plan.targetFiles.length >
                i
            ) {

                file =
                    plan.targetFiles[i];
            }

            let code =
                "";

            /*
             * For a new module we can safely generate
             * a structural template.
             *
             * For existing protected files, the engine
             * creates a proposal requiring review rather
             * than pretending it has safely rewritten the
             * production file.
             */

            if (
                file ===
                "NEW_MODULE"
                ||
                file ===
                "new-module.js"
            ) {

                code =
                    generateModuleTemplate(
                        plan.title,
                        operation.description
                    );

            } else {

                code =
                    "/* PROTECTED CHANGE PROPOSAL */\n" +
                    "/* Target: " +
                    file +
                    " */\n" +
                    "/* Description: " +
                    String(
                        operation.description ||
                        ""
                    )
                        .replace(
                            /\*\//g,
                            "* /"
                        ) +
                    " */\n";
            }

            const proposal =
                await createCodeProposal({

                    planId:
                        plan.id,

                    file:
                        file,

                    operation:
                        file ===
                            "NEW_MODULE"
                            ? "CREATE"
                            : "REVIEW_AND_PATCH",

                    description:
                        operation.description,

                    code:
                        code,

                    tests:
                        plan.tests,

                    confidence:
                        plan.confidence
                });

            generated.push(
                proposal
            );
        }

        plan.status =
            "CODE_PROPOSED";

        plan.updatedAt =
            now();

        await persist(
            "PLAN_" +
                plan.id,
            plan
        );

        return generated;
    }

    /* ============================================================
       BUILD SAFETY ENGINE
       ============================================================ */

    function safetyCheck(
        proposal
    ) {

        const result = {

            safe:
                true,

            reasons:
                [],

            requiresReview:
                false
        };

        if (!proposal) {

            result.safe =
                false;

            result.reasons.push(
                "Missing proposal."
            );

            return result;
        }

        if (
            proposal.protectedTarget
        ) {

            result.safe =
                false;

            result.requiresReview =
                true;

            result.reasons.push(
                "Protected production module."
            );
        }

        if (
            proposal.operation ===
                "DELETE"
        ) {

            result.safe =
                false;

            result.requiresReview =
                true;

            result.reasons.push(
                "Deletion requires explicit review."
            );
        }

        if (
            proposal.operation ===
                "REPLACE"
        ) {

            result.requiresReview =
                true;

            result.reasons.push(
                "Replacement requires rollback validation."
            );
        }

        return result;
    }

    /* ============================================================
       BUILD INTELLIGENCE FROM KNOWLEDGE
       ============================================================ */

    async function generateFromKnowledge(
        query
    ) {

        if (
            !KNOWLEDGE
        ) {

            return {
                success:
                    false,

                reason:
                    "KNOWLEDGE_ENGINE_UNAVAILABLE"
            };
        }

        let results = [];

        try {

            results =
                KNOWLEDGE.search(
                    query,
                    {
                        limit:
                            20,

                        threshold:
                            0.15
                    }
                );

        } catch (e) {

            return {
                success:
                    false,

                reason:
                    e.message
            };
        }

        const requirements = [];

        for (
            let i = 0;
            i < results.length;
            i++
        ) {

            const match =
                results[i];

            requirements.push(
                await createRequirement({

                    title:
                        "Knowledge-derived requirement",

                    description:
                        match.concept
                            .description ||
                        match.concept.name,

                    category:
                        match.concept
                            .category ||
                        "GENERAL",

                    source:
                        "KNOWLEDGE_ENGINE",

                    confidence:
                        match.score,

                    acceptanceCriteria:
                        [
                            "Requirement is represented in the build plan.",
                            "Implementation has validation coverage.",
                            "Rollback metadata exists."
                        ],

                    metadata: {

                        conceptId:
                            match.concept.id,

                        searchScore:
                            match.score
                    }
                })
            );
        }

        return {
            success:
                true,

            requirements:
                requirements
        };
    }

    /* ============================================================
       EVOLUTION → BUILD
       ============================================================ */

    async function ingestEvolutionProposals() {

        if (
            !EVOLUTION
        ) {

            return [];
        }

        let proposals = [];

        try {

            if (
                typeof EVOLUTION.proposals ===
                    "function"
            ) {

                proposals =
                    EVOLUTION.proposals();
            }

        } catch (e) {

            return [];
        }

        if (
            !Array.isArray(
                proposals
            )
        ) {

            return [];
        }

        const requirements = [];

        for (
            let i = 0;
            i < proposals.length;
            i++
        ) {

            const proposal =
                proposals[i];

            requirements.push(
                await createRequirement({

                    title:
                        proposal.title ||
                        "Evolution proposal",

                    description:
                        proposal.description ||
                        JSON.stringify(
                            proposal
                        ),

                    category:
                        "EVOLUTION",

                    priority:
                        proposal.priority ||
                        "NORMAL",

                    source:
                        "EVOLUTION_ENGINE",

                    confidence:
                        Number(
                            proposal.score
                        ) || 0.5,

                    acceptanceCriteria:
                        [
                            "Change remains reversible.",
                            "Change is validated before deployment.",
                            "Integrity state remains recoverable."
                        ],

                    metadata: {
                        evolutionProposal:
                            clone(
                                proposal
                            )
                    }
                })
            );
        }

        return requirements;
    }

    /* ============================================================
       AUTOMATIC BUILD CYCLE
       ============================================================ */

    async function cycle() {

        STATE.cycle++;
        STATE.metrics.cycles++;

        try {

            await discoverArchitecture();

            const evolutionRequirements =
                await ingestEvolutionProposals();

            for (
                let i = 0;
                i <
                evolutionRequirements.length;
                i++
            ) {

                const plan =
                    await planRequirement(
                        evolutionRequirements[
                            i
                        ].id
                    );

                await buildFromPlan(
                    plan.id
                );
            }

            /*
             * Validate all outstanding proposals.
             */

            const proposalIds =
                Object.keys(
                    STATE.proposals
                );

            for (
                let i = 0;
                i < proposalIds.length;
                i++
            ) {

                const id =
                    proposalIds[i];

                if (
                    !STATE.validation[
                        id
                    ]
                ) {

                    await validateProposal(
                        id
                    );
                }
            }

        } catch (e) {

            console.error(
                "[CHIROMBE BUILD] Cycle error:",
                e
            );

            emit(
                "BUILD_ERROR",
                {
                    message:
                        e.message,

                    timestamp:
                        now()
                }
            );
        }

        return status();
    }

    /* ============================================================
       SCHEDULER
       ============================================================ */

    function start() {

        if (
            STATE.running
        ) {
            return;
        }

        STATE.running =
            true;

        const timer =
            setInterval(
                function () {

                    if (
                        CONFIG
                            .automaticPlanning
                    ) {

                        cycle();
                    }

                },
                120000
            );

        STATE.timers.push(
            timer
        );

        console.log(
            "[CHIROMBE BUILD] Build intelligence scheduler online."
        );
    }

    function stop() {

        STATE.timers.forEach(
            function (timer) {

                clearInterval(
                    timer
                );
            }
        );

        STATE.timers = [];

        STATE.running =
            false;

        console.log(
            "[CHIROMBE BUILD] Scheduler stopped."
        );
    }

