    /* ============================================================
       INDEX ENGINE
       ============================================================ */

    async function indexConcept(
        concept
    ) {

        if (!concept) {
            return;
        }

        const terms =
            unique(
                [
                    concept.name,
                    concept.normalized,
                    ...(concept.tags || []),
                    ...(concept.aliases || []),
                    ...tokenize(
                        concept.description
                    )
                ]
            );

        terms.forEach(
            function (term) {

                const key =
                    normalize(term);

                if (!key) {
                    return;
                }

                if (
                    !STATE.index[key]
                ) {
                    STATE.index[key] =
                        [];
                }

                if (
                    STATE.index[key]
                        .indexOf(
                            concept.id
                        ) === -1
                ) {

                    STATE.index[key]
                        .push(
                            concept.id
                        );
                }
            }
        );
    }

    async function rebuildIndex() {

        STATE.index = {};

        Object.keys(
            STATE.concepts
        ).forEach(
            function (id) {

                indexConcept(
                    STATE.concepts[id]
                );
            }
        );

        STATE.lastIndexing =
            now();

        STATE.metrics
            .indexCycles++;

        await persist(
            "INDEX_SNAPSHOT",
            {
                timestamp:
                    now(),

                index:
                    clone(
                        STATE.index
                    )
            }
        );

        return {
            timestamp:
                STATE.lastIndexing,

            terms:
                Object.keys(
                    STATE.index
                ).length
        };
    }

    /* ============================================================
       SEARCH ENGINE
       ============================================================ */

    function search(
        query,
        options
    ) {

        options =
            options || {};

        const q =
            normalize(query);

        if (!q) {
            return [];
        }

        STATE.metrics.searches++;

        const queryTokens =
            tokenize(q);

        const scored = [];

        Object.keys(
            STATE.concepts
        ).forEach(
            function (id) {

                const concept =
                    STATE.concepts[id];

                let score =
                    similarity(
                        q,
                        concept.name
                    );

                const descriptionScore =
                    similarity(
                        q,
                        concept.description
                    );

                score =
                    Math.max(
                        score,
                        descriptionScore
                    );

                queryTokens.forEach(
                    function (token) {

                        if (
                            concept.tags
                                .map(
                                    normalize
                                )
                                .indexOf(
                                    token
                                ) !== -1
                        ) {

                            score +=
                                0.15;
                        }

                        if (
                            concept.aliases
                                .map(
                                    normalize
                                )
                                .indexOf(
                                    token
                                ) !== -1
                        ) {

                            score +=
                                0.2;
                        }
                    }
                );

                score =
                    Math.min(
                        1,
                        score
                    );

                if (
                    score >=
                    (
                        Number(
                            options
                                .threshold
                        ) || 0
                    )
                ) {

                    scored.push({
                        concept:
                            clone(
                                concept
                            ),

                        score:
                            score
                    });
                }
            }
        );

        scored.sort(
            function (a, b) {

                return (
                    b.score -
                    a.score
                );
            }
        );

        return scored
            .slice(
                0,
                Number(
                    options.limit
                ) ||
                    CONFIG.maximumSearchResults
            );
    }

    /* ============================================================
       GRAPH QUERY
       ============================================================ */

    function relatedConcepts(
        conceptId,
        options
    ) {

        options =
            options || {};

        const results = [];

        Object.keys(
            STATE.relations
        ).forEach(
            function (id) {

                const relation =
                    STATE.relations[id];

                if (
                    relation.from ===
                        conceptId
                    ||
                    (
                        relation.bidirectional &&
                        relation.to ===
                            conceptId
                    )
                ) {

                    results.push({
                        relation:
                            clone(
                                relation
                            ),

                        concept:
                            clone(
                                STATE.concepts[
                                    relation.to ===
                                        conceptId
                                        ? relation.from
                                        : relation.to
                                ]
                            )
                    });
                }
            }
        );

        return results.slice(
            0,
            Number(
                options.limit
            ) || 100
        );
    }

