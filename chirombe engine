   ================================================================ */

function registerWorkers(){

    if(!WORKERS) return;

    const definitions = [

        {

            name:"BLOODLINE_SCAN",

            handler:()=>scan(),

            interval:CONFIG.scanInterval

        },

        {

            name:"BLOODLINE_CONTINUITY",

            handler:()=>continuityCycle(),

            interval:CONFIG.continuityInterval

        },

        {

            name:"BLOODLINE_TRUST_GRAPH",

            handler:()=>buildTrustGraph(),

            interval:CONFIG.integrityInterval

        },

        {

            name:"BLOODLINE_RESILIENCE",

