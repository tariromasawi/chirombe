/* ============================================================
   40 · INPUT RECEIVER
   ============================================================ */

async function receive(input){

  if(
    STATE.destroyed
  ){

    return {
      ok:false,
      reason:"ENGINE_DESTROYED"
    };

  }


  if(
    !allowRate()
  ){

    quarantine(
      {
        reason:"RATE_LIMIT"
      },
      "RATE_LIMIT"
    );

    return {
      ok:false,
      reason:"RATE_LIMIT"
    };

  }


  const validation =
    validateEnvelope(input);

  if(
    !validation.ok
  ){

    quarantine(
      input,
      validation.reason
    );

    return {
      ok:false,
      reason:validation.reason
    };

  }


  const replay =
    checkReplay(
      input.nonce
    );

  if(
    !replay.ok
  ){

    quarantine(
      input,
      replay.reason
    );

    return {
      ok:false,
      reason:replay.reason
    };

  }


  const safe =
    sanitiseObject(input);

  logEvent(
    "INPUT_ACCEPTED",
    "Sanitised input accepted as inert data"
  );

  return {

    ok:true,

    data:safe,

    capabilities:CAPABILITIES

  };

}


