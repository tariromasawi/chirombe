DOM.networkCanvas.addEventListener(
  "pointermove",
  event => {

    const rect =
      DOM.networkCanvas
        .getBoundingClientRect();

    STATE.mouse.x =
      event.clientX -
      rect.left;

    STATE.mouse.y =
      event.clientY -
      rect.top;

    STATE.mouse.active =
      true;

  }
);


DOM.networkCanvas.addEventListener(
  "pointerleave",
  () => {

    STATE.mouse.active =
      false;

  }
);


DOM.networkCanvas.addEventListener(
  "pointerdown",
  event => {

    const rect =
      DOM.networkCanvas
        .getBoundingClientRect();

    const x =
      event.clientX -
      rect.left;

    const y =
      event.clientY -
      rect.top;

    let closest = null;

    let distance = Infinity;

    for(
      const node
      of STATE.nodes
    ){

      const dx =
        node.x-x;

      const dy =
        node.y-y;

      const d =
        Math.sqrt(
          dx*dx + dy*dy
        );

      if(
        d < distance
      ){

        distance = d;
        closest = node;

      }

    }

    if(
      closest &&
      distance < 28
