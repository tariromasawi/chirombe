            route

        );


        return route;

    }


    /* ----------------------------------------------------------------------
       BOTTLENECK DETECTION
       ---------------------------------------------------------------------- */

    function detectBottlenecks() {

        const bottlenecks = [];


        for (
            const node
            of STATE.nodes.values()
        ) {

            const incoming =
                getIncoming(
                    node.id
                ).length;


            const outgoing =
                getOutgoing(
                    node.id
                ).length;


            const connectivity =
                incoming +
                outgoing;


            if (
                connectivity >= 4
            ) {

                bottlenecks.push({

                    node:
                        node.id,

                    type:
                        "HIGH_CONNECTIVITY",

                    connectivity:
                        connectivity,

                    importance:
                        node.importance,

                    recommendation:
                        "Analyse node dependency concentration."

                });

            }


            if (
                node.resilience <
                0.30
            ) {

                bottlenecks.push({

                    node:
                        node.id,

                    type:
                        "LOW_RESILIENCE",

                    resilience:
                        node.resilience,

                    recommendation:
                        "Create redundancy or recovery pathway."

                });

            }

        }


        STATE.signals.push(
            ...bottlenecks
        );


        return bottlenecks;

    }


