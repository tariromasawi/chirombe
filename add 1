<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#05070d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description"
      content="CHIROMBE Celestial Protection — local-first family matrix, defensive boundary and integrity engine.">

<title>CHIROMBE · Celestial Protection</title>

<style>
:root{
  --bg:#03050a;
  --bg2:#070b14;
  --panel:rgba(9,14,25,.86);
  --panel2:rgba(13,20,34,.78);
  --line:rgba(133,178,255,.20);
  --line2:rgba(255,255,255,.08);
  --text:#eaf3ff;
  --muted:#8da1bb;
  --cyan:#5de8ff;
  --blue:#6f8cff;
  --violet:#b77cff;
  --gold:#ffd86b;
  --green:#58efac;
  --red:#ff647c;
  --orange:#ffad5c;
  --shadow:0 18px 70px rgba(0,0,0,.45);
  --radius:18px;
  --safe-bottom:env(safe-area-inset-bottom,0px);
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  min-height:100%;
  background:
    radial-gradient(circle at 50% -10%,rgba(100,120,255,.15),transparent 35%),
    radial-gradient(circle at 10% 90%,rgba(0,220,255,.07),transparent 30%),
    var(--bg);
  color:var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body{
  overflow-x:hidden;
}

button,
input,
select{
  font:inherit;
}

button{
  cursor:pointer;
}

button:disabled{
  cursor:not-allowed;
  opacity:.45;
}

#app{
  min-height:100vh;
  position:relative;
  isolation:isolate;
}

#celestialCanvas{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:-3;
  pointer-events:none;
}

#gridCanvas{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:-2;
  pointer-events:none;
  opacity:.35;
}

.scanlines{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:50;
  opacity:.06;
  background:
    repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255,255,255,.8) 4px
    );
  mix-blend-mode:screen;
}

.vignette{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:49;
  background:
    radial-gradient(circle at center,
      transparent 30%,
      rgba(0,0,0,.20) 70%,
      rgba(0,0,0,.62) 100%);
}

.shell{
  width:min(1600px,100%);
  margin:auto;
  padding:
    max(14px,env(safe-area-inset-top))
    14px
    calc(30px + var(--safe-bottom));
}

header{
  position:sticky;
  top:0;
  z-index:30;
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  background:rgba(3,5,10,.76);
  border-bottom:1px solid var(--line2);
}

.header-inner{
  width:min(1600px,100%);
  margin:auto;
  padding:12px 14px;
  display:flex;
  gap:12px;
  align-items:center;
  justify-content:space-between;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  min-width:0;
}

.emblem{
  width:42px;
  height:42px;
  border-radius:50%;
  display:grid;
  place-items:center;
  border:1px solid rgba(93,232,255,.55);
  box-shadow:
    0 0 22px rgba(93,232,255,.20),
    inset 0 0 20px rgba(111,140,255,.12);
  position:relative;
  flex:none;
}

.emblem::before,
.emblem::after{
  content:"";
  position:absolute;
  inset:6px;
  border:1px solid rgba(255,216,107,.32);
  border-radius:50%;
  transform:rotate(45deg);
}

.emblem::after{
  transform:rotate(-45deg);
}

.brand-text{
  min-width:0;
}

.brand-title{
  font-size:14px;
  font-weight:900;
  letter-spacing:.18em;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.brand-sub{
  font-size:10px;
  color:var(--muted);
  letter-spacing:.12em;
  margin-top:3px;
}

.header-actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  justify-content:flex-end;
}

.btn{
  border:1px solid var(--line);
  background:rgba(12,19,34,.78);
  color:var(--text);
  padding:9px 12px;
  min-height:38px;
  border-radius:11px;
  font-weight:800;
  font-size:11px;
  letter-spacing:.04em;
  transition:
    transform .15s ease,
    border-color .15s ease,
    background .15s ease;
}

.btn:hover{
  transform:translateY(-1px);
  border-color:rgba(93,232,255,.55);
  background:rgba(18,29,50,.9);
}

.btn:active{
  transform:translateY(1px) scale(.98);
}

.btn.primary{
  border-color:rgba(93,232,255,.50);
  box-shadow:0 0 18px rgba(93,232,255,.08);
}

.btn.danger{
  border-color:rgba(255,100,124,.42);
}

.btn.good{
  border-color:rgba(88,239,172,.42);
}

.btn.gold{
  border-color:rgba(255,216,107,.44);
}

.hero{
  display:grid;
  grid-template-columns:minmax(0,1.5fr) minmax(300px,.7fr);
  gap:14px;
  margin:18px 0 14px;
}

.card{
  background:
    linear-gradient(
      145deg,
      rgba(15,23,40,.90),
      rgba(6,10,18,.88)
    );
  border:1px solid var(--line2);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  overflow:hidden;
}

.hero-main{
  min-height:260px;
  padding:24px;
  position:relative;
}

.hero-main::after{
  content:"";
  position:absolute;
  inset:auto -20% -70% -20%;
  height:220px;
  background:
    radial-gradient(
      ellipse,
      rgba(93,232,255,.12),
      transparent 65%
    );
  pointer-events:none;
}

.eyebrow{
  color:var(--cyan);
  font-size:10px;
  font-weight:900;
  letter-spacing:.20em;
  text-transform:uppercase;
}

h1{
  margin:10px 0 8px;
  font-size:clamp(28px,5vw,58px);
  line-height:.95;
  letter-spacing:-.045em;
}

.hero-copy{
  max-width:850px;
  color:#b7c8df;
  line-height:1.65;
  font-size:13px;
}

.identity-strip{
  margin-top:20px;
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  min-height:29px;
  padding:6px 9px;
  border-radius:999px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.025);
  color:#cfe1f9;
  font-size:10px;
  font-weight:800;
  letter-spacing:.05em;
}

.badge.online::before,
.badge.safe::before,
.badge.observe::before,
.badge.alert::before{
  content:"";
  width:7px;
  height:7px;
  border-radius:50%;
  background:currentColor;
  box-shadow:0 0 12px currentColor;
}

.badge.online{color:var(--green)}
.badge.safe{color:var(--cyan)}
.badge.observe{color:var(--gold)}
.badge.alert{color:var(--red)}

.status-card{
  padding:18px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.status-head{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.status-title{
  font-size:11px;
  font-weight:900;
  letter-spacing:.14em;
  text-transform:uppercase;
}

.state-orb{
  width:76px;
  height:76px;
  border-radius:50%;
  margin:20px auto;
  display:grid;
  place-items:center;
  border:1px solid rgba(93,232,255,.55);
  box-shadow:
    0 0 30px rgba(93,232,255,.18),
    inset 0 0 35px rgba(111,140,255,.14);
  animation:orbPulse 3.5s ease-in-out infinite;
}

@keyframes orbPulse{
  0%,100%{transform:scale(.96);filter:brightness(.9)}
  50%{transform:scale(1.04);filter:brightness(1.2)}
}

.state-core{
  width:18px;
  height:18px;
  border-radius:50%;
  background:var(--cyan);
  box-shadow:0 0 25px var(--cyan);
}

.status-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.stat{
  border:1px solid var(--line2);
  border-radius:12px;
  padding:10px;
  background:rgba(255,255,255,.025);
}

.stat-label{
  color:var(--muted);
  font-size:9px;
  letter-spacing:.1em;
  text-transform:uppercase;
}

.stat-value{
  margin-top:5px;
  font-size:17px;
  font-weight:900;
}

.dashboard{
  display:grid;
  grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr);
  gap:14px;
}

.network-card{
  min-height:620px;
  position:relative;
}

.card-header{
  padding:14px 16px;
  border-bottom:1px solid var(--line2);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.card-title{
  font-size:11px;
  font-weight:900;
  letter-spacing:.13em;
  text-transform:uppercase;
}

.card-meta{
  color:var(--muted);
  font-size:9px;
  font-family:ui-monospace,monospace;
}

#networkCanvas{
  display:block;
  width:100%;
  height:560px;
  touch-action:none;
}

.network-overlay{
  position:absolute;
  left:14px;
  bottom:14px;
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  max-width:90%;
}

.legend{
  display:flex;
  align-items:center;
  gap:6px;
  border:1px solid var(--line2);
  border-radius:999px;
  padding:6px 8px;
  background:rgba(3,5,10,.75);
  backdrop-filter:blur(10px);
  font-size:9px;
  color:#b7c8df;
}

.dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:currentColor;
  box-shadow:0 0 9px currentColor;
}

.side{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.controls{
  padding:14px;
}

.control-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.control-grid .btn{
  width:100%;
}

.meter{
  margin-top:14px;
}

.meter-row{
  display:flex;
  justify-content:space-between;
  gap:8px;
  font-size:9px;
  color:var(--muted);
  margin-bottom:6px;
}

.meter-track{
  height:7px;
  border-radius:999px;
  overflow:hidden;
  background:rgba(255,255,255,.06);
}

.meter-fill{
  width:0%;
  height:100%;
  background:linear-gradient(
    90deg,
    var(--cyan),
    var(--violet),
    var(--gold)
  );
  box-shadow:0 0 12px rgba(93,232,255,.30);
  transition:width .35s ease;
}

.feed{
  height:260px;
  overflow:auto;
  padding:10px;
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
  font-size:9px;
}

.feed-row{
  display:grid;
  grid-template-columns:76px 74px 1fr;
  gap:7px;
  padding:7px 4px;
  border-bottom:1px solid rgba(255,255,255,.035);
}

.feed-time{color:#687a93}
.feed-type{color:var(--cyan)}
.feed-msg{color:#b8c7dc;overflow-wrap:anywhere}

.section{
  margin-top:14px;
}

.section-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
}

.module{
  min-height:180px;
  padding:16px;
}

.module h3{
  margin:0 0 7px;
  font-size:12px;
}

.module p{
  margin:0;
  color:#91a5bf;
  font-size:10px;
  line-height:1.6;
}

.module-value{
  font-size:28px;
  font-weight:900;
  margin:16px 0 4px;
}

.node-browser{
  display:grid;
  grid-template-columns:1fr;
  gap:8px;
  max-height:420px;
  overflow:auto;
  padding:10px;
}

.node{
  display:grid;
  grid-template-columns:10px 1fr auto;
  gap:9px;
  align-items:center;
  border:1px solid rgba(255,255,255,.055);
  border-radius:12px;
  padding:9px;
  background:rgba(255,255,255,.02);
}

.node-pip{
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--cyan);
  box-shadow:0 0 10px var(--cyan);
}

.node-main{
  min-width:0;
}

.node-name{
  font-size:10px;
  font-weight:900;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.node-type{
  font-size:8px;
  color:var(--muted);
  margin-top:3px;
}

.node-score{
  text-align:right;
  font-family:ui-monospace,monospace;
  font-size:9px;
}

.security-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.log-panel{
  min-height:360px;
}

.table{
  width:100%;
  border-collapse:collapse;
  font-size:9px;
}

.table th,
.table td{
  text-align:left;
  padding:8px;
  border-bottom:1px solid rgba(255,255,255,.05);
}

.table th{
  color:#73869f;
  font-size:8px;
  letter-spacing:.1em;
  text-transform:uppercase;
}

footer{
  margin-top:20px;
  padding:20px 5px 30px;
  color:#63748b;
  text-align:center;
  font-size:9px;
  line-height:1.8;
}

footer strong{
  color:#aabbd1;
}

.modal{
  position:fixed;
  inset:0;
  z-index:100;
  display:none;
  align-items:center;
  justify-content:center;
  padding:16px;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(12px);
}

.modal.open{
  display:flex;
}

.modal-card{
  width:min(720px,100%);
  max-height:90vh;
  overflow:auto;
  border:1px solid var(--line);
  border-radius:20px;
  background:#080d17;
  box-shadow:0 30px 100px rgba(0,0,0,.7);
}

.modal-head{
  padding:16px;
  border-bottom:1px solid var(--line2);
  display:flex;
  justify-content:space-between;
  gap:12px;
}

.modal-body{
  padding:16px;
}

textarea,
input,
select{
  width:100%;
  background:#050913;
  border:1px solid var(--line);
  color:var(--text);
  border-radius:10px;
  padding:10px;
  outline:none;
}

textarea{
  min-height:160px;
  resize:vertical;
  font-family:ui-monospace,monospace;
  font-size:10px;
}

.security-state{
  padding:12px;
  border-radius:12px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.02);
  font-size:10px;
  line-height:1.6;
}

.security-state strong{
  color:var(--cyan);
}

.toast{
  position:fixed;
  left:50%;
  bottom:calc(18px + var(--safe-bottom));
  transform:translate(-50%,20px);
  z-index:200;
  min-width:min(340px,90vw);
  max-width:90vw;
  padding:11px 14px;
  border:1px solid var(--line);
  border-radius:12px;
  background:rgba(7,12,22,.95);
  box-shadow:0 15px 50px rgba(0,0,0,.45);
  color:#dcecff;
  font-size:10px;
  opacity:0;
  pointer-events:none;
  transition:.25s ease;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}

@media(max-width:1050px){
  .hero,
  .dashboard,
  .security-layout{
    grid-template-columns:1fr;
  }

  .section-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media(max-width:650px){
  .shell{
    padding-left:9px;
    padding-right:9px;
  }

  .header-inner{
    align-items:flex-start;
  }

  .header-actions{
    max-width:48%;
  }

  .header-actions .btn{
    padding:7px 8px;
    min-height:34px;
    font-size:9px;
  }

  .hero-main{
    padding:18px;
  }

  .hero-main h1{
    font-size:34px;
  }

  .section-grid{
    grid-template-columns:1fr;
  }

  #networkCanvas{
    height:430px;
  }

  .network-card{
    min-height:490px;
  }

  .control-grid{
    grid-template-columns:1fr 1fr;
  }

  .feed-row{
    grid-template-columns:64px 60px 1fr;
  }
}

@media(prefers-reduced-motion:reduce){
  *,
  *::before,
  *::after{
    animation-duration:.001ms!important;
    animation-iteration-count:1!important;
    scroll-behavior:auto!important;
    transition:none!important;
  }
}
</style>
</head>

<body>

<div id="app">

<canvas id="celestialCanvas"></canvas>
<canvas id="gridCanvas"></canvas>

<div class="scanlines"></div>
<div class="vignette"></div>

<header>
  <div class="header-inner">

    <div class="brand">
      <div class="emblem">✦</div>

      <div class="brand-text">
        <div class="brand-title">CHIROMBE CELESTIAL PROTECTION</div>
        <div class="brand-sub">
          LOCAL-FIRST · ZERO-TRUST · FAMILY MATRIX · CM90+
        </div>
      </div>
    </div>

    <div class="header-actions">
      <button class="btn primary" id="armBtn">ARM</button>
      <button class="btn" id="pauseBtn">PAUSE</button>
      <button class="btn gold" id="toneBtn">TONES</button>
      <button class="btn" id="exportBtn">EXPORT</button>
      <button class="btn danger" id="resetBtn">RESET</button>
    </div>

  </div>
</header>


<main class="shell">

  <section class="hero">

    <div class="card hero-main">

      <div class="eyebrow">
        HOUSE OF MASAWI · CHIROMBE SYSTEM
      </div>

      <h1>
        CELESTIAL<br>
        PROTECTION
      </h1>

      <div class="hero-copy">
        A local-first defensive simulation and family-resonance environment.
        The system models lineage nodes, synthetic future branches,
        integrity states, behavioural decoys, quarantine boundaries and
        visual celestial fields without claiming supernatural detection or
        transmitting retaliatory signals.
      </div>

      <div class="identity-strip">

        <span class="badge safe">ZERO-TRUST INPUT</span>
        <span class="badge safe">OFFLINE-FIRST</span>
        <span class="badge online">MATRIX ACTIVE</span>
        <span class="badge">77-99-33</span>
        <span class="badge">MUKANYA</span>
        <span class="badge">MWARI NDI MWARI</span>

      </div>

    </div>


    <div class="card status-card">

      <div class="status-head">
        <div>
          <div class="status-title">Boundary State</div>
          <div class="card-meta" id="incidentText">NORMAL</div>
        </div>

        <span class="badge safe" id="statusBadge">
          SECURE
        </span>
      </div>

      <div class="state-orb">
        <div class="state-core"></div>
      </div>

      <div class="status-grid">

        <div class="stat">
          <div class="stat-label">Nodes</div>
          <div class="stat-value" id="statNodes">100</div>
        </div>

        <div class="stat">
          <div class="stat-label">Events</div>
          <div class="stat-value" id="statEvents">0</div>
        </div>

        <div class="stat">
          <div class="stat-label">Quarantine</div>
          <div class="stat-value" id="statQuarantine">0</div>
        </div>

        <div class="stat">
          <div class="stat-label">Integrity</div>
          <div class="stat-value" id="statIntegrity">100%</div>
        </div>

      </div>

    </div>

  </section>


  <section class="dashboard">

    <div class="card network-card">

      <div class="card-header">
        <div>
          <div class="card-title">Celestial Family Matrix</div>
          <div class="card-meta">
            LIVE LOCAL SIMULATION
          </div>
        </div>

        <div class="card-meta" id="matrixMode">
          CONTINUOUS
        </div>
      </div>

      <canvas id="networkCanvas"></canvas>

      <div class="network-overlay">

        <div class="legend">
          <span class="dot" style="color:#5de8ff"></span>
          Known lineage
        </div>

        <div class="legend">
          <span class="dot" style="color:#b77cff"></span>
          Synthetic branch
        </div>

        <div class="legend">
          <span class="dot" style="color:#ffd86b"></span>
          Canary
        </div>

        <div class="legend">
          <span class="dot" style="color:#ff647c"></span>
          Quarantine
        </div>

      </div>

    </div>


    <div class="side">

      <div class="card controls">

        <div class="card-title">
          Command Nexus
        </div>

        <div style="height:10px"></div>

        <div class="control-grid">

          <button class="btn primary" id="pulseBtn">
            PULSE MATRIX
          </button>

          <button class="btn" id="mirrorBtn">
            DEFENSIVE MIRROR
          </button>

          <button class="btn good" id="boundaryBtn">
            TEST BOUNDARY
          </button>

          <button class="btn gold" id="canaryBtn">
            CREATE CANARY
          </button>

          <button class="btn" id="decoyBtn">
