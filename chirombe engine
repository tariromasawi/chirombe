            );

        }

        /*
         * Convert high-confidence signals into incidents.
         */

        for (
            let i = 0;
            i < signals.length;
            i++
        ) {

            const signal =
                signals[i];

            if (
                signal.severity >=
                CONFIG.anomalyThreshold &&
                signal.confidence >=
                0.75
            ) {

                const incident =
                    createIncident(
                        signal
                    );

                if (
                    CONFIG.automaticContainment &&
                    signal.severity >=
                    CONFIG.anomalyThreshold
